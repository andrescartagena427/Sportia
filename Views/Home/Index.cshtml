<!-- JAVASCRIPT PARA BUSCAR Y FILTRAR -->
<!-- ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput = document.getElementById("searchInput");
        const cards = document.querySelectorAll(".court-card");
        const buttons = document.querySelectorAll(".filter-btn");
        const noResults = document.getElementById("noResults");

        let activeFilter = "todos";

        function filterCards() {

            const search = searchInput.value.toLowerCase().trim();
            let visibleCards = 0;

            cards.forEach(card => {

                const category = card.dataset.category;
                const name = card.dataset.name;

                const matchesFilter =
                    activeFilter === "todos" ||
                    category === activeFilter;

                const matchesSearch =
                    name.includes(search);

                if (matchesFilter && matchesSearch) {
                    card.classList.remove("hidden");
                    visibleCards++;
                } else {
                    card.classList.add("hidden");
                }

            });

            if (visibleCards === 0) {
                noResults.classList.remove("hidden");
            } else {
                noResults.classList.add("hidden");
            }

        }

        searchInput.addEventListener("input", filterCards);

        buttons.forEach(button => {

            button.addEventListener("click", function() {

                activeFilter = this.dataset.filter;

                buttons.forEach(btn => {
                    btn.classList.remove("bg-emerald-500", "text-white");
                    btn.classList.add("border", "border-slate-700", "bg-slate-950", "text-slate-300");
                });

                this.classList.remove("border", "border-slate-700", "bg-slate-950", "text-slate-300");
                this.classList.add("bg-emerald-500", "text-white");

                filterCards();

            });

        });

    });

</script>