@using System.Globalization
@model Sportia.Models.ViewModels.InicioViewModel

@{
    ViewData["Title"] = "Inicio";

    var vm = Model ?? new Sportia.Models.ViewModels.InicioViewModel();
    var destacado = vm.Escenarios.FirstOrDefault(e => Normalizar(e.Tipo).Contains("futbol")) ?? vm.Escenarios.FirstOrDefault();

    // Cuántas tarjetas se ven antes de "Ver todos"
    const int TarjetasIniciales = 8;
    int indice = 0;
}

@functions {
    string Dinero(decimal? valor) => "$" + (valor ?? 0).ToString("N0", new CultureInfo("es-CO"));

    string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "";
        var formD = texto.ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in formD)
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark) sb.Append(c);
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }

    // Foto de referencia cuando el escenario aún no tiene imagen propia
    string ImagenPorTipo(string? tipo)
    {
        var t = Normalizar(tipo);
        if (t.Contains("balon") || t.Contains("basket")) return "https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&w=800&q=70";
        if (t.Contains("tenis")) return "https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=800&q=70";
        if (t.Contains("padel")) return "https://images.unsplash.com/photo-1554068865-24cecd4e34b8?auto=format&fit=crop&w=800&q=70";
        if (t.Contains("voley") || t.Contains("volei")) return "https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?auto=format&fit=crop&w=800&q=70";
        if (t.Contains("nata") || t.Contains("piscina")) return "https://images.unsplash.com/photo-1519315901367-f34ff9154487?auto=format&fit=crop&w=800&q=70";
        return "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=70";
    }

    string IconoTipo(string? tipo)
    {
        var t = Normalizar(tipo);
        if (t.Contains("balon") || t.Contains("basket")) return "bi-dribbble text-orange-400";
        if (t.Contains("tenis") || t.Contains("padel")) return "bi-record-circle text-lime-400";
        if (t.Contains("nata") || t.Contains("piscina")) return "bi-water text-sky-400";
        if (t.Contains("voley") || t.Contains("volei")) return "bi-circle-half text-sky-400";
        return "bi-dribbble text-emerald-400";
    }
}


<div class="bg-[#0B0F19] text-slate-200">

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section id="inicio" class="relative overflow-hidden">

        <div class="pointer-events-none absolute -left-32 top-10 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-20 -top-20 h-[28rem] w-[28rem] rounded-full bg-emerald-500/10 blur-3xl"></div>

        <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 py-14 lg:grid-cols-2 lg:px-8 lg:py-16">

            <!-- Texto -->
            <div>
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-400">
                    <i class="bi bi-calendar2-check-fill"></i>
                    Reserva tu cancha, juega sin límites
                </span>

                <h1 class="font-heading mt-6 text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl xl:text-6xl">
                    No dejes que otro<br class="hidden sm:block" />
                    equipo se quede<br />
                    <span class="text-emerald-400">con tu cancha.</span>
                </h1>

                <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
                    En <span class="font-semibold text-emerald-400">Sportia</span> puedes reservar fácilmente canchas deportivas,
                    organizar tus partidos y disfrutar del deporte con amigos, clubes o empresas.
                </p>

                <!-- Buscador -->
                <form id="formHero" class="mt-8 flex max-w-xl items-center gap-2 rounded-2xl border border-slate-700 bg-slate-900/70 p-2 shadow-xl shadow-black/20 transition focus-within:border-emerald-500/60">
                    <label class="flex min-w-0 flex-1 items-center gap-3 px-3">
                        <i class="bi bi-search text-slate-400"></i>
                        <span class="sr-only">Buscar escenarios</span>
                        <input id="buscadorHero" type="search" autocomplete="off"
                               placeholder="Buscar escenarios por nombre, tipo o ciudad..."
                               class="h-11 min-w-0 flex-1 bg-transparent text-sm text-white placeholder:text-slate-500 focus:outline-none" />
                    </label>
                    <button type="submit"
                            class="h-11 shrink-0 rounded-xl bg-emerald-500 px-6 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400">
                        Buscar
                    </button>
                </form>

                <!-- Ventajas -->
                <div class="mt-7 flex flex-wrap gap-x-5 gap-y-3 text-[13px] text-slate-300">
                    <span class="flex items-center gap-2"><i class="bi bi-calendar-check text-emerald-400"></i> Reserva rápida</span>
                    <span class="flex items-center gap-2"><i class="bi bi-tag text-emerald-400"></i> Precios transparentes</span>
                    <span class="flex items-center gap-2"><i class="bi bi-patch-check text-emerald-400"></i> Canchas verificadas</span>
                    <span class="flex items-center gap-2"><i class="bi bi-shield-check text-emerald-400"></i> Pago seguro</span>
                </div>
            </div>

            <!-- Imagen -->
            <div class="relative">
                <div class="group relative overflow-hidden rounded-3xl border border-slate-700/80 shadow-2xl shadow-black/40">
                    <img src="https://images.unsplash.com/photo-1553778263-73a83bab9b0c?auto=format&fit=crop&w=1400&q=85"
                         alt="Jugador con el balón en una cancha de fútbol"
                         class="h-[340px] w-full object-cover transition duration-700 group-hover:scale-105 sm:h-[420px] lg:h-[460px]" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19]/70 via-transparent to-transparent"></div>
                </div>

                @if (destacado != null)
                {
                    <a href="#tarjeta-@destacado.IdEscenario" data-ir-tarjeta="@destacado.IdEscenario"
                       class="absolute bottom-5 right-5 flex max-w-[calc(100%-2.5rem)] items-center gap-4 rounded-2xl border border-white/10 bg-[#0B0F19]/85 p-4 shadow-2xl backdrop-blur transition hover:border-emerald-500/50 sm:min-w-[300px]">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-xl text-emerald-400">
                            <i class="bi bi-trophy"></i>
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-bold text-white">@destacado.Nombre</span>
                            <span class="mt-0.5 flex items-center gap-1 truncate text-xs text-slate-400">
                                <i class="bi bi-geo-alt-fill text-emerald-400"></i> @destacado.Ubicacion
                            </span>
                            <span class="mt-0.5 block text-xs text-slate-300">
                                Desde <span class="font-semibold text-emerald-400">@Dinero(destacado.Precio)</span> / hora
                            </span>
                        </span>
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-[#03150d]">
                            <i class="bi bi-arrow-right"></i>
                        </span>
                    </a>
                }
            </div>

        </div>
    </section>


    <!-- =========================================================
         ESTADÍSTICAS
    ========================================================== -->

    <section class="border-y border-slate-800 bg-[#0d1424]">
        <div class="mx-auto grid max-w-7xl grid-cols-2 gap-y-8 px-6 py-8 lg:grid-cols-4 lg:divide-x lg:divide-slate-800 lg:px-8">

            <div class="flex items-center justify-center gap-4">
                <i class="bi bi-calendar3 text-4xl text-emerald-400"></i>
                <div>
                    <p class="text-2xl font-extrabold text-emerald-400">@vm.TotalCanchas</p>
                    <p class="text-sm text-slate-400">Canchas disponibles</p>
                </div>
            </div>

            <div class="flex items-center justify-center gap-4">
                <i class="bi bi-people text-4xl text-emerald-400"></i>
                <div>
                    <p class="text-2xl font-extrabold text-emerald-400">@vm.TotalUsuarios</p>
                    <p class="text-sm text-slate-400">Usuarios registrados</p>
                </div>
            </div>

            <div class="flex items-center justify-center gap-4">
                <i class="bi bi-shield-check text-4xl text-emerald-400"></i>
                <div>
                    <p class="text-2xl font-extrabold text-emerald-400">@vm.TotalReservas</p>
                    <p class="text-sm text-slate-400">Reservas realizadas</p>
                </div>
            </div>

            <div class="flex items-center justify-center gap-4">
                <i class="bi bi-star text-4xl text-emerald-400"></i>
                <div>
                    <p class="text-2xl font-extrabold text-emerald-400">4.9</p>
                    <p class="text-sm text-slate-400">Calificación promedio</p>
                </div>
            </div>

        </div>
    </section>


    <!-- =========================================================
         ESCENARIOS
    ========================================================== -->

    <section id="canchas" class="relative scroll-mt-20 overflow-hidden py-16">

        <div class="pointer-events-none absolute right-0 top-0 h-80 w-80 rounded-full bg-emerald-500/5 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 lg:px-8">

            <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-400">Escenarios destacados</p>
                    <h2 class="font-heading mt-2 text-3xl font-extrabold text-white sm:text-4xl">Encuentra el escenario perfecto</h2>
                    <p class="mt-2 text-slate-400">Explora nuestras mejores canchas y elige la que se adapte a tus necesidades.</p>
                </div>

                @if (vm.Escenarios.Count > TarjetasIniciales)
                {
                    <button type="button" id="btnVerTodos" data-abierto="0"
                            class="inline-flex h-11 w-fit shrink-0 items-center gap-2 rounded-full border border-slate-600 px-5 text-sm font-semibold text-white transition hover:border-emerald-500 hover:text-emerald-400">
                        <span id="textoVerTodos">Ver todos los escenarios</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                }
            </div>

            @if (vm.Escenarios.Any())
            {
                <!-- Filtros -->
                <form id="formFiltros" class="mt-8 grid gap-3 md:grid-cols-[minmax(0,1fr)_200px_220px_auto]">
                    <label class="flex h-12 items-center gap-3 rounded-xl border border-slate-700 bg-slate-900/70 px-4 transition focus-within:border-emerald-500/60">
                        <i class="bi bi-search text-slate-400"></i>
                        <span class="sr-only">Buscar por nombre, tipo o ciudad</span>
                        <input id="filtroTexto" type="search" autocomplete="off" placeholder="Buscar por nombre, tipo o ciudad..."
                               class="h-full min-w-0 flex-1 bg-transparent text-sm text-white placeholder:text-slate-500 focus:outline-none" />
                    </label>

                    <label class="relative block">
                        <span class="sr-only">Tipo de escenario</span>
                        <select id="filtroTipo" class="h-12 w-full appearance-none rounded-xl border border-slate-700 bg-slate-900/70 pl-4 pr-10 text-sm text-slate-200 focus:border-emerald-500/60 focus:outline-none">
                            <option value="" class="bg-slate-900">Todos los tipos</option>
                            @foreach (var tipo in vm.Tipos)
                            {
                                <option value="@Normalizar(tipo)" class="bg-slate-900">@tipo</option>
                            }
                        </select>
                        <i class="bi bi-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
                    </label>

                    <label class="relative block">
                        <span class="sr-only">Empresa</span>
                        <select id="filtroEmpresa" class="h-12 w-full appearance-none rounded-xl border border-slate-700 bg-slate-900/70 pl-4 pr-10 text-sm text-slate-200 focus:border-emerald-500/60 focus:outline-none">
                            <option value="" class="bg-slate-900">Todas las empresas</option>
                            @foreach (var empresa in vm.Empresas)
                            {
                                <option value="@Normalizar(empresa)" class="bg-slate-900">@empresa</option>
                            }
                        </select>
                        <i class="bi bi-chevron-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
                    </label>

                    <button type="submit" class="h-12 rounded-xl bg-emerald-500 px-8 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400">
                        Buscar
                    </button>
                </form>

                <p id="textoResultados" class="mt-4 hidden text-sm text-slate-400"></p>

                <!-- Tarjetas -->
                <div id="gridEscenarios" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

                    @foreach (var esc in vm.Escenarios)
                    {
                        bool extra = indice++ >= TarjetasIniciales;
                        string imagen = !string.IsNullOrWhiteSpace(esc.Imagen) ? esc.Imagen! : ImagenPorTipo(esc.Tipo);

                        <article id="tarjeta-@esc.IdEscenario"
                                 class="tarjeta-cancha group flex scroll-mt-28 flex-col overflow-hidden rounded-2xl border border-slate-700/80 bg-[#101828] shadow-xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-emerald-500/50 @(extra ? "tarjeta-extra hidden" : "")"
                                 data-id="@esc.IdEscenario"
                                 data-extra="@(extra ? "1" : "0")"
                                 data-tipo="@Normalizar(esc.Tipo)"
                                 data-empresa="@Normalizar(esc.Empresa)"
                                 data-texto="@Normalizar(esc.Nombre + " " + esc.Tipo + " " + esc.Empresa + " " + esc.Ubicacion)">

                            <div class="relative h-44 overflow-hidden">
                                <img src="@imagen" alt="@esc.Nombre" loading="lazy"
                                     onerror="this.onerror=null;this.src='@ImagenPorTipo(esc.Tipo)';"
                                     class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#101828]/60 via-transparent to-transparent"></div>

                                <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-500 px-3 py-1 text-xs font-bold text-[#03150d]">
                                    <i class="bi bi-check-circle-fill"></i> Disponible
                                </span>

                                <button type="button" data-favorito="@esc.IdEscenario" aria-pressed="false"
                                        aria-label="Guardar @esc.Nombre en favoritos"
                                        class="btn-favorito absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur transition hover:scale-110">
                                    <i class="bi bi-heart"></i>
                                </button>
                            </div>

                            <div class="flex flex-1 flex-col p-4">
                                <h3 class="truncate text-lg font-bold text-white" title="@esc.Nombre">@esc.Nombre</h3>
                                <p class="mt-1 flex items-center gap-1.5 truncate text-sm text-slate-400">
                                    <i class="bi bi-geo-alt-fill text-emerald-400"></i>
                                    <span class="truncate">@esc.Ubicacion</span>
                                </p>

                                <div class="mt-4 grid grid-cols-2 gap-2 border-b border-slate-800 pb-4">
                                    <div class="flex min-w-0 items-center gap-2">
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-sm text-slate-300">
                                            <i class="bi bi-people-fill"></i>
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block truncate text-[13px] font-bold text-white">@(esc.Capacidad?.ToString() ?? "N/D") jugadores</span>
                                            <span class="block text-[11px] text-slate-500">Capacidad</span>
                                        </span>
                                    </div>
                                    <div class="flex min-w-0 items-center gap-2">
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-sm text-emerald-400">
                                            <i class="bi bi-shield-check"></i>
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block truncate text-[13px] font-bold text-white">@Dinero(esc.Precio)</span>
                                            <span class="block whitespace-nowrap text-[11px] text-slate-500">Precio por hora</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="mt-auto flex items-center justify-between gap-3 pt-4">
                                    <span class="flex min-w-0 items-center gap-2 text-sm text-slate-400">
                                        <i class="bi @IconoTipo(esc.Tipo) text-base"></i>
                                        <span class="truncate">Tipo: <span class="text-slate-200">@esc.Tipo</span></span>
                                    </span>

                                    @if (vm.EsCliente)
                                    {
                                        <a asp-controller="Cliente" asp-action="Reservar" asp-route-idEscenario="@esc.IdEscenario"
                                           class="shrink-0 rounded-xl bg-emerald-500 px-4 py-2 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400">
                                            Reservar
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Login" asp-action="Index"
                                           class="shrink-0 rounded-xl bg-emerald-500 px-4 py-2 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400"
                                           title="Inicia sesión para reservar">
                                            Reservar
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    }

                </div>

                <!-- Sin resultados -->
                <div id="sinResultados" class="mt-6 hidden rounded-2xl border border-dashed border-slate-700 p-12 text-center">
                    <i class="bi bi-search text-3xl text-slate-500"></i>
                    <h3 class="mt-3 text-lg font-bold text-white">No encontramos escenarios</h3>
                    <p class="mt-1 text-sm text-slate-400">Prueba con otro nombre, tipo o empresa.</p>
                    <button type="button" id="btnLimpiar" class="mt-5 rounded-xl border border-slate-600 px-5 py-2 text-sm font-semibold text-white transition hover:border-emerald-500 hover:text-emerald-400">
                        Ver todos
                    </button>
                </div>
            }
            else
            {
                <div class="mt-8 rounded-2xl border border-dashed border-slate-700 p-12 text-center">
                    <i class="bi bi-calendar-x text-3xl text-slate-500"></i>
                    <h3 class="mt-3 text-lg font-bold text-white">Pronto tendremos canchas disponibles</h3>
                    <p class="mt-1 text-sm text-slate-400">Vuelve en unos días o crea tu cuenta para enterarte primero.</p>
                </div>
            }

        </div>
    </section>


    <!-- =========================================================
         POR QUÉ SPORTIA (fondo claro)
    ========================================================== -->

    <section id="torneos" class="scroll-mt-20 bg-slate-50 py-16 text-slate-900">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">¿Por qué elegir Sportia?</p>
            <h2 class="font-heading mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">Todo lo que necesitas para jugar</h2>
            <p class="mt-2 text-slate-500">Contamos con todo lo necesario para que tu experiencia sea fácil, rápida y segura.</p>

            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-600">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                    <h3 class="mt-5 font-bold text-slate-900">Reserva en minutos</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Encuentra y reserva tu cancha de forma rápida y sencilla.</p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-600">
                        <i class="bi bi-clock-history"></i>
                    </span>
                    <h3 class="mt-5 font-bold text-slate-900">Disponibilidad en tiempo real</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Consulta horarios y disponibilidad de todas las canchas.</p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-600">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <h3 class="mt-5 font-bold text-slate-900">Pagos seguros</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Paga de forma segura con tarjeta, transferencia o efectivo.</p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-600">
                        <i class="bi bi-headset"></i>
                    </span>
                    <h3 class="mt-5 font-bold text-slate-900">Soporte cercano</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">¿Tienes un inconveniente? Escríbenos y te ayudamos.</p>
                </div>

            </div>
        </div>
    </section>


    <!-- =========================================================
         TESTIMONIOS (fondo claro)
    ========================================================== -->

    <section id="testimonios" class="border-t border-slate-200 bg-slate-100 py-16 text-slate-900">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">

            <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">Lo que dicen nuestros usuarios</p>
            <h2 class="font-heading mt-2 text-3xl font-extrabold text-slate-900 sm:text-4xl">Miles de partidos ya se jugaron gracias a Sportia</h2>
            <p class="mt-2 text-slate-500">La mejor prueba de nuestro servicio son nuestros usuarios. Conoce sus experiencias.</p>

            <div class="mt-10 grid gap-6 md:grid-cols-3">

                <figure class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <i class="bi bi-quote absolute right-5 top-3 text-5xl text-emerald-100"></i>
                    <div class="flex gap-1 text-amber-400">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    </div>
                    <blockquote class="mt-4 text-sm leading-6 text-slate-600">
                        "Reservar la cancha de microfútbol para mi equipo antes tomaba llamadas y esperas.
                        Con Sportia lo hago en menos de un minuto desde el celular."
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
