<!-- =========================================================
     BÚSQUEDA, FILTROS Y FAVORITOS
========================================================== -->

@section Scripts {
    <script>
        (() => {
            const tarjetas = Array.from(document.querySelectorAll('.tarjeta-cancha'));
            const grid = document.getElementById('gridEscenarios');
            const filtroTexto = document.getElementById('filtroTexto');
            const filtroTipo = document.getElementById('filtroTipo');
            const filtroEmpresa = document.getElementById('filtroEmpresa');
            const sinResultados = document.getElementById('sinResultados');
            const textoResultados = document.getElementById('textoResultados');
            const btnVerTodos = document.getElementById('btnVerTodos');
            const textoVerTodos = document.getElementById('textoVerTodos');
            let verTodos = false;

            const normalizar = t => (t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();

            function aplicar() {
                const texto = normalizar(filtroTexto?.value);
                const tipo = filtroTipo?.value || '';
                const empresa = filtroEmpresa?.value || '';
                const filtrando = texto || tipo || empresa;
                let visibles = 0;

                tarjetas.forEach(t => {
                    const coincide = (!texto || texto.split(/\s+/).every(p => t.dataset.texto.includes(p))) &&
                        (!tipo || t.dataset.tipo === tipo) &&
                        (!empresa || t.dataset.empresa === empresa);
                    const mostrar = coincide && (filtrando || verTodos || t.dataset.extra === '0');
                    t.classList.toggle('hidden', !mostrar);
                    if (mostrar) visibles++;
                });

                grid?.classList.toggle('hidden', visibles === 0);
                sinResultados?.classList.toggle('hidden', visibles > 0);
                if (textoResultados) {
                    textoResultados.classList.toggle('hidden', !filtrando);
                    textoResultados.textContent = visibles === 1 ? '1 escenario encontrado' : visibles + ' escenarios encontrados';
                }
                if (btnVerTodos) btnVerTodos.classList.toggle('hidden', !!filtrando);
            }

            filtroTexto?.addEventListener('input', aplicar);
            filtroTipo?.addEventListener('change', aplicar);
            filtroEmpresa?.addEventListener('change', aplicar);
            document.getElementById('formFiltros')?.addEventListener('submit', e => { e.preventDefault(); aplicar(); });

            btnVerTodos?.addEventListener('click', () => {
                verTodos = !verTodos;
                textoVerTodos.textContent = verTodos ? 'Ver menos' : 'Ver todos los escenarios';
                aplicar();
            });

            document.getElementById('btnLimpiar')?.addEventListener('click', () => {
                if (filtroTexto) filtroTexto.value = '';
                if (filtroTipo) filtroTipo.value = '';
                if (filtroEmpresa) filtroEmpresa.value = '';
                aplicar();
            });

            // Buscador del inicio: lleva a las canchas con la búsqueda aplicada
            document.getElementById('formHero')?.addEventListener('submit', e => {
                e.preventDefault();
                if (filtroTexto) filtroTexto.value = document.getElementById('buscadorHero').value;
                aplicar();
                document.getElementById('canchas')?.scrollIntoView({ behavior: 'smooth' });
            });

            // Tarjeta flotante del inicio: muestra esa cancha aunque esté entre las ocultas
            document.querySelectorAll('[data-ir-tarjeta]').forEach(a => a.addEventListener('click', e => {
                const t = document.getElementById('tarjeta-' + a.dataset.irTarjeta);
                if (!t) return;
                e.preventDefault();
                if (t.classList.contains('hidden')) {
                    if (filtroTexto) filtroTexto.value = '';
                    if (filtroTipo) filtroTipo.value = '';
                    if (filtroEmpresa) filtroEmpresa.value = '';
                    verTodos = true;
                    if (textoVerTodos) textoVerTodos.textContent = 'Ver menos';
                    aplicar();
                }
                t.scrollIntoView({ behavior: 'smooth', block: 'center' });
                t.classList.add('ring-2', 'ring-emerald-400');
                setTimeout(() => t.classList.remove('ring-2', 'ring-emerald-400'), 1600);
            }));

            // Favoritos (los mismos del panel del cliente, guardados en este navegador)
            const CLAVE_FAV = 'sportia_favoritos';
            let favoritos = [];
            try { favoritos = JSON.parse(localStorage.getItem(CLAVE_FAV) || '[]'); } catch (e) { favoritos = []; }
            if (!Array.isArray(favoritos)) favoritos = [];

            function pintarFavoritos() {
                document.querySelectorAll('[data-favorito]').forEach(b => {
                    const activo = favoritos.includes(b.dataset.favorito);
                    b.setAttribute('aria-pressed', activo);
                    const i = b.querySelector('i');
                    i.classList.toggle('bi-heart', !activo);
                    i.classList.toggle('bi-heart-fill', activo);
                    i.classList.toggle('text-red-400', activo);
                });
            }

            document.querySelectorAll('[data-favorito]').forEach(b => b.addEventListener('click', () => {
                const id = b.dataset.favorito;
                favoritos = favoritos.includes(id) ? favoritos.filter(f => f !== id) : favoritos.concat(id);
                try { localStorage.setItem(CLAVE_FAV, JSON.stringify(favoritos)); } catch (e) { }
                pintarFavoritos();
            }));

            pintarFavoritos();
            aplicar();
        })();
    </script>
}
