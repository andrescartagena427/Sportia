@{
    ViewData["Title"] = "Inicio";
}

<section class="mx-auto max-w-7xl px-6 py-20">

    <div class="grid items-center gap-12 md:grid-cols-2">

        <div>

            <span class="inline-block rounded-full bg-lime-100 px-4 py-2 text-sm font-semibold text-lime-700">
                Gestión deportiva inteligente
            </span>

            <h1 class="mt-6 text-5xl font-extrabold leading-tight tracking-tight text-slate-900">
                Administra tus instalaciones deportivas
                <span class="text-blue-700">
                    fácilmente.
                </span>
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
                Sportia permite gestionar reservas, canchas y usuarios
                desde una plataforma sencilla, moderna y rápida.
            </p>

            <div class="mt-8 flex flex-wrap gap-4">

                <button class="rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white shadow-md transition hover:bg-blue-800">
                    Comenzar ahora
                </button>

                <button class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50">
                    Ver reservas
                </button>

            </div>

        </div>


        <div class="rounded-2xl bg-white p-8 shadow-xl">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-sm font-medium text-slate-500">
                        Próxima reserva
                    </p>

                    <h2 class="mt-1 text-2xl font-bold">
                        Cancha de Fútbol 1
                    </h2>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-lime-100 text-xl">
                    ⚽
                </div>

            </div>

            <div class="mt-8 rounded-xl bg-slate-50 p-5">

                <div class="flex justify-between">
                    <span class="text-slate-500">Fecha</span>
                    <span class="font-semibold">Hoy</span>
                </div>

                <div class="mt-4 flex justify-between">
                    <span class="text-slate-500">Hora</span>
                    <span class="font-semibold">18:00 - 19:00</span>
                </div>

                <div class="mt-4 flex justify-between">
                    <span class="text-slate-500">Estado</span>

                    <span class="rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-700">
                        Confirmada
                    </span>
                </div>

            </div>

            <button class="mt-6 w-full rounded-lg bg-slate-900 py-3 font-semibold text-white transition hover:bg-slate-800">
                Ver detalles
            </button>

        </div>

    </div>


    <div class="mt-24 grid gap-6 md:grid-cols-3">

        <div class="rounded-xl bg-white p-6 shadow-md">
            <div class="text-3xl">📅</div>

            <h3 class="mt-4 text-xl font-bold">
                Reservas
            </h3>

            <p class="mt-2 text-slate-600">
                Administra las reservas de tus canchas.
            </p>
        </div>


        <div class="rounded-xl bg-white p-6 shadow-md">
            <div class="text-3xl">💳</div>

            <h3 class="mt-4 text-xl font-bold">
                Pagos
            </h3>

            <p class="mt-2 text-slate-600">
                Lleva el control de los pagos de tus clientes.
            </p>
        </div>


        <div class="rounded-xl bg-white p-6 shadow-md">
            <div class="text-3xl">👥</div>

            <h3 class="mt-4 text-xl font-bold">
                Usuarios
            </h3>

            <p class="mt-2 text-slate-600">
                Gestiona jugadores y administradores.
            </p>
        </div>

    </div>

</section>