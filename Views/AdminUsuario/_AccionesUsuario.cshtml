@model Sportia.Models.ViewModels.UsuarioFilaViewModel

@* Botones Editar / Eliminar / menú de un usuario (se usa en la lista y en las tarjetas) *@
@{
    string volver = ViewData["Volver"] as string ?? Url.Action("Index", "AdminUsuario") ?? "/";

    string? motivoNoEliminar =
        Model.EsUsuarioActual ? "No puedes eliminar tu propia cuenta"
        : Model.Reservas > 0 ? $"Tiene {Model.Reservas} reserva(s): mejor desactívalo"
        : null;
}

<div class="cl-acciones">
    <a asp-controller="AdminUsuario" asp-action="Edit" asp-route-id="@Model.IdUsuario" class="cl-btn editar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg>
        Editar
    </a>

    <form method="post" asp-controller="AdminUsuario" asp-action="Delete" asp-route-id="@Model.IdUsuario"
          data-confirmar="¿Seguro que deseas eliminar a @Model.Nombre? Esta acción no se puede deshacer.">
        <button type="submit" class="cl-btn eliminar" disabled="@(motivoNoEliminar != null)"
                title="@(motivoNoEliminar ?? "Eliminar usuario")">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
            Eliminar
        </button>
    </form>

    <div class="cl-menu">
        <button type="button" class="cl-menu-btn" title="Más opciones" aria-haspopup="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5.5" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="12" cy="18.5" r="1.7" /></svg>
        </button>
        <div class="cl-menu-lista">
            <a asp-controller="AdminUsuario" asp-action="Details" asp-route-id="@Model.IdUsuario">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="2.8" /></svg>
                Ver detalle
            </a>

            <form method="post" asp-controller="AdminUsuario" asp-action="CambiarEstado" asp-route-id="@Model.IdUsuario"
                  data-confirmar="@(Model.Activo ? $"¿Desactivar a {Model.Nombre}? No podrá iniciar sesión hasta que lo actives de nuevo." : $"¿Activar a {Model.Nombre}?")">
                <input type="hidden" name="volver" value="@volver" />
                @if (Model.Activo)
                {
                    <button type="submit" disabled="@Model.EsUsuarioActual" title="@(Model.EsUsuarioActual ? "No puedes desactivar tu propia cuenta" : "")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#f5b031" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M6 18L18 6" /></svg>
                        Desactivar cuenta
                    </button>
                }
                else
                {
                    <button type="submit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22d39a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                        Activar cuenta
                    </button>
                }
            </form>

            <a href="mailto:@Model.Correo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6l8.5 7 8.5-7" /></svg>
                Enviar correo
            </a>
        </div>
    </div>
</div>
