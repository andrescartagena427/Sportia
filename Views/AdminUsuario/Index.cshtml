@model Sportia.Models.ViewModels.AdminUsuariosViewModel
@using System.Globalization
@using UsuarioFila = Sportia.Models.ViewModels.UsuarioFilaViewModel

@{
    ViewData["Title"] = "Usuarios";
    Layout = "_DashboardLayout";

    var co = new CultureInfo("es-CO");

    string UrlPagina(int pagina) => Url.Action("Index", "AdminUsuario", new
    {
        buscar = string.IsNullOrEmpty(Model.Buscar) ? null : Model.Buscar,
        rol = Model.IdRol,
        estado = string.IsNullOrEmpty(Model.Estado) ? null : Model.Estado,
        pagina
    }) ?? "#";

    string urlActual = UrlPagina(Model.Pagina);

    string ColorAvatar(string nombre)
    {
        string[] colores = { "#14b88a", "#2f6fed", "#7c4dff", "#0ea5a5", "#e8508a", "#f59e0b" };
        int h = 0;
        foreach (char c in nombre) h = (h * 31 + c) & 0x7fffffff;
        return colores[h % colores.Length];
    }

    string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        string ini = partes[0][..1] + (partes.Length > 1 ? partes[1][..1] : "");
        return ini.ToUpper();
    }

    string ClaseRol(UsuarioFila u) => u.IdRol == 1 ? "admin" : (u.Rol.ToLower().Contains("client") ? "cliente" : "otro");

    string textoEstado = Model.Estado switch
    {
        "activo" => "Activos",
        "inactivo" => "Inactivos",
        _ => "Todos los estados"
    };
    string textoRol = Model.IdRol.HasValue
        ? Model.Roles.FirstOrDefault(r => r.IdRol == Model.IdRol)?.Nombre ?? "Todos los roles"
        : "Todos los roles";

    const string icoEscudo = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M12 3l7 2.6v5.6c0 4.4-3 8-7 9.3-4-1.3-7-4.9-7-9.3V5.6z\"/></svg>";
    const string icoPersona = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4.5 20.5c.8-3.8 3.8-6 7.5-6s6.7 2.2 7.5 6\"/></svg>";
    const string icoCalendario = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4.5\" width=\"18\" height=\"16.5\" rx=\"2.5\"/><path d=\"M16 2.5v4M8 2.5v4M3 10h18\"/><path d=\"M8 14h.01M12 14h.01M16 14h.01\"/></svg>";
}


@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Variacion(double? v)
    {
        if (v == null)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"cl-var sube\" title=\"Frente al inicio del mes\">Nuevo</span>");
        }
        bool sube = v >= 0;
        string flecha = sube ? "M12 19V5M5 12l7-7 7 7" : "M12 5v14M5 12l7 7 7-7";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"cl-var {(sube ? "sube" : "baja")}\" title=\"Frente al inicio del mes\"><svg viewBox=\"0 0 24 24\"><path d=\"{flecha}\"/></svg>{Math.Abs(v.Value):0}%</span>");
    }
}

<style>
    .cl {
        --cl-card: #0f1a2c;
        --cl-borde: #1e2c44;
        --cl-borde-2: #263650;
        --cl-texto: #eef3fa;
        --cl-suave: #a3b0c4;
        --cl-tenue: #6b7a92;
        --cl-verde: #22d39a;
        --cl-azul: #4f8cff;
        --cl-rojo: #f05d6c;
        width: 100%;
        color: var(--cl-texto);
    }
    .cl *, .cl *::before, .cl *::after { box-sizing: border-box; }
    .cl svg { flex-shrink: 0; }

    /* ---------- Mensajes ---------- */
    .cl-alerta { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding: 13px 16px; border-radius: 12px; font-size: 13px; }
    .cl-alerta.ok { background: rgba(34, 211, 154, .10); border: 1px solid rgba(34, 211, 154, .30); color: var(--cl-verde); }
    .cl-alerta.error { background: rgba(240, 93, 108, .10); border: 1px solid rgba(240, 93, 108, .30); color: var(--cl-rojo); }
    .cl-alerta svg { width: 18px; height: 18px; }

    /* ---------- Encabezado ---------- */
    .cl-cab { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
    .cl-cab-izq { display: flex; align-items: center; gap: 18px; }
    .cl-cab-icono { width: 56px; height: 56px; display: grid; place-items: center; color: var(--cl-verde); }
    .cl-cab-icono svg { width: 50px; height: 50px; filter: drop-shadow(0 6px 18px rgba(34, 211, 154, .35)); }
    .cl-cab h1 { margin: 0; font-size: 34px; line-height: 1.1; font-weight: 800; letter-spacing: -.5px; color: #fff; }
    .cl-cab p { margin: 6px 0 0; font-size: 15px; color: var(--cl-suave); }
    .cl-btn-nuevo {
        display: inline-flex; align-items: center; gap: 12px;
        padding: 14px 26px; border-radius: 12px;
        background: linear-gradient(135deg, #2ee6ac, #19c48d);
        color: #04241a; font-size: 15px; font-weight: 800; text-decoration: none; white-space: nowrap;
        box-shadow: 0 8px 24px rgba(34, 211, 154, .28);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .cl-btn-nuevo:hover { color: #04241a; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(34, 211, 154, .38); }
    .cl-btn-nuevo svg { width: 20px; height: 20px; }

    /* ---------- Tarjetas ---------- */
    .cl-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-bottom: 24px; }
    .cl-kpi {
        position: relative; overflow: hidden;
        display: flex; align-items: flex-start; gap: 18px;
        padding: 20px 20px 22px; border-radius: 16px; border: 1px solid; min-width: 0;
    }
    .cl-kpi::after {
        content: ""; position: absolute; right: -40px; top: -40px; width: 160px; height: 160px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, .08), transparent 70%); pointer-events: none;
    }
    .cl-kpi-icono { width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; color: #fff; }
    .cl-kpi-icono svg { width: 28px; height: 28px; }
    .cl-kpi-cuerpo { flex: 1; min-width: 0; }
    .cl-kpi-label { font-size: 13px; font-weight: 600; letter-spacing: .4px; text-transform: uppercase; color: #e6ecf5; }
    .cl-kpi-fila { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; margin-top: 8px; }
    .cl-kpi-num { font-size: 34px; font-weight: 800; line-height: 1; color: #fff; }
    .cl-kpi-desc { margin-top: 12px; font-size: 12px; color: #c9d3e2; }
    .cl-var { display: inline-flex; align-items: center; gap: 2px; font-size: 12px; font-weight: 700; }
    .cl-var svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .cl-var.sube { color: var(--cl-verde); }
    .cl-var.baja { color: var(--cl-rojo); }

    .cl-kpi.azul { background: linear-gradient(150deg, #173a8a, #10235a); border-color: rgba(79, 140, 255, .45); }
    .cl-kpi.azul .cl-kpi-icono { background: linear-gradient(145deg, #5b9bff, #2f6fed); }
    .cl-kpi.verde { background: linear-gradient(150deg, #11493f, #0c2e2b); border-color: rgba(34, 211, 154, .38); }
    .cl-kpi.verde .cl-kpi-icono { background: linear-gradient(145deg, #1fb98e, #0e8a68); }
    .cl-kpi.morado { background: linear-gradient(150deg, #4b23a8, #2a1670); border-color: rgba(155, 107, 255, .45); }
    .cl-kpi.morado .cl-kpi-icono { background: linear-gradient(145deg, #a46bff, #7a3fe6); }
    .cl-kpi.ambar { background: linear-gradient(150deg, #5a3b16, #2f2214); border-color: rgba(245, 158, 11, .42); }
    .cl-kpi.ambar .cl-kpi-icono { background: linear-gradient(145deg, #ffb340, #e48a0c); }

    /* ---------- Barra de filtros ---------- */
    .cl-filtros {
        display: flex; align-items: center; gap: 14px;
        padding: 12px; margin-bottom: 24px;
        background: var(--cl-card); border: 1px solid var(--cl-borde); border-radius: 16px;
    }
    .cl-buscar { position: relative; flex: 1; min-width: 0; }
    .cl-buscar svg { position: absolute; left: 16px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: var(--cl-suave); pointer-events: none; }
    .cl-buscar input {
        width: 100%; height: 46px; padding: 0 16px 0 50px;
        background: #0a1322; border: 1px solid var(--cl-borde-2); border-radius: 11px;
        color: var(--cl-texto); font-size: 14px; outline: none;
    }
    .cl-buscar input::placeholder { color: var(--cl-tenue); }
    .cl-buscar input:focus { border-color: var(--cl-verde); }

    .cl-estado { position: relative; width: 220px; }
    .cl-estado-caja {
        display: flex; align-items: center; gap: 12px; height: 46px; padding: 0 16px;
        background: #0a1322; border: 1px solid var(--cl-borde-2); border-radius: 11px;
        font-size: 14px; color: var(--cl-texto);
    }
    .cl-estado-caja svg { width: 18px; height: 18px; color: var(--cl-suave); }
    .cl-estado-caja span { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cl-estado select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .cl-estado select option { background: #0f1a2c; color: #eef3fa; }

    .cl-vistas { display: flex; gap: 4px; padding: 4px; background: #0a1322; border: 1px solid var(--cl-borde-2); border-radius: 11px; }
    .cl-vistas button {
        width: 40px; height: 36px; display: grid; place-items: center;
        border: 0; border-radius: 8px; background: transparent; color: var(--cl-suave); cursor: pointer;
    }
    .cl-vistas button svg { width: 18px; height: 18px; }
    .cl-vistas button.activo { background: #1b2a44; color: #fff; }

    /* ---------- Tarjeta de la lista ---------- */
    .cl-lista { background: var(--cl-card); border: 1px solid var(--cl-borde); border-radius: 18px; overflow: hidden; }
    .cl-lista-cab { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 22px 22px 18px; border-bottom: 1px solid var(--cl-borde); }
    .cl-lista-cab h2 { margin: 0; font-size: 22px; font-weight: 800; color: #fff; }
    .cl-lista-cab p { margin: 4px 0 0; font-size: 14px; color: var(--cl-suave); }
    .cl-badge { padding: 8px 14px; border-radius: 10px; background: rgba(34, 211, 154, .12); color: var(--cl-verde); font-size: 14px; font-weight: 700; white-space: nowrap; }

    .cl-tabla-wrap { width: 100%; overflow-x: auto; }
    .cl-tabla { width: 100%; min-width: 1100px; border-collapse: collapse; }
    .cl-tabla th {
        padding: 16px; text-align: left;
        font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; color: #b6c2d4;
        border-bottom: 1px solid var(--cl-borde); white-space: nowrap;
    }
    .cl-tabla td { padding: 14px 16px; font-size: 14px; color: #dbe3ef; border-bottom: 1px solid #18253a; vertical-align: middle; }
    .cl-tabla tbody tr { transition: background .15s ease; }
    .cl-tabla tbody tr:hover { background: #13213a; }
    .cl-tabla tbody tr:last-child td { border-bottom: 0; }
    .cl-tabla th:first-child, .cl-tabla td:first-child { padding-left: 22px; width: 48px; }
    .cl-tabla th:last-child, .cl-tabla td:last-child { padding-right: 22px; }
    .cl-num { font-weight: 700; color: #fff; }

    .cl-persona { display: flex; align-items: center; gap: 14px; }
    .cl-avatar {
        width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
        display: grid; place-items: center; color: #fff; font-size: 16px; font-weight: 700;
    }
    .cl-persona b { display: block; font-weight: 600; color: #fff; white-space: nowrap; }
    .cl-persona small { display: block; margin-top: 3px; font-size: 12px; color: var(--cl-tenue); }
    .cl-nada { color: var(--cl-tenue); }
    .cl-registro { display: flex; align-items: flex-start; gap: 10px; white-space: nowrap; }
    .cl-registro svg { width: 18px; height: 18px; margin-top: 1px; color: var(--cl-suave); }
    .cl-registro small { display: block; margin-top: 3px; font-size: 12px; color: var(--cl-tenue); }

    .cl-chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; }
    .cl-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
    .cl-chip.activo { background: rgba(34, 211, 154, .14); color: var(--cl-verde); }
    .cl-chip.inactivo { background: rgba(163, 176, 196, .14); color: var(--cl-suave); }

    .cl-acciones { display: flex; align-items: center; gap: 10px; }
    .cl-btn {
        display: inline-flex; align-items: center; gap: 8px;
        height: 38px; padding: 0 16px; border-radius: 9px;
        font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; white-space: nowrap;
        transition: .15s ease;
    }
    .cl-btn svg { width: 16px; height: 16px; }
    .cl-btn.editar { background: rgba(79, 140, 255, .08); border: 1px solid rgba(79, 140, 255, .40); color: #dbe6ff; }
    .cl-btn.editar:hover { background: rgba(79, 140, 255, .18); color: #fff; }
    .cl-btn.eliminar { background: rgba(240, 93, 108, .08); border: 1px solid rgba(240, 93, 108, .45); color: #ff8b97; }
    .cl-btn.eliminar:hover { background: rgba(240, 93, 108, .18); color: #ffb3bb; }
    .cl-btn.eliminar:disabled { opacity: .4; cursor: not-allowed; background: transparent; }
    .cl-acciones form { margin: 0; }

    .cl-menu { position: relative; }
    .cl-menu-btn {
        width: 38px; height: 38px; display: grid; place-items: center;
        border-radius: 9px; border: 1px solid var(--cl-borde-2); background: #0c1627; color: #d4dceb; cursor: pointer;
    }
    .cl-menu-btn:hover { color: var(--cl-verde); border-color: var(--cl-verde); }
    .cl-menu-btn svg { width: 18px; height: 18px; }
    .cl-menu-lista {
        display: none; position: absolute; right: 0; top: calc(100% + 6px); z-index: 40;
        min-width: 200px; padding: 6px;
        background: #101c30; border: 1px solid var(--cl-borde-2); border-radius: 12px; box-shadow: 0 18px 40px rgba(0, 0, 0, .45);
    }
    .cl-menu.abierto .cl-menu-lista { display: block; }
    .cl-menu.arriba .cl-menu-lista { top: auto; bottom: calc(100% + 6px); }
    .cl-menu-lista a {
        display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px;
        color: #dbe3ef; font-size: 13px; text-decoration: none; white-space: nowrap;
    }
    .cl-menu-lista a:hover { background: #172741; color: #fff; }
    .cl-menu-lista svg { width: 16px; height: 16px; color: var(--cl-suave); }

    /* ---------- Roles ---------- */
    .cl-rol { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .cl-rol svg { width: 14px; height: 14px; }
    .cl-rol.admin { background: rgba(155, 107, 255, .14); color: #c4a6ff; border: 1px solid rgba(155, 107, 255, .35); }
    .cl-rol.cliente { background: rgba(79, 140, 255, .12); color: #9cc0ff; border: 1px solid rgba(79, 140, 255, .32); }
    .cl-rol.otro { background: rgba(245, 158, 11, .12); color: #ffc46b; border: 1px solid rgba(245, 158, 11, .32); }
    .cl-tu { margin-left: 6px; padding: 2px 7px; border-radius: 6px; background: rgba(34, 211, 154, .14); color: var(--cl-verde); font-size: 11px; font-weight: 700; vertical-align: 1px; }
    .cl-menu-lista form { margin: 0; }
    .cl-menu-lista button {
        width: 100%; display: flex; align-items: center; gap: 10px; padding: 9px 10px; border: 0; border-radius: 8px;
        background: transparent; color: #dbe3ef; font-size: 13px; text-align: left; cursor: pointer; white-space: nowrap;
    }
    .cl-menu-lista button:hover { background: #172741; color: #fff; }
    .cl-menu-lista button:disabled { opacity: .45; cursor: not-allowed; background: transparent; }

    /* ---------- Vista en cuadrícula ---------- */
    .cl-grid { display: none; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; padding: 20px 22px; }
    .cl[data-vista="grid"] .cl-grid { display: grid; }
    .cl[data-vista="grid"] .cl-tabla-wrap { display: none; }
    .cl-tarjeta { display: flex; flex-direction: column; gap: 14px; padding: 18px; background: #0c1627; border: 1px solid var(--cl-borde); border-radius: 14px; }
    .cl-tarjeta-cab { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .cl-tarjeta dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 12px; margin: 0; font-size: 13px; }
    .cl-tarjeta dt { color: var(--cl-tenue); }
    .cl-tarjeta dd { margin: 0; color: #dbe3ef; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cl-tarjeta .cl-acciones { justify-content: flex-end; flex-wrap: wrap; }

    /* ---------- Pie ---------- */
    .cl-pie { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 16px 22px; border-top: 1px solid var(--cl-borde); font-size: 14px; color: var(--cl-suave); }
    .cl-paginas { display: flex; align-items: center; gap: 8px; }
    .cl-paginas a, .cl-paginas span {
        min-width: 36px; height: 36px; padding: 0 8px; display: grid; place-items: center;
        border-radius: 9px; border: 1px solid var(--cl-borde-2); background: #0c1627;
        color: #dbe3ef; font-size: 13px; font-weight: 600; text-decoration: none;
    }
    .cl-paginas a:hover { border-color: var(--cl-verde); color: var(--cl-verde); }
    .cl-paginas .actual { background: var(--cl-verde); border-color: var(--cl-verde); color: #04241a; }
    .cl-paginas .apagado { opacity: .4; }
    .cl-paginas svg { width: 16px; height: 16px; }

    .cl-vacio { padding: 64px 20px; text-align: center; }
    .cl-vacio-icono { width: 58px; height: 58px; margin: 0 auto 16px; display: grid; place-items: center; border-radius: 16px; background: rgba(34, 211, 154, .10); color: var(--cl-verde); }
    .cl-vacio-icono svg { width: 28px; height: 28px; }
    .cl-vacio h3 { margin: 0; font-size: 16px; font-weight: 800; color: #fff; }
    .cl-vacio p { margin: 8px 0 18px; font-size: 13px; color: var(--cl-suave); }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1280px) {
        .cl-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 760px) {
        .cl-cab { flex-direction: column; align-items: flex-start; }
        .cl-cab h1 { font-size: 28px; }
        .cl-btn-nuevo { width: 100%; justify-content: center; }
        .cl-kpis { grid-template-columns: 1fr; }
        .cl-filtros { flex-wrap: wrap; }
        .cl-buscar { flex-basis: 100%; }
        .cl-estado { flex: 1 1 140px; width: auto; }
        .cl-pie { flex-direction: column; }
    }
</style>

<div class="cl" id="clPagina" data-vista="lista">

    @if (TempData["Success"] != null)
    {
        <div class="cl-alerta ok">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6L9 17l-5-5" /></svg>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="cl-alerta error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- ===================== ENCABEZADO ===================== -->
    <div class="cl-cab">
        <div class="cl-cab-izq">
            <div class="cl-cab-icono">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="10" cy="7.5" r="3.8" />
                    <path d="M2.8 19.6c0-3.9 3.1-6.6 7.2-6.6 1.5 0 2.9.4 4 1v6.2H2.8z" />
                    <path d="M18 11.8l4 1.5v3c0 2.6-1.7 4.6-4 5.4-2.3-.8-4-2.8-4-5.4v-3z" opacity=".85" />
                    <path d="M16.4 16.6l1.2 1.2 2.1-2.3" fill="none" stroke="#0b1424" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div>
                <h1>Usuarios</h1>
                <p>Administra las cuentas, roles y accesos de Sportia</p>
            </div>
        </div>

        <a asp-controller="AdminUsuario" asp-action="Create" class="cl-btn-nuevo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            Nuevo usuario
        </a>
    </div>

    <!-- ===================== TARJETAS ===================== -->
    <section class="cl-kpis">
        <div class="cl-kpi azul">
            <div class="cl-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 19.5c.6-3.3 3.1-5.3 6.5-5.3s5.9 2 6.5 5.3" /><path d="M16 4.7a3.5 3.5 0 0 1 0 6.6M18.5 14.6c1.7.7 2.8 2.4 3 4.9" /></svg>
            </div>
            <div class="cl-kpi-cuerpo">
                <div class="cl-kpi-label">Total usuarios</div>
                <div class="cl-kpi-fila"><span class="cl-kpi-num">@Model.Total</span>@Variacion(Model.VariacionTotal)</div>
                <div class="cl-kpi-desc">Cuentas registradas en el sistema</div>
            </div>
        </div>

        <div class="cl-kpi morado">
            <div class="cl-kpi-icono">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l8 3v6c0 5-3.4 8.8-8 10-4.6-1.2-8-5-8-10v-6z" /><path d="M12 8.2l1.2 2.4 2.6.4-1.9 1.8.5 2.6-2.4-1.3-2.4 1.3.5-2.6-1.9-1.8 2.6-.4z" fill="#3b1a8f" /></svg>
            </div>
            <div class="cl-kpi-cuerpo">
                <div class="cl-kpi-label">Administradores</div>
                <div class="cl-kpi-fila"><span class="cl-kpi-num">@Model.Administradores</span>@Variacion(Model.VariacionAdministradores)</div>
                <div class="cl-kpi-desc">Con acceso total al panel</div>
            </div>
        </div>

        <div class="cl-kpi verde">
            <div class="cl-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4.5 20.5c.8-3.8 3.8-6 7.5-6s6.7 2.2 7.5 6z" /></svg>
            </div>
            <div class="cl-kpi-cuerpo">
                <div class="cl-kpi-label">Clientes</div>
                <div class="cl-kpi-fila"><span class="cl-kpi-num">@Model.Clientes</span>@Variacion(Model.VariacionClientes)</div>
                <div class="cl-kpi-desc">Usuarios que reservan escenarios</div>
            </div>
        </div>

        <div class="cl-kpi ambar">
            <div class="cl-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12.3l2.7 2.7L16.2 9.4" /></svg>
            </div>
            <div class="cl-kpi-cuerpo">
                <div class="cl-kpi-label">Activos</div>
                <div class="cl-kpi-fila"><span class="cl-kpi-num">@Model.Activos</span><span class="cl-var" style="color:#d9c7a4">@Model.Inactivos inactivo@(Model.Inactivos == 1 ? "" : "s")</span></div>
                <div class="cl-kpi-desc">Pueden iniciar sesión</div>
            </div>
        </div>
    </section>

    <!-- ===================== FILTROS ===================== -->
    <form method="get" asp-controller="AdminUsuario" asp-action="Index" class="cl-filtros" id="clFiltros">
        <div class="cl-buscar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input type="search" name="buscar" id="clBuscar" value="@Model.Buscar" placeholder="Buscar por nombre, documento, teléfono o correo..." autocomplete="off" />
        </div>

        <div class="cl-estado">
            <div class="cl-estado-caja">
                @Html.Raw(icoEscudo)
                <span>@textoRol</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            </div>
            <select name="rol" aria-label="Rol" onchange="this.form.submit()">
                <option value="">Todos los roles</option>
                @foreach (var r in Model.Roles)
                {
                    <option value="@r.IdRol" selected="@(Model.IdRol == r.IdRol)">@r.Nombre</option>
                }
            </select>
        </div>

        <div class="cl-estado">
            <div class="cl-estado-caja">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3.5 5h17l-6.5 7.6V19l-4 1.5v-7.9z" /></svg>
                <span>@textoEstado</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            </div>
            <select name="estado" aria-label="Estado" onchange="this.form.submit()">
                <option value="" selected="@(Model.Estado == "")">Todos los estados</option>
                <option value="activo" selected="@(Model.Estado == "activo")">Activos</option>
                <option value="inactivo" selected="@(Model.Estado == "inactivo")">Inactivos</option>
            </select>
        </div>

        <div class="cl-vistas" role="group" aria-label="Vista">
            <button type="button" data-vista="grid" title="Vista en tarjetas">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" /></svg>
            </button>
            <button type="button" data-vista="lista" title="Vista en lista" class="activo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
            </button>
        </div>
    </form>

    <!-- ===================== LISTA ===================== -->
    <section class="cl-lista">
        <div class="cl-lista-cab">
            <div>
                <h2>Usuarios registrados</h2>
                <p>Cuentas con acceso a la plataforma Sportia</p>
            </div>
            <span class="cl-badge">@Model.TotalFiltrados usuario@(Model.TotalFiltrados == 1 ? "" : "s")</span>
        </div>

        @if (Model.Usuarios.Any())
        {
            <div class="cl-tabla-wrap">
                <table class="cl-tabla">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Documento</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Registro</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Usuarios)
                        {
                            <tr>
                                <td class="cl-num">@u.Numero</td>
                                <td>
                                    <div class="cl-persona">
                                        <span class="cl-avatar" style="background:@ColorAvatar(u.Nombre)">@Iniciales(u.Nombre)</span>
                                        <div>
                                            <b>@u.Nombre @if (u.EsUsuarioActual) { <span class="cl-tu">Tú</span> }</b>
                                            <small>@u.Correo</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@u.Documento</td>
                                <td>@if (string.IsNullOrWhiteSpace(u.Telefono)) { <span class="cl-nada">—</span> } else { @u.Telefono }</td>
                                <td><span class="cl-rol @ClaseRol(u)">@Html.Raw(u.IdRol == 1 ? icoEscudo : icoPersona) @u.Rol</span></td>
                                <td>
                                    @if (u.FechaRegistro.HasValue)
                                    {
                                        <div class="cl-registro">
                                            @Html.Raw(icoCalendario)
                                            <div>@u.FechaRegistro.Value.ToString("dd/MM/yyyy")<small>@u.FechaRegistro.Value.ToString("hh:mm tt", co)</small></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cl-nada">—</span>
                                    }
                                </td>
                                <td><span class="cl-chip @(u.Activo ? "activo" : "inactivo")">@(u.Activo ? "Activo" : "Inactivo")</span></td>
                                <td><partial name="_AccionesUsuario" model="u" view-data='new ViewDataDictionary(ViewData) { { "Volver", urlActual } }' /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cl-grid">
                @foreach (var u in Model.Usuarios)
                {
                    <article class="cl-tarjeta">
                        <div class="cl-tarjeta-cab">
                            <div class="cl-persona">
                                <span class="cl-avatar" style="background:@ColorAvatar(u.Nombre)">@Iniciales(u.Nombre)</span>
                                <div>
                                    <b>@u.Nombre @if (u.EsUsuarioActual) { <span class="cl-tu">Tú</span> }</b>
                                    <small>ID #@u.IdUsuario</small>
                                </div>
                            </div>
                            <span class="cl-chip @(u.Activo ? "activo" : "inactivo")">@(u.Activo ? "Activo" : "Inactivo")</span>
                        </div>
                        <div><span class="cl-rol @ClaseRol(u)">@Html.Raw(u.IdRol == 1 ? icoEscudo : icoPersona) @u.Rol</span></div>
                        <dl>
                            <dt>Documento</dt><dd>@u.Documento</dd>
                            <dt>Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(u.Telefono) ? "—" : u.Telefono)</dd>
                            <dt>Correo</dt><dd title="@u.Correo">@u.Correo</dd>
                            <dt>Registro</dt><dd>@(u.FechaRegistro.HasValue ? u.FechaRegistro.Value.ToString("dd/MM/yyyy") + " · " + u.FechaRegistro.Value.ToString("hh:mm tt", co) : "—")</dd>
                        </dl>
                        <partial name="_AccionesUsuario" model="u" view-data='new ViewDataDictionary(ViewData) { { "Volver", urlActual } }' />
                    </article>
                }
            </div>

            <div class="cl-pie">
                <span>Mostrando @Model.MostrandoDesde - @Model.MostrandoHasta de @Model.TotalFiltrados usuario@(Model.TotalFiltrados == 1 ? "" : "s")</span>

                <nav class="cl-paginas" aria-label="Páginas">
                    @if (Model.Pagina > 1)
                    {
                        <a href="@UrlPagina(Model.Pagina - 1)" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" /></svg></a>
                    }
                    else
                    {
                        <span class="apagado"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" /></svg></span>
                    }

                    @{
                        int ini = Math.Max(1, Model.Pagina - 2);
                        int fin = Math.Min(Model.TotalPaginas, ini + 4);
                        ini = Math.Max(1, fin - 4);
                    }
                    @for (int p = ini; p <= fin; p++)
                    {
                        if (p == Model.Pagina)
                        {
                            <span class="actual">@p</span>
                        }
                        else
                        {
                            <a href="@UrlPagina(p)">@p</a>
                        }
                    }

                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a href="@UrlPagina(Model.Pagina + 1)" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></a>
                    }
                    else
                    {
                        <span class="apagado"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></span>
                    }
                </nav>
            </div>
        }
        else
        {
            <div class="cl-vacio">
                <div class="cl-vacio-icono">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                </div>
                <h3>No se encontraron usuarios</h3>
                <p>Prueba con otro nombre, rol o estado.</p>
                <a asp-action="Index" class="cl-btn editar">Ver todos los usuarios</a>
            </div>
        }
    </section>
</div>

<script>
    (function () {
        const pagina = document.getElementById('clPagina');

        // ---------- Vista lista / tarjetas (se recuerda en este navegador) ----------
        const botones = document.querySelectorAll('.cl-vistas button');
        function ponerVista(v) {
            pagina.dataset.vista = v;
            botones.forEach(b => b.classList.toggle('activo', b.dataset.vista === v));
        }
        try { const v = localStorage.getItem('sportia-usuarios-vista'); if (v === 'grid' || v === 'lista') ponerVista(v); } catch (e) { }
        botones.forEach(b => b.addEventListener('click', () => {
            ponerVista(b.dataset.vista);
            try { localStorage.setItem('sportia-usuarios-vista', b.dataset.vista); } catch (e) { }
        }));

        // ---------- Búsqueda: se aplica sola al dejar de escribir ----------
        const input = document.getElementById('clBuscar');
        const form = document.getElementById('clFiltros');
        let espera;
        input.addEventListener('input', () => {
            clearTimeout(espera);
            espera = setTimeout(() => form.submit(), 600);
        });
        if (input.value) {
            input.focus();
            const n = input.value.length;
            input.setSelectionRange(n, n);
        }

        // ---------- Menú de tres puntos ----------
        document.querySelectorAll('.cl-menu-btn').forEach(btn => btn.addEventListener('click', e => {
            e.stopPropagation();
            const menu = btn.closest('.cl-menu');
            const abierto = menu.classList.contains('abierto');
            document.querySelectorAll('.cl-menu.abierto').forEach(m => m.classList.remove('abierto'));
            if (!abierto) {
                menu.classList.toggle('arriba', btn.getBoundingClientRect().bottom > window.innerHeight - 150);
                menu.classList.add('abierto');
            }
        }));
        document.addEventListener('click', e => {
            if (!e.target.closest('.cl-menu')) document.querySelectorAll('.cl-menu.abierto').forEach(m => m.classList.remove('abierto'));
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') document.querySelectorAll('.cl-menu.abierto').forEach(m => m.classList.remove('abierto'));
        });

        // ---------- Confirmaciones ----------
        document.querySelectorAll('[data-confirmar]').forEach(f => f.addEventListener('submit', e => {
            if (!confirm(f.dataset.confirmar)) e.preventDefault();
        }));
    })();
</script>
