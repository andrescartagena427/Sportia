@model IEnumerable<Sportia.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
    Layout = "_DashboardLayout";

    var totalUsuarios = Model.Count();
    var usuariosActivos = Model.Count(u => u.Estado == true);
    var usuariosInactivos = Model.Count(u => u.Estado == false);
}

<div class="space-y-6">

    <!-- ENCABEZADO -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

        <div class="flex items-center gap-4">

            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center">
                <i data-lucide="users"
                   class="w-6 h-6 text-emerald-400"></i>
            </div>

            <div>
                <h1 class="text-2xl font-bold text-white">
                    Usuarios
                </h1>

                <p class="text-sm text-slate-400">
                    Administra los usuarios del sistema Sportia
                </p>
            </div>

        </div>

        <a asp-controller="AdminUsuario"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2
            px-5 py-2.5
            rounded-xl
            bg-emerald-500
            hover:bg-emerald-400
            text-slate-950
            text-sm font-semibold
            transition">

            <i data-lucide="plus" class="w-4 h-4"></i>

            Nuevo usuario
        </a>

    </div>


    <!-- MENSAJES -->
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-3
            rounded-xl
            border border-emerald-500/20
            bg-emerald-500/10
            px-4 py-3
            text-emerald-300">

            <i data-lucide="check-circle" class="w-5 h-5"></i>

            <span class="text-sm">
                @TempData["Success"]
            </span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3
            rounded-xl
            border border-red-500/20
            bg-red-500/10
            px-4 py-3
            text-red-300">

            <i data-lucide="alert-circle" class="w-5 h-5"></i>

            <span class="text-sm">
                @TempData["Error"]
            </span>
        </div>
    }


    <!-- ESTADÍSTICAS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- TOTAL -->
        <div class="rounded-2xl
            border border-slate-800
            bg-slate-900/60
            p-5">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Total usuarios
                    </p>

                    <p class="mt-2 text-3xl font-bold text-white">
                        @totalUsuarios
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Usuarios registrados
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-blue-500/10
                    flex items-center justify-center">

                    <i data-lucide="users"
                       class="w-5 h-5 text-blue-400"></i>

                </div>

            </div>

        </div>


        <!-- ACTIVOS -->
        <div class="rounded-2xl
            border border-slate-800
            bg-slate-900/60
            p-5">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Usuarios activos
                    </p>

                    <p class="mt-2 text-3xl font-bold text-emerald-400">
                        @usuariosActivos
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Pueden ingresar al sistema
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-emerald-500/10
                    flex items-center justify-center">

                    <i data-lucide="user-check"
                       class="w-5 h-5 text-emerald-400"></i>

                </div>

            </div>

        </div>


        <!-- INACTIVOS -->
        <div class="rounded-2xl
            border border-slate-800
            bg-slate-900/60
            p-5">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-xs uppercase tracking-wider text-slate-500">
                        Usuarios inactivos
                    </p>

                    <p class="mt-2 text-3xl font-bold text-red-400">
                        @usuariosInactivos
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Acceso deshabilitado
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-red-500/10
                    flex items-center justify-center">

                    <i data-lucide="user-x"
                       class="w-5 h-5 text-red-400"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- BUSCADOR -->
    <div class="rounded-2xl
        border border-slate-800
        bg-slate-900/60
        p-4">

        <form asp-action="Index"
              method="get"
              class="flex flex-col md:flex-row gap-3">

            <div class="relative flex-1">

                <i data-lucide="search"
                   class="absolute left-4 top-1/2
                -translate-y-1/2
                w-4 h-4
                text-slate-500"></i>

                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       placeholder="Buscar por nombre, documento, teléfono o correo..."
                       class="w-full
                rounded-xl
                border border-slate-800
                bg-slate-950
                py-3 pl-11 pr-4
                text-sm text-white
                placeholder:text-slate-600
                focus:border-emerald-500
                focus:outline-none" />

            </div>

            <button type="submit"
                    class="inline-flex items-center justify-center gap-2
                rounded-xl
                bg-slate-800
                hover:bg-slate-700
                px-5 py-3
                text-sm font-semibold
                text-white
                transition">

                <i data-lucide="search" class="w-4 h-4"></i>

                Buscar
            </button>

        </form>

    </div>


    <!-- TABLA -->
    <div class="overflow-hidden
        rounded-2xl
        border border-slate-800
        bg-slate-900/60">

        <!-- CABECERA -->
        <div class="border-b border-slate-800 px-5 py-4">

            <h2 class="text-base font-semibold text-white">
                Usuarios registrados
            </h2>

            <p class="mt-1 text-xs text-slate-500">
                Consulta y administra los usuarios de Sportia
            </p>

        </div>


        @if (Model.Any())
        {
            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="border-b border-slate-800 bg-slate-950/50">

                        <tr>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Usuario
                            </th>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Documento
                            </th>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Rol
                            </th>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Teléfono
                            </th>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Correo
                            </th>

                            <th class="px-5 py-4 text-left
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Estado
                            </th>

                            <th class="px-5 py-4 text-right
                                text-[11px] uppercase tracking-wider
                                text-slate-500">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-800">

                        @foreach (var usuario in Model)
                        {
                            var inicial =
                                !string.IsNullOrWhiteSpace(usuario.Nombres)
                                    ? usuario.Nombres.Substring(0, 1).ToUpper()
                                    : "U";

                            <tr class="hover:bg-slate-800/30 transition">

                                <!-- USUARIO -->
                                <td class="px-5 py-4">

                                    <div class="flex items-center gap-3">

                                        <div class="w-10 h-10
                                            rounded-xl
                                            bg-emerald-500/10
                                            flex items-center justify-center
                                            text-emerald-400
                                            font-semibold">

                                            @inicial

                                        </div>

                                        <div>

                                            <p class="text-sm font-semibold text-white">
                                                @usuario.Nombres @usuario.Apellidos
                                            </p>

                                            <p class="text-xs text-slate-500">
                                                ID #@usuario.IdUsuario
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- DOCUMENTO -->
                                <td class="px-5 py-4">

                                    <span class="text-sm text-slate-300">
                                        @usuario.Documento
                                    </span>

                                </td>


                                <!-- ROL -->
                                <td class="px-5 py-4">

                                    <span class="inline-flex
                                        rounded-lg
                                        border border-blue-500/20
                                        bg-blue-500/10
                                        px-3 py-1
                                        text-xs
                                        font-medium
                                        text-blue-300">

                                        @(usuario.IdRolNavigation?.Nombre ?? "Sin rol")

                                    </span>

                                </td>


                                <!-- TELEFONO -->
                                <td class="px-5 py-4">

                                    <span class="text-sm text-slate-300">
                                        @(usuario.Telefono ?? "Sin teléfono")
                                    </span>

                                </td>


                                <!-- CORREO -->
                                <td class="px-5 py-4">

                                    <span class="text-sm text-slate-300">
                                        @usuario.Correo
                                    </span>

                                </td>


                                <!-- ESTADO -->
                                <td class="px-5 py-4">

                                    @if (usuario.Estado == true)
                                    {
                                        <span class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-emerald-500/20
                                            bg-emerald-500/10
                                            px-3 py-1
                                            text-xs font-medium
                                            text-emerald-300">

                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-red-500/20
                                            bg-red-500/10
                                            px-3 py-1
                                            text-xs font-medium
                                            text-red-300">

                                            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="px-5 py-4">

                                    <div class="flex justify-end items-center gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-slate-700
                                            bg-slate-800/60
                                            hover:bg-slate-700
                                            px-3 py-2
                                            text-xs font-medium
                                            text-slate-300
                                            hover:text-white
                                            transition">

                                            <i data-lucide="eye" class="w-4 h-4"></i>

                                            Ver
                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-blue-500/20
                                            bg-blue-500/10
                                            hover:bg-blue-500/20
                                            px-3 py-2
                                            text-xs font-medium
                                            text-blue-300
                                            transition">

                                            <i data-lucide="pencil" class="w-4 h-4"></i>

                                            Editar
                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@usuario.IdUsuario"
                                              method="post"
                                              onsubmit="return confirm('¿Está seguro de eliminar este usuario?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="inline-flex items-center gap-2
                                                rounded-lg
                                                border border-red-500/20
                                                bg-red-500/10
                                                hover:bg-red-500/20
                                                px-3 py-2
                                                text-xs font-medium
                                                text-red-300
                                                transition">

                                                <i data-lucide="trash-2" class="w-4 h-4"></i>

                                                Eliminar

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="px-6 py-16 text-center">

                <div class="mx-auto w-14 h-14
                    rounded-2xl
                    bg-slate-800
                    flex items-center justify-center">

                    <i data-lucide="users"
                       class="w-7 h-7 text-slate-500"></i>

                </div>

                <h3 class="mt-4 text-base font-semibold text-white">
                    No hay usuarios
                </h3>

                <p class="mt-1 text-sm text-slate-500">
                    No se encontraron usuarios con la búsqueda realizada.
                </p>

            </div>
        }

    </div>

</div>

<script>
    lucide.createIcons();
</script>