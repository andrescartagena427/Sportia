@using Microsoft.AspNetCore.Http
@using Sportia.Models

@{
    ViewData["Title"] = "Panel del Cliente";
    Layout = "_ClienteLayout";

    // =========================================================
    // INFORMACIÓN DEL CLIENTE DESDE LA SESIÓN
    // =========================================================

    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Cliente";

    var correoUsuario = Context.Session.GetString("CorreoUsuario") ?? "Sin correo";

    var rolUsuario = Context.Session.GetString("Rol") ?? "Cliente";

    // Primera letra del nombre real
    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim().Substring(0, 1).ToUpper()
        : "C";

    // =========================================================
    // DATOS REALES DESDE EL CONTROLLER
    // =========================================================

    var totalReservas = (int)(ViewBag.TotalReservas ?? 0);
    var reservasProximas = (int)(ViewBag.ReservasProximas ?? 0);
    var totalEscenarios = (int)(ViewBag.TotalEscenarios ?? 0);

    var escenarios = ViewBag.Escenarios as List<Escenario>
        ?? new List<Escenario>();

    const string imagenPorDefecto =
        "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=900&q=80";
}

<div class="min-h-screen bg-slate-950 text-white">

    <!-- El encabezado ahora está en Views/Shared/_ClienteLayout.cshtml -->


    <!-- =========================================================
         CONTENIDO (rediseño: menú lateral + contenido + actividad)
    ========================================================== -->

    @{
        var culturaCo = new System.Globalization.CultureInfo("es-CO");

        var categoriasDisponibles = escenarios
            .Select(e => e.IdTipoNavigation?.Nombre ?? "Deporte")
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        var escenariosNuevos = escenarios
            .Where(e => e.Estado == true)
            .OrderByDescending(e => e.IdEscenario)
            .Take(3)
            .ToList();
    }

    <main id="inicio"
          class="mx-auto grid max-w-[1600px] gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[220px_minmax(0,1fr)] lg:px-8 xl:grid-cols-[220px_minmax(0,1fr)_300px]">


        <!-- =====================================================
             MENÚ LATERAL
        ====================================================== -->

        <aside class="hidden lg:block">
            <div class="sticky top-28 flex flex-col gap-6">

                <nav class="flex flex-col gap-1 text-sm font-medium" aria-label="Menú del cliente">
                    <a href="#inicio" class="flex items-center gap-3 rounded-xl bg-emerald-500/15 px-4 py-3 font-semibold text-white ring-1 ring-emerald-500/30">
                        <svg class="h-5 w-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" /></svg>
                        Inicio
                    </a>
                    <a href="#escenarios" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-white/5 hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7l4 3-1.5 4.5h-5L8 10z" /></svg>
                        Escenarios
                    </a>
                    <a href="#reservas" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-white/5 hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        Mis reservas
                    </a>
                    <button type="button" id="btnFavoritosLateral" class="flex items-center gap-3 rounded-xl px-4 py-3 text-left text-slate-300 transition hover:bg-white/5 hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                        Favoritos
                    </button>
                    <a href="#ayuda" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-white/5 hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01" /></svg>
                        Ayuda
                    </a>
                    <a asp-controller="Contacto" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-white/5 hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        Contacto
                    </a>
                </nav>

                <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-slate-900 to-slate-950 p-5">
                    <div class="absolute -bottom-10 -right-10 h-32 w-32 rotate-12 rounded-3xl bg-emerald-500/20"></div>
                    <div class="relative">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-amber-400">
                            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M7 3h10v3h3v2a5 5 0 0 1-4.6 5A5 5 0 0 1 13 15.9V18h3v3H8v-3h3v-2.1A5 5 0 0 1 8.6 13 5 5 0 0 1 4 8V6h3zm0 5V8H6a3 3 0 0 0 1 2.2zm10 0v2.2A3 3 0 0 0 18 8z" /></svg>
                        </span>
                        <p class="mt-4 text-lg font-black leading-tight">Tu deporte,<br>nuestra pasión</p>
                        <p class="mt-2 text-sm text-slate-400">Reserva, juega, disfruta.</p>
                    </div>
                </div>
            </div>
        </aside>


        <!-- =====================================================
             CONTENIDO CENTRAL
        ====================================================== -->

        <div class="min-w-0 space-y-6">

            @if (TempData["MensajeReserva"] != null)
            {
                <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-4 text-sm font-semibold text-emerald-300">
                    @TempData["MensajeReserva"]
                </div>
            }

            @if (TempData["ErrorReserva"] != null)
            {
                <div class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm font-semibold text-red-300">
                    @TempData["ErrorReserva"]
                </div>
            }


            <!-- ================= BIENVENIDA ================= -->

            <section class="relative isolate overflow-hidden rounded-3xl border border-emerald-500/20 bg-slate-950">
                <img src="@imagenPorDefecto"
                     alt=""
                     class="cliente-kenburns absolute inset-y-0 right-0 -z-10 h-full w-full object-cover opacity-80 md:w-3/5">
                <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/10"></div>
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>

                <div class="flex flex-wrap items-center justify-between gap-6 p-6 sm:p-10">
                    <div class="max-w-xl">
                        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1.5 text-xs font-bold text-emerald-300">
                            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                            Plataforma disponible
                        </span>

                        <h1 class="mt-5 text-4xl font-black leading-[1.05] tracking-tight sm:text-5xl">
                            Tu próximo partido<br>
                            <span class="text-emerald-400">empieza aquí.</span>
                        </h1>

                        <p class="mt-4 text-slate-300 sm:text-lg">
                            Hola, <span class="font-semibold text-white">@nombreUsuario</span>. Encuentra escenarios deportivos,
                            consulta horarios disponibles y reserva tu espacio favorito en pocos pasos.
                        </p>

                        <div class="mt-7 flex flex-wrap gap-3">
                            <a href="#escenarios"
                               class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 font-bold text-white shadow-lg shadow-emerald-500/25 transition hover:-translate-y-0.5 hover:bg-emerald-400">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                                Buscar escenario
                            </a>
                            <a href="#reservas"
                               class="inline-flex items-center rounded-xl border border-white/20 bg-slate-950/40 px-6 py-3 font-bold text-white backdrop-blur transition hover:border-emerald-500/60">
                                Mis reservas
                            </a>
                        </div>
                    </div>

                    <p class="hidden -rotate-12 text-right font-black italic leading-none text-white/90 drop-shadow-lg md:block md:text-4xl">
                        Juega<br><span class="text-emerald-400">sin límites</span>
                    </p>
                </div>
            </section>


            <!-- ================= ESTADÍSTICAS ================= -->

            <section class="grid grid-cols-2 gap-4 xl:grid-cols-4">

                <a href="#reservas" class="group rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:-translate-y-0.5 hover:border-emerald-500/40">
                    <div class="flex items-center justify-between">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M8 14h2M14 14h2M8 18h2" /></svg>
                        </span>
                        <svg class="h-5 w-5 text-slate-600 transition group-hover:translate-x-1 group-hover:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </div>
                    <p class="mt-4 text-3xl font-black leading-none ">@totalReservas</p>
                    <p class="mt-2 truncate text-sm font-semibold text-slate-200">Reservas realizadas</p>
                    <p class="truncate text-xs text-slate-500">Reservas completadas</p>
                </a>
                <a href="#reservas" class="group rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:-translate-y-0.5 hover:border-emerald-500/40">
                    <div class="flex items-center justify-between">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                        </span>
                        <svg class="h-5 w-5 text-slate-600 transition group-hover:translate-x-1 group-hover:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </div>
                    <p class="mt-4 text-3xl font-black leading-none ">@reservasProximas</p>
                    <p class="mt-2 truncate text-sm font-semibold text-slate-200">Próximas</p>
                    <p class="truncate text-xs text-slate-500">Reservas por jugar</p>
                </a>
                <a href="#escenarios" class="group rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:-translate-y-0.5 hover:border-emerald-500/40">
                    <div class="flex items-center justify-between">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><circle cx="17" cy="9" r="2.5" /><path d="M16 14.2a5 5 0 0 1 5.5 4.8" /></svg>
                        </span>
                        <svg class="h-5 w-5 text-slate-600 transition group-hover:translate-x-1 group-hover:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </div>
                    <p class="mt-4 text-3xl font-black leading-none ">@totalEscenarios</p>
                    <p class="mt-2 truncate text-sm font-semibold text-slate-200">Escenarios</p>
                    <p class="truncate text-xs text-slate-500">Disponibles actualmente</p>
                </a>
                <a asp-controller="Usuario" asp-action="Perfil" class="group rounded-2xl border border-white/10 bg-slate-900/60 p-5 transition hover:-translate-y-0.5 hover:border-emerald-500/40">
                    <div class="flex items-center justify-between">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                            <span class="h-3.5 w-3.5 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.8)]"></span>
                        </span>
                        <svg class="h-5 w-5 text-slate-600 transition group-hover:translate-x-1 group-hover:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="m9 6 6 6-6 6" /></svg>
                    </div>
                    <p class="mt-4 text-3xl font-black leading-none text-emerald-400">Activo</p>
                    <p class="mt-2 truncate text-sm font-semibold text-slate-200">Estado</p>
                    <p class="truncate text-xs text-slate-500">Cuenta disponible</p>
                </a>
            </section>


            <!-- ================= ESCENARIOS ================= -->

            <section id="escenarios" class="scroll-mt-24">

                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-400">Explora</p>
                        <h2 id="tituloEscenarios" class="mt-1 text-2xl font-black sm:text-3xl">Escenarios deportivos</h2>
                        <p class="mt-1 text-slate-400">Encuentra el lugar perfecto para jugar.</p>
                    </div>

                    <div class="flex w-full gap-2 sm:w-auto">
                        <div class="relative flex-1 sm:w-64">
                            <label for="buscadorEscenarios" class="sr-only">Buscar escenario</label>
                            <input type="text"
                                   id="buscadorEscenarios"
                                   placeholder="Buscar escenario..."
                                   class="w-full rounded-xl border border-white/10 bg-white/[0.04] py-3 pl-11 pr-4 text-sm text-white placeholder:text-slate-500 focus:border-emerald-500/50 focus:outline-none focus:ring-2 focus:ring-emerald-500/10">
                            <svg class="absolute left-4 top-3.5 h-5 w-5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" /></svg>
                        </div>
                        <button type="button" id="btnFiltros" aria-expanded="false"
                                class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-4 text-sm font-semibold transition hover:border-emerald-500/50">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
                            Filtros
                        </button>
                    </div>
                </div>

                <!-- Filtros por tipo de escenario -->
                <div id="panelFiltros" class="mt-4 hidden flex-wrap gap-2">
                    <button type="button" data-filtro="" class="filtro-categoria rounded-full bg-emerald-500 px-4 py-2 text-xs font-bold text-white">Todos</button>
                    @foreach (var cat in categoriasDisponibles)
                    {
                        <button type="button" data-filtro="@cat" class="filtro-categoria rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-bold text-slate-300 hover:text-white">@cat</button>
                    }
                    <button type="button" data-filtro="__favoritos" class="filtro-categoria rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-xs font-bold text-slate-300 hover:text-white">♥ Favoritos</button>
                </div>

                <div class="mt-6 grid gap-5 sm:grid-cols-2 2xl:grid-cols-3" id="gridEscenarios">

                    @if (escenarios.Any())
                    {
                        int posicion = 0;
                        const int cardsPorPagina = 6;

                        foreach (var esc in escenarios)
                        {
                            string imagenUrl = !string.IsNullOrWhiteSpace(esc.Imagen)
                                ? esc.Imagen
                                : imagenPorDefecto;

                            string categoria = esc.IdTipoNavigation?.Nombre ?? "Deporte";

                            bool disponible = esc.Estado == true;

                            bool visibleInicialmente = posicion < cardsPorPagina;
                            posicion++;

                            string capacidadTexto = esc.Capacidad.HasValue
                                ? $"{esc.Capacidad} {(esc.Capacidad == 1 ? "persona" : "personas")}"
                                : "Capacidad N/D";

                            <!-- CANCHA (@esc.Nombre) -->

                            <article class="escenario-card group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/70 transition duration-300 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-500/10"
                                     data-nombre="@esc.Nombre.ToLower()"
                                     data-id-escenario="@esc.IdEscenario"
                                     data-nombre-escenario="@esc.Nombre"
                                     data-categoria="@categoria"
                                     data-imagen="@imagenUrl"
                                     data-descripcion="@(esc.Descripcion ?? "Escenario deportivo disponible para reservar.")"
                                     data-capacidad="@(esc.Capacidad?.ToString() ?? "N/D")"
                                     style="@(visibleInicialmente ? "" : "display:none;")">

                                <div class="relative h-44 overflow-hidden">
                                    <img src="@imagenUrl"
                                         class="h-full w-full object-cover transition duration-700 group-hover:scale-110"
                                         alt="@esc.Nombre"
                                         loading="lazy">
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

                                    <span class="absolute left-3 top-3 rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wide text-white @(disponible ? "bg-emerald-500" : "bg-slate-600")">
                                        @(disponible ? "DISPONIBLE" : "NO DISPONIBLE")
                                    </span>

                                    <button type="button"
                                            class="btn-favorito absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-slate-950/60 text-white backdrop-blur transition hover:scale-110"
                                            data-id="@esc.IdEscenario"
                                            aria-label="Guardar @esc.Nombre en favoritos"
                                            aria-pressed="false">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                                    </button>
                                </div>

                                <div class="flex flex-1 flex-col p-4">
                                    <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">@categoria</p>
                                    <h3 class="mt-1 text-lg font-bold">@esc.Nombre</h3>
                                    <p class="mt-1 line-clamp-2 text-sm text-slate-400">
                                        @(!string.IsNullOrWhiteSpace(esc.Descripcion)
                                            ? esc.Descripcion
                                            : "Escenario deportivo disponible para reservar.")
                                    </p>

                                    <div class="mt-4 flex items-center justify-between gap-3 text-sm">
                                        <span class="flex items-center gap-2 text-slate-300">
                                            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><circle cx="17" cy="9" r="2.5" /><path d="M16 14.2a5 5 0 0 1 5.5 4.8" /></svg>
                                            @capacidadTexto
                                        </span>
                                        @if (esc.Precio.HasValue && esc.Precio.Value > 0)
                                        {
                                            <span class="font-bold text-white">@esc.Precio.Value.ToString("C0", culturaCo) <span class="font-normal text-slate-400">/ hora</span></span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-500">Consultar precio</span>
                                        }
                                    </div>

                                    <div class="mt-4 flex justify-end">
                                        @if (disponible)
                                        {
                                            <a asp-controller="Cliente"
                                               asp-action="Reservar"
                                               asp-route-idEscenario="@esc.IdEscenario"
                                               class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-400">
                                                Reservar
                                                <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="rounded-xl bg-white/5 px-4 py-2.5 text-sm font-bold text-slate-500">
                                                No disponible
                                            </span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="col-span-full py-10 text-center text-slate-500">
                            No hay escenarios registrados todavía.
                        </div>
                    }
                </div>

                <p id="sinResultadosEscenarios" class="mt-6 hidden rounded-2xl border border-dashed border-white/10 p-6 text-center text-sm text-slate-400">
                    No encontramos escenarios con ese filtro. Prueba con otra palabra o elige "Todos".
                </p>

                @if (escenarios.Count > 6)
                {
                    <div class="mt-8 flex justify-center">
                        <button id="btnVerMasEscenarios"
                                data-mostrados="6"
                                data-total="@escenarios.Count"
                                class="rounded-xl border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold transition hover:bg-white/10">
                            Ver más escenarios
                        </button>
                    </div>
                }
            </section>


            <!-- ================= NUEVOS EN SPORTIA ================= -->

            @if (escenariosNuevos.Any())
            {
                <section>
                    <div class="flex items-center justify-between">
                        <h2 class="flex items-center gap-2 text-lg font-bold">
                            <svg class="h-5 w-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="m12 2 3 6.6 7.2.8-5.4 4.9 1.5 7.1L12 17.8 5.7 21.4l1.5-7.1L1.8 9.4 9 8.6z" /></svg>
                            Nuevos en Sportia
                        </h2>
                        <a href="#escenarios" class="text-sm font-semibold text-emerald-400 hover:text-emerald-300">Ver más →</a>
                    </div>
                    <div class="mt-4 grid gap-4 sm:grid-cols-3">
                        @foreach (var nuevo in escenariosNuevos)
                        {
                            string imgNuevo = !string.IsNullOrWhiteSpace(nuevo.Imagen) ? nuevo.Imagen : imagenPorDefecto;

                            <a asp-controller="Cliente" asp-action="Reservar" asp-route-idEscenario="@nuevo.IdEscenario"
                               class="group relative block h-32 overflow-hidden rounded-2xl border border-white/10">
                                <img src="@imgNuevo" alt="@nuevo.Nombre" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-110">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
                                <div class="absolute bottom-3 left-4 right-4">
                                    <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">@(nuevo.IdTipoNavigation?.Nombre ?? "Deporte")</p>
                                    <p class="truncate font-bold">@nuevo.Nombre</p>
                                </div>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>


        <!-- =====================================================
             COLUMNA DERECHA: ACTIVIDAD Y AYUDA
        ====================================================== -->

        <aside class="min-w-0 space-y-6 lg:col-start-2 xl:col-start-auto">

            <section id="reservas" class="scroll-mt-24 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/60">
                <div class="flex items-center justify-between border-b border-white/10 p-4">
                    <h2 class="flex items-center gap-2 font-bold">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        </span>
                        Mi actividad
                    </h2>
                    <a asp-controller="Reservas" asp-action="Mias" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">Ver todas →</a>
                </div>

                <div class="p-5">
                    @if (totalReservas == 0)
                    {
                        <div class="py-4 text-center">
                            <svg class="mx-auto h-10 w-10 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" /></svg>
                            <h3 class="mt-3 font-bold">Aún no tienes reservas</h3>
                            <p class="mt-1 text-sm text-slate-400">¡Reserva tu primer escenario y comienza a disfrutar!</p>
                            <a href="#escenarios" class="mt-4 inline-flex rounded-xl bg-emerald-500 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-400">
                                Buscar escenario
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 gap-3 text-center">
                            <div class="rounded-xl bg-white/[0.04] p-3">
                                <p class="text-2xl font-black">@totalReservas</p>
                                <p class="text-xs text-slate-400">Registradas</p>
                            </div>
                            <div class="rounded-xl bg-emerald-500/10 p-3">
                                <p class="text-2xl font-black text-emerald-400">@reservasProximas</p>
                                <p class="text-xs text-slate-400">Próximas</p>
                            </div>
                        </div>
                        <a asp-controller="Reservas" asp-action="Mias"
                           class="mt-4 flex items-center justify-center gap-2 rounded-xl border border-white/10 py-2.5 text-sm font-semibold transition hover:border-emerald-500/50">
                            Ver el detalle de mis reservas →
                        </a>
                    }
                </div>
            </section>

            <section id="ayuda" class="scroll-mt-24 rounded-2xl border border-white/10 bg-gradient-to-br from-emerald-500/10 to-transparent p-5">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><path d="m4.9 4.9 4.3 4.3M14.8 14.8l4.3 4.3M14.8 9.2l4.3-4.3M4.9 19.1l4.3-4.3" /></svg>
                    </span>
                    <h2 class="font-bold">¿Necesitas ayuda?</h2>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-slate-400">
                    Si tienes problemas para realizar una reserva o necesitas información sobre nuestros escenarios,
                    estamos aquí para ayudarte.
                </p>
                <a asp-controller="Contacto" asp-action="Index"
                   class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 py-3 text-sm font-semibold transition hover:bg-white/10">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1v-7h3zM3 19a2 2 0 0 0 2 2h1v-7H3z" /></svg>
                    Contactar soporte
                </a>
            </section>
        </aside>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="flex flex-col items-center justify-between gap-3 border-t border-white/10 pb-8 pt-6 sm:flex-row lg:col-span-2 xl:col-span-3">
            <p class="text-xs text-slate-500">© 2026 Sportia · Gestión de escenarios deportivos</p>
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Plataforma funcionando correctamente
            </div>
        </footer>
    </main>


    <style>
        @@keyframes clienteKenBurns {
            0% { transform: scale(1) translate(0, 0); }
            100% { transform: scale(1.12) translate(-2%, -2%); }
        }

        .cliente-kenburns {
            animation: clienteKenBurns 18s ease-in-out infinite alternate;
        }

        @@media (prefers-reduced-motion: reduce) {
            .cliente-kenburns { animation: none; }
        }
    </style>


    <script>
        (function () {
            const CARDS_POR_PAGINA = 6;
            const btnVerMas = document.getElementById('btnVerMasEscenarios');
            const buscador = document.getElementById('buscadorEscenarios');
            const tarjetas = () => document.querySelectorAll('#gridEscenarios .escenario-card');
            const sinResultados = document.getElementById('sinResultadosEscenarios');
            let filtroCategoria = '';

            // ---------- Favoritos (se guardan en este navegador) ----------
            const CLAVE_FAV = 'sportia_favoritos';
            let favoritos = [];
            try { favoritos = JSON.parse(localStorage.getItem(CLAVE_FAV) || '[]'); } catch (e) { favoritos = []; }

            function pintarFavoritos() {
                document.querySelectorAll('.btn-favorito').forEach(btn => {
                    const activo = favoritos.includes(btn.dataset.id);
                    btn.setAttribute('aria-pressed', activo);
                    btn.classList.toggle('text-red-400', activo);
                    btn.querySelector('svg').setAttribute('fill', activo ? 'currentColor' : 'none');
                });
            }

            document.querySelectorAll('.btn-favorito').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    favoritos = favoritos.includes(id) ? favoritos.filter(f => f !== id) : favoritos.concat(id);
                    try { localStorage.setItem(CLAVE_FAV, JSON.stringify(favoritos)); } catch (e) { }
                    pintarFavoritos();
                    if (filtroCategoria === '__favoritos') aplicarFiltros();
                });
            });

            // ---------- Filtro combinado: texto + categoría + paginación ----------
            function aplicarFiltros() {
                const texto = (buscador?.value || '').trim().toLowerCase();
                const filtrando = texto.length > 0 || filtroCategoria !== '';
                const mostrados = parseInt(btnVerMas?.dataset.mostrados || '6', 10);
                let visibles = 0;

                tarjetas().forEach((card, i) => {
                    let ok;
                    if (!filtrando) {
                        ok = i < mostrados;
                    } else {
                        const nombre = card.getAttribute('data-nombre') || '';
                        const coincideTexto = nombre.includes(texto);
                        const coincideCategoria =
                            filtroCategoria === '' ||
                            (filtroCategoria === '__favoritos'
                                ? favoritos.includes(card.dataset.idEscenario)
                                : card.dataset.categoria === filtroCategoria);
                        ok = coincideTexto && coincideCategoria;
                    }
                    card.style.display = ok ? '' : 'none';
                    if (ok) visibles++;
                });

                sinResultados?.classList.toggle('hidden', visibles > 0 || tarjetas().length === 0);

                if (btnVerMas) {
                    btnVerMas.style.display = filtrando ? 'none' : (
                        parseInt(btnVerMas.dataset.mostrados, 10) >= parseInt(btnVerMas.dataset.total, 10) ? 'none' : ''
                    );
                }
            }

            buscador?.addEventListener('input', aplicarFiltros);

            btnVerMas?.addEventListener('click', function () {
                const total = parseInt(this.dataset.total, 10);
                this.dataset.mostrados = Math.min(parseInt(this.dataset.mostrados, 10) + CARDS_POR_PAGINA, total);
                aplicarFiltros();
            });

            // ---------- Botón Filtros y chips de categoría ----------
            const panelFiltros = document.getElementById('panelFiltros');
            const btnFiltros = document.getElementById('btnFiltros');

            function abrirFiltros(abrir) {
                panelFiltros.classList.toggle('hidden', !abrir);
                panelFiltros.classList.toggle('flex', abrir);
                btnFiltros.setAttribute('aria-expanded', abrir);
            }

            btnFiltros?.addEventListener('click', () => abrirFiltros(panelFiltros.classList.contains('hidden')));

            function elegirFiltro(valor) {
                filtroCategoria = valor;
                document.querySelectorAll('.filtro-categoria').forEach(b => {
                    const activo = b.dataset.filtro === valor;
                    b.className = 'filtro-categoria rounded-full px-4 py-2 text-xs font-bold ' +
                        (activo ? 'bg-emerald-500 text-white' : 'border border-white/10 bg-white/[0.04] text-slate-300 hover:text-white');
                });
                aplicarFiltros();
            }

            document.querySelectorAll('.filtro-categoria').forEach(b =>
                b.addEventListener('click', () => elegirFiltro(b.dataset.filtro)));

            // "Favoritos" del menú lateral
            document.getElementById('btnFavoritosLateral')?.addEventListener('click', () => {
                abrirFiltros(true);
                elegirFiltro('__favoritos');
                document.getElementById('escenarios').scrollIntoView({ behavior: 'smooth' });
            });

            pintarFavoritos();
        })();
    </script>

</div>
