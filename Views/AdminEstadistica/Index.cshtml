@model Sportia.Models.ViewModels.EstadisticasViewModel
@using System.Globalization
@using System.Text

@{
    ViewData["Title"] = "Estadísticas";
    Layout = "_DashboardLayout";

    var co = new CultureInfo("es-CO");
    string Dinero(decimal v) => "$" + v.ToString("N0", co);

    string ColorAvatar(string nombre)
    {
        string[] colores = { "#14b88a", "#7c4dff", "#2f6fed", "#f59e0b", "#e8508a", "#0ea5a5" };
        int h = 0;
        foreach (char c in nombre) h = (h * 31 + c) & 0x7fffffff;
        return colores[h % colores.Length];
    }

    string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        return (partes[0][..1] + (partes.Length > 1 ? partes[1][..1] : "")).ToUpper();
    }

    // Donut del estado financiero
    double fraccionIngresos = Model.TotalFinanciero == 0 ? 0 : (double)(Model.Ingresos / Model.TotalFinanciero);
    int pctIngresos = (int)Math.Round(fraccionIngresos * 100);
    int pctPendiente = Model.TotalFinanciero == 0 ? 0 : 100 - pctIngresos;

    string[] coloresBarras = { "#22d39a", "#2f80ed", "#8b5cf6", "#f59e0b", "#e8508a" };
}

@functions {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static string N(double v) => v.ToString("0.#", Inv);

    // Curva suave que pasa por todos los puntos (Catmull-Rom convertido a Bézier)
    private static string Curva(List<(double x, double y)> p)
    {
        if (p.Count == 0) return "";
        var sb = new StringBuilder($"M{N(p[0].x)},{N(p[0].y)}");
        for (int i = 0; i < p.Count - 1; i++)
        {
            var p0 = i > 0 ? p[i - 1] : p[i];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = i + 2 < p.Count ? p[i + 2] : p2;
            double c1x = p1.x + (p2.x - p0.x) / 6, c1y = p1.y + (p2.y - p0.y) / 6;
            double c2x = p2.x - (p3.x - p1.x) / 6, c2y = p2.y - (p3.y - p1.y) / 6;
            // la curva no se sale de los puntos (no baja de cero ni hace picos falsos)
            double bajo = Math.Min(p1.y, p2.y), alto = Math.Max(p1.y, p2.y);
            c1y = Math.Clamp(c1y, bajo, alto);
            c2y = Math.Clamp(c2y, bajo, alto);
            sb.Append($" C{N(c1x)},{N(c1y)} {N(c2x)},{N(c2y)} {N(p2.x)},{N(p2.y)}");
        }
        return sb.ToString();
    }

    // Mini gráfica de las tarjetas
    private Microsoft.AspNetCore.Html.IHtmlContent Mini(List<double> serie, string color, string id)
    {
        const double w = 120, h = 54, pad = 5;
        if (serie.Count == 0) serie = new List<double> { 0, 0 };
        double max = serie.Max(), min = serie.Min();
        double rango = max - min == 0 ? 1 : max - min;
        var pts = serie.Select((v, i) => (
            x: serie.Count == 1 ? w / 2 : i * (w - 2) / (serie.Count - 1) + 1,
            y: max == min ? h / 2 : pad + (h - 2 * pad) * (1 - (v - min) / rango))).ToList();
        string linea = Curva(pts);
        var svg = $@"<svg class=""es-mini"" viewBox=""0 0 {N(w)} {N(h)}"" preserveAspectRatio=""none"" aria-hidden=""true"">
<defs><linearGradient id=""{id}"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0"" stop-color=""{color}"" stop-opacity="".35""/><stop offset=""1"" stop-color=""{color}"" stop-opacity=""0""/></linearGradient></defs>
<path d=""{linea} L{N(pts[^1].x)},{N(h)} L{N(pts[0].x)},{N(h)} Z"" fill=""url(#{id})""/>
<path d=""{linea}"" fill=""none"" stroke=""{color}"" stroke-width=""2.4"" stroke-linecap=""round"" vector-effect=""non-scaling-stroke""/></svg>";
        return new Microsoft.AspNetCore.Html.HtmlString(svg);
    }

    // Gráfica grande de actividad de reservas
    private Microsoft.AspNetCore.Html.IHtmlContent Actividad(List<Sportia.Models.ViewModels.PuntoGrafica> datos)
    {
        const double w = 760, h = 210, izq = 34, der = 14, arriba = 12, abajo = 30;
        double ancho = w - izq - der, alto = h - arriba - abajo;

        double maxDato = datos.Count == 0 ? 0 : datos.Max(d => d.Valor);
        int paso = maxDato <= 5 ? 1 : maxDato <= 10 ? 2 : maxDato <= 25 ? 5 : (int)Math.Ceiling(maxDato / 5 / 5) * 5;
        double maxEje = Math.Max(paso * 5, Math.Ceiling(maxDato / paso) * paso);
        if (maxEje == 0) maxEje = 5;

        double X(int i) => datos.Count <= 1 ? izq + ancho / 2 : izq + i * ancho / (datos.Count - 1);
        double Y(double v) => arriba + alto * (1 - v / maxEje);

        var sb = new StringBuilder();
        sb.Append($@"<svg class=""es-grafica"" viewBox=""0 0 {N(w)} {N(h)}"" role=""img"" aria-label=""Reservas por día"">");
        sb.Append(@"<defs><linearGradient id=""esArea"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0"" stop-color=""#22d39a"" stop-opacity="".32""/><stop offset=""1"" stop-color=""#22d39a"" stop-opacity=""0""/></linearGradient></defs>");

        // líneas guía y números del eje Y
        for (double v = 0; v <= maxEje + 0.001; v += paso)
        {
            double y = Y(v);
            sb.Append($@"<line x1=""{N(izq)}"" y1=""{N(y)}"" x2=""{N(w - der)}"" y2=""{N(y)}"" stroke=""#1c2a40"" stroke-dasharray=""{(v == 0 ? "0" : "3 4")}""/>");
            sb.Append($@"<text x=""{N(izq - 10)}"" y=""{N(y + 4)}"" text-anchor=""end"" class=""es-eje"">{N(v)}</text>");
        }

        // etiquetas del eje X (si son muchos días, se saltan algunas)
        int salto = datos.Count <= 8 ? 1 : datos.Count <= 15 ? 2 : 5;
        for (int i = 0; i < datos.Count; i++)
        {
            if (i % salto != 0 && i != datos.Count - 1) continue;
            sb.Append($@"<line x1=""{N(X(i))}"" y1=""{N(arriba)}"" x2=""{N(X(i))}"" y2=""{N(arriba + alto)}"" stroke=""#16233a""/>");
            sb.Append($@"<text x=""{N(X(i))}"" y=""{N(h - 8)}"" text-anchor=""middle"" class=""es-eje"">{System.Net.WebUtility.HtmlEncode(datos[i].Etiqueta)}</text>");
        }

        var pts = datos.Select((d, i) => (x: X(i), y: Y(d.Valor))).ToList();
        if (pts.Count > 0)
        {
            string linea = Curva(pts);
            sb.Append($@"<path d=""{linea} L{N(pts[^1].x)},{N(arriba + alto)} L{N(pts[0].x)},{N(arriba + alto)} Z"" fill=""url(#esArea)""/>");
            sb.Append($@"<path d=""{linea}"" fill=""none"" stroke=""#22d39a"" stroke-width=""3"" stroke-linecap=""round""/>");
            for (int i = 0; i < pts.Count; i++)
            {
                bool ultimo = i == pts.Count - 1;
                sb.Append($@"<circle cx=""{N(pts[i].x)}"" cy=""{N(pts[i].y)}"" r=""{(ultimo ? "6" : datos.Count > 14 ? "3" : "4.5")}"" fill=""#22d39a"" stroke=""#0b1424"" stroke-width=""{(ultimo ? "3" : "2")}""><title>{System.Net.WebUtility.HtmlEncode(datos[i].Etiqueta)}: {N(datos[i].Valor)} reserva(s)</title></circle>");
            }
        }

        sb.Append("</svg>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    private Microsoft.AspNetCore.Html.IHtmlContent Variacion(double? v, string texto)
    {
        if (v == null) return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"es-var sube\">Nuevo en este período</span>");
        bool sube = v >= 0;
        string flecha = sube ? "M12 19V5M5 12l7-7 7 7" : "M12 5v14M5 12l7 7 7-7";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"es-var {(sube ? "sube" : "baja")}\"><svg viewBox=\"0 0 24 24\"><path d=\"{flecha}\"/></svg>{(sube ? "+" : "-")}{Math.Abs(v.Value):0}% {texto}</span>");
    }
}

<style>
    .es {
        --es-card: #0f1a2c;
        --es-borde: #1e2c44;
        --es-borde-2: #263650;
        --es-texto: #eef3fa;
        --es-suave: #a3b0c4;
        --es-tenue: #6b7a92;
        --es-verde: #22d39a;
        --es-rojo: #f05d6c;
        width: 100%;
        color: var(--es-texto);
    }
    .es *, .es *::before, .es *::after { box-sizing: border-box; }
    .es svg { flex-shrink: 0; }

    /* ---------- Encabezado ---------- */
    .es-cab { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
    .es-cab-izq { display: flex; align-items: center; gap: 22px; }
    .es-cab-icono {
        width: 66px; height: 66px; border-radius: 16px; display: grid; place-items: center;
        background: linear-gradient(145deg, #1a3d36, #0f2a26); border: 1px solid rgba(34, 211, 154, .4); color: var(--es-verde);
    }
    .es-cab-icono svg { width: 34px; height: 34px; }
    .es-cab h1 { margin: 0; font-size: 32px; line-height: 1.1; font-weight: 800; letter-spacing: -.5px; color: #fff; }
    .es-cab p { margin: 6px 0 0; font-size: 15px; color: var(--es-suave); }

    .es-sel { position: relative; }
    .es-sel-caja {
        display: flex; align-items: center; gap: 12px; height: 50px; padding: 0 18px; min-width: 210px;
        background: var(--es-card); border: 1px solid var(--es-borde-2); border-radius: 12px;
        font-size: 15px; color: var(--es-texto);
    }
    .es-sel-caja.chica { height: 40px; min-width: 0; padding: 0 14px; font-size: 13px; border-radius: 10px; background: #0c1627; }
    .es-sel-caja svg { width: 18px; height: 18px; color: var(--es-suave); }
    .es-sel-caja span { flex: 1; white-space: nowrap; }
    .es-sel select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .es-sel select option { background: #0f1a2c; color: #eef3fa; }

    /* ---------- Tarjetas ---------- */
    .es-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-bottom: 22px; }
    .es-kpi {
        --c: #22d39a;
        position: relative; overflow: hidden;
        display: flex; gap: 16px; padding: 20px 18px 18px 20px; min-width: 0;
        border-radius: 16px; border: 1px solid color-mix(in srgb, var(--c) 30%, var(--es-borde));
        background: linear-gradient(150deg, color-mix(in srgb, var(--c) 16%, #0f1a2c), #0d1726 70%);
    }
    .es-kpi-icono {
        width: 52px; height: 52px; border-radius: 13px; display: grid; place-items: center;
        background: color-mix(in srgb, var(--c) 22%, #0f1a2c); border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); color: var(--c);
    }
    .es-kpi-icono svg { width: 28px; height: 28px; }
    .es-kpi-cuerpo { flex: 1; min-width: 0; }
    .es-kpi-label { font-size: 13px; font-weight: 600; letter-spacing: .4px; text-transform: uppercase; color: #dfe6f1; }
    .es-kpi-num { margin-top: 6px; font-size: 32px; font-weight: 800; line-height: 1.1; color: #fff; }
    .es-kpi-pie { margin-top: 8px; font-size: 12px; white-space: nowrap; }
    .es-kpi .es-mini { position: absolute; right: 14px; top: 30px; width: 40%; max-width: 120px; height: 54px; }
    .es-kpi.verde { --c: #22d39a; }
    .es-kpi.morado { --c: #8b5cf6; }
    .es-kpi.ambar { --c: #f59e0b; }
    .es-kpi.azul { --c: #3b82f6; }
    .es-var { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
    .es-var svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .es-var.sube { color: var(--es-verde); }
    .es-var.baja { color: #ff8b97; }
    .es-var.neutro { color: var(--es-suave); font-weight: 500; }

    /* ---------- Paneles ---------- */
    .es-fila { display: grid; gap: 20px; margin-bottom: 20px; }
    .es-fila.uno { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); }
    .es-fila.dos { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
    .es-panel { background: var(--es-card); border: 1px solid var(--es-borde); border-radius: 18px; padding: 18px 20px 20px; min-width: 0; }
    .es-panel-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .es-panel-titulo { display: flex; align-items: center; gap: 14px; }
    .es-panel-icono { width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; background: #13342e; border: 1px solid rgba(34, 211, 154, .3); color: var(--es-verde); }
    .es-panel-icono svg { width: 22px; height: 22px; }
    .es-panel h2 { margin: 0; font-size: 17px; font-weight: 800; color: #fff; }
    .es-panel-cab p { margin: 3px 0 0; font-size: 12px; color: var(--es-suave); }

    .es-grafica { width: 100%; height: auto; display: block; }
    .es-eje { fill: #8996ab; font-size: 11px; font-family: inherit; }
    .es-sin-datos { padding: 40px 0; text-align: center; font-size: 13px; color: var(--es-tenue); }

    /* Donut */
    .es-financiero { display: flex; align-items: center; gap: 28px; padding: 6px 4px 0; }
    .es-donut { position: relative; width: 200px; height: 200px; flex-shrink: 0; }
    .es-donut > svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .es-donut-centro { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; }
    .es-donut-centro small { font-size: 13px; color: var(--es-suave); }
    .es-donut-centro b { display: block; margin: 4px 0; font-size: 18px; font-weight: 800; color: #fff; }
    .es-leyenda { flex: 1; display: grid; gap: 4px; min-width: 0; }
    .es-leyenda-item { padding: 12px 0; border-bottom: 1px solid var(--es-borde); }
    .es-leyenda-item:last-child { border-bottom: 0; }
    .es-leyenda-nombre { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #e6ecf5; }
    .es-punto { width: 11px; height: 11px; border-radius: 50%; }
    .es-leyenda-valor { display: flex; justify-content: space-between; gap: 10px; margin-top: 6px; padding-left: 21px; font-size: 15px; font-weight: 700; color: #fff; }
    .es-leyenda-valor span { font-weight: 500; color: var(--es-suave); }

    /* Barras por escenario */
    .es-barras { display: grid; gap: 16px; padding-top: 6px; }
    .es-barra { display: grid; grid-template-columns: minmax(110px, 1.2fr) 28px minmax(0, 2.6fr) 44px; align-items: center; gap: 14px; font-size: 13px; }
    .es-barra-nombre { color: #e6ecf5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .es-barra-num { text-align: right; color: #e6ecf5; font-variant-numeric: tabular-nums; }
    .es-barra-fondo { height: 14px; border-radius: 99px; background: #18253a; overflow: hidden; }
    .es-barra-relleno { height: 100%; border-radius: 99px; }
    .es-barra-pct { text-align: right; color: #e6ecf5; font-variant-numeric: tabular-nums; }

    /* Pagos recientes */
    .es-ver-todos { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px; border-radius: 9px; border: 1px solid var(--es-borde-2); color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .es-ver-todos:hover { border-color: var(--es-verde); color: var(--es-verde); }
    .es-ver-todos svg { width: 15px; height: 15px; }
    .es-tabla-wrap { overflow-x: auto; margin: 0 -6px; }
    .es-tabla { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 13px; }
    .es-tabla th { padding: 8px 6px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #9aa7bb; background: #0c1627; }
    .es-tabla td { padding: 9px 6px; border-bottom: 1px solid #18253a; color: #c9d3e2; white-space: nowrap; }
    .es-tabla tr:last-child td { border-bottom: 0; }
    .es-tabla .es-persona { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 600; }
    .es-avatar { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 11px; font-weight: 700; }
    .es-monto { color: #fff; font-weight: 600; }
    .es-chip { display: inline-block; padding: 4px 10px; border-radius: 7px; font-size: 12px; font-weight: 600; }
    .es-chip.pagado { background: rgba(34, 211, 154, .14); color: var(--es-verde); }
    .es-chip.pendiente { background: rgba(240, 93, 108, .18); color: #ff8b97; }
    .es-chip.cancelada { background: rgba(163, 176, 196, .14); color: var(--es-suave); }

    @@media (max-width: 1280px) {
        .es-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .es-fila.uno, .es-fila.dos { grid-template-columns: 1fr; }
    }
    @@media (max-width: 760px) {
        .es-cab { flex-direction: column; align-items: flex-start; }
        .es-kpis { grid-template-columns: 1fr; }
        .es-financiero { flex-direction: column; }
        .es-leyenda { width: 100%; }
        .es-barra { grid-template-columns: minmax(90px, 1fr) 24px minmax(0, 1.6fr) 40px; gap: 10px; }
    }
</style>

<div class="es">

    <!-- ===================== ENCABEZADO ===================== -->
    <div class="es-cab">
        <div class="es-cab-izq">
            <div class="es-cab-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M6 17v-4M10 17V9M14 17v-6M18 17V6" /><path d="M4 10l5-5 4 3 7-6M16 2h4v4" /></svg>
            </div>
            <div>
                <h1>Estadísticas</h1>
                <p>Analiza el rendimiento general de Sportia y toma mejores decisiones.</p>
            </div>
        </div>

        <form method="get" asp-action="Index" class="es-sel">
            <input type="hidden" name="actividad" value="@Model.DiasActividad" />
            <div class="es-sel-caja">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M16 2.5v4M8 2.5v4M3 10h18" /></svg>
                <span>@Model.TextoPeriodo</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            </div>
            <select name="dias" aria-label="Período" onchange="this.form.submit()">
                <option value="7" selected="@(Model.Dias == 7)">Últimos 7 días</option>
                <option value="30" selected="@(Model.Dias == 30)">Últimos 30 días</option>
                <option value="90" selected="@(Model.Dias == 90)">Últimos 90 días</option>
                <option value="365" selected="@(Model.Dias == 365)">Último año</option>
                <option value="0" selected="@(Model.Dias == 0)">Todo el tiempo</option>
            </select>
        </form>
    </div>

    <!-- ===================== TARJETAS ===================== -->
    <section class="es-kpis">
        <div class="es-kpi verde">
            <div class="es-kpi-icono">
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="8" r="3.6" /><path d="M2.5 19.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6v.5h-13z" /><circle cx="17" cy="9" r="2.8" opacity=".75" /><path d="M16.6 13.6c2.9.2 5 2.2 5 5.2v1.2h-4.4v-.5c0-2.3-.8-4.3-2.2-5.6.5-.2 1-.3 1.6-.3z" opacity=".75" /></svg>
            </div>
            <div class="es-kpi-cuerpo">
                <div class="es-kpi-label">Clientes</div>
                <div class="es-kpi-num">@Model.Clientes</div>
                <div class="es-kpi-pie">@Variacion(Model.VariacionClientes, "vs. período anterior")</div>
            </div>
            @Mini(Model.SerieClientes, "#22d39a", "esMini1")
        </div>

        <div class="es-kpi morado">
            <div class="es-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V5.5L12 3v18M12 8.5l8 2.5v10M2.5 21h19" /><path d="M7 8h2M7 11.5h2M7 15h2M15 13.5h2M15 17h2" /></svg>
            </div>
            <div class="es-kpi-cuerpo">
                <div class="es-kpi-label">Empresas</div>
                <div class="es-kpi-num">@Model.Empresas</div>
                <div class="es-kpi-pie"><span class="es-var neutro">@Model.EmpresasActivas activa@(Model.EmpresasActivas == 1 ? "" : "s")</span></div>
            </div>
            @Mini(Model.SerieEmpresas, "#8b5cf6", "esMini2")
        </div>

        <div class="es-kpi ambar">
            <div class="es-kpi-icono">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 3h10v5a5 5 0 0 1-10 0z" /><path d="M7 4.5H4v1.5a3.5 3.5 0 0 0 3.5 3.5M17 4.5h3v1.5A3.5 3.5 0 0 1 16.5 9.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M11 13h2v3.5h-2z" /><path d="M8 20.5c0-2 1.8-3.5 4-3.5s4 1.5 4 3.5z" /></svg>
            </div>
            <div class="es-kpi-cuerpo">
                <div class="es-kpi-label">Escenarios</div>
                <div class="es-kpi-num">@Model.Escenarios</div>
                <div class="es-kpi-pie"><span class="es-var neutro">@Model.EscenariosActivos activo@(Model.EscenariosActivos == 1 ? "" : "s")</span></div>
            </div>
            @Mini(Model.SerieEscenarios, "#f59e0b", "esMini3")
        </div>

        <div class="es-kpi azul">
            <div class="es-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M16 2.5v4M8 2.5v4M3 10h18" /><path d="M9 15l2 2 4-4" /></svg>
            </div>
            <div class="es-kpi-cuerpo">
                <div class="es-kpi-label">Reservas</div>
                <div class="es-kpi-num">@Model.Reservas</div>
                <div class="es-kpi-pie">
                    @if (Model.Dias == 0)
                    {
                        <span class="es-var neutro">En todo el tiempo</span>
                    }
                    else
                    {
                        @Variacion(Model.VariacionReservas, "vs. período anterior")
                    }
                </div>
            </div>
            @Mini(Model.SerieReservas, "#3b82f6", "esMini4")
        </div>
    </section>

    <!-- ===================== ACTIVIDAD + FINANCIERO ===================== -->
    <section class="es-fila uno">
        <div class="es-panel">
            <div class="es-panel-cab">
                <div class="es-panel-titulo">
                    <div class="es-panel-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 19.5c.6-3.3 3.1-5.3 6.5-5.3s5.9 2 6.5 5.3" /><path d="M15 11l2.5 2.5L22 9" /></svg>
                    </div>
                    <div>
                        <h2>Actividad de reservas</h2>
                        <p>Reservas hechas cada día</p>
                    </div>
                </div>
                <form method="get" asp-action="Index" class="es-sel">
                    <input type="hidden" name="dias" value="@Model.Dias" />
                    <div class="es-sel-caja chica">
                        <span>Últimos @Model.DiasActividad días</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                    </div>
                    <select name="actividad" aria-label="Días de la gráfica" onchange="this.form.submit()">
                        <option value="7" selected="@(Model.DiasActividad == 7)">Últimos 7 días</option>
                        <option value="14" selected="@(Model.DiasActividad == 14)">Últimos 14 días</option>
                        <option value="30" selected="@(Model.DiasActividad == 30)">Últimos 30 días</option>
                    </select>
                </form>
            </div>
            @Actividad(Model.Actividad)
        </div>

        <div class="es-panel">
            <div class="es-panel-cab">
                <div class="es-panel-titulo">
                    <div class="es-panel-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5V18a2 2 0 0 0 2 2h13V7.5H6A2 2 0 0 1 4 5.5v0A2 2 0 0 1 6 3.5h11v4" /><circle cx="16" cy="14" r="1.4" /></svg>
                    </div>
                    <div>
                        <h2>Estado financiero</h2>
                        <p>Distribución de los pagos (@Model.TextoPeriodo.ToLower())</p>
                    </div>
                </div>
            </div>

            <div class="es-financiero">
                <div class="es-donut">
                    <svg viewBox="0 0 120 120" aria-hidden="true">
                        <circle cx="60" cy="60" r="50" fill="none" stroke="@(Model.TotalFinanciero == 0 ? "#1c2a40" : "#f05d6c")" stroke-width="13" />
                        @if (fraccionIngresos > 0)
                        {
                            var largo = 2 * Math.PI * 50;
                            <circle cx="60" cy="60" r="50" fill="none" stroke="#22d39a" stroke-width="13"
                                    stroke-dasharray="@((largo * fraccionIngresos).ToString("0.##", CultureInfo.InvariantCulture)) @largo.ToString("0.##", CultureInfo.InvariantCulture)"
                                    stroke-linecap="@(fraccionIngresos >= 1 ? "butt" : "round")" />
                        }
                    </svg>
                    <div class="es-donut-centro">
                        <small>Total</small>
                        <b>@Dinero(Model.TotalFinanciero)</b>
                        @if (Model.Dias != 0)
                        {
                            @Variacion(Model.VariacionIngresos, "")
                        }
                    </div>
                </div>

                <div class="es-leyenda">
                    <div class="es-leyenda-item">
                        <div class="es-leyenda-nombre"><span class="es-punto" style="background:#22d39a"></span>Ingresos</div>
                        <div class="es-leyenda-valor">@Dinero(Model.Ingresos)<span>@pctIngresos%</span></div>
                    </div>
                    <div class="es-leyenda-item">
                        <div class="es-leyenda-nombre"><span class="es-punto" style="background:#f05d6c"></span>Pendiente</div>
                        <div class="es-leyenda-valor">@Dinero(Model.Pendiente)<span>@pctPendiente%</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== ESCENARIOS + PAGOS RECIENTES ===================== -->
    <section class="es-fila dos">
        <div class="es-panel">
            <div class="es-panel-cab">
                <div class="es-panel-titulo">
                    <div class="es-panel-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M16 2.5v4M8 2.5v4M3 10h18M8 14h3M8 17.5h6" /></svg>
                    </div>
                    <div>
                        <h2>Reservas por escenario</h2>
                        <p>Total de reservas en cada escenario (@Model.TextoPeriodo.ToLower())</p>
                    </div>
                </div>
            </div>

            @if (Model.PorEscenario.Any())
            {
                <div class="es-barras">
                    @for (int i = 0; i < Model.PorEscenario.Count; i++)
                    {
                        var b = Model.PorEscenario[i];
                        int ancho = Math.Max(3, b.Porcentaje);
                        <div class="es-barra">
                            <span class="es-barra-nombre" title="@b.Nombre">@b.Nombre</span>
                            <span class="es-barra-num">@b.Cantidad</span>
                            <div class="es-barra-fondo"><div class="es-barra-relleno" style="width:@ancho%;background:@coloresBarras[i % coloresBarras.Length]"></div></div>
                            <span class="es-barra-pct">@b.Porcentaje%</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="es-sin-datos">No hay reservas en este período.</div>
            }
        </div>

        <div class="es-panel">
            <div class="es-panel-cab">
                <div class="es-panel-titulo">
                    <div class="es-panel-icono">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5" /><path d="M2.5 10h19M6.5 15h5" /></svg>
                    </div>
                    <div>
                        <h2>Pagos recientes</h2>
                        <p>Últimos pagos registrados en el sistema</p>
                    </div>
                </div>
                <a asp-controller="AdminPago" asp-action="Index" class="es-ver-todos">
                    Ver todos
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
            </div>

            @if (Model.PagosRecientes.Any())
            {
                <div class="es-tabla-wrap">
                    <table class="es-tabla">
                        <thead>
                            <tr><th>Cliente</th><th>Escenario</th><th>Monto</th><th>Fecha</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.PagosRecientes)
                            {
                                <tr>
                                    <td><span class="es-persona"><span class="es-avatar" style="background:@ColorAvatar(p.Cliente)">@Iniciales(p.Cliente)</span>@p.Cliente</span></td>
                                    <td>@p.Escenario</td>
                                    <td class="es-monto">@Dinero(p.Monto)</td>
                                    <td>@(p.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td><span class="es-chip @p.Estado.ToLower()">@p.Estado</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="es-sin-datos">Todavía no hay pagos registrados.</div>
            }
        </div>
    </section>
</div>
