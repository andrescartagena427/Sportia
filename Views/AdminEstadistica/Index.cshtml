@{
    ViewData["Title"] = "Estadísticas";
    Layout = "_DashboardLayout";
}

<div class="space-y-7">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

        <div class="flex items-center gap-4">

            <div class="flex h-14 w-14 items-center justify-center rounded-2xl
                border border-emerald-500/20
                bg-emerald-500/10
                text-emerald-400">

                <i data-lucide="chart-no-axes-combined"
                   class="h-7 w-7">
                </i>

            </div>

            <div>

                <div class="flex items-center gap-3">

                    <h1 class="text-2xl font-bold tracking-tight text-white">
                        Estadísticas
                    </h1>

                    <span class="rounded-full
                        border border-emerald-500/20
                        bg-emerald-500/10
                        px-3 py-1
                        text-xs font-semibold
                        text-emerald-400">

                        En tiempo real

                    </span>

                </div>

                <p class="mt-1 text-sm text-slate-400">
                    Analiza el rendimiento general de Sportia y toma mejores decisiones.
                </p>

            </div>

        </div>


        <!-- FILTRO -->

        <button type="button"
                class="inline-flex items-center justify-center gap-2
            rounded-xl
            border border-slate-700
            bg-slate-900
            px-4 py-2.5
            text-sm font-medium
            text-slate-300
            transition
            hover:border-slate-600
            hover:bg-slate-800">

            <i data-lucide="calendar"
               class="h-4 w-4">
            </i>

            Últimos 30 días

            <i data-lucide="chevron-down"
               class="h-4 w-4">
            </i>

        </button>

    </div>



    <!-- ===================================================== -->
    <!-- TARJETAS PRINCIPALES -->
    <!-- ===================================================== -->

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">


        <!-- CLIENTES -->

        <div class="group relative overflow-hidden rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-5
            transition-all duration-300
            hover:-translate-y-1
            hover:border-blue-500/30">

            <div class="absolute -right-5 -top-5
                h-24 w-24 rounded-full
                bg-blue-500/5
                blur-2xl">
            </div>


            <div class="relative flex items-start justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Clientes
                    </p>

                    <p class="mt-3 text-3xl font-bold text-white">
                        @ViewBag.TotalClientes
                    </p>

                    <div class="mt-3 flex items-center gap-1 text-xs text-slate-500">

                        <i data-lucide="users"
                           class="h-3.5 w-3.5">
                        </i>

                        Registrados

                    </div>

                </div>


                <div class="flex h-11 w-11 items-center justify-center
                    rounded-xl
                    bg-blue-500/10
                    text-blue-400">

                    <i data-lucide="users"
                       class="h-5 w-5">
                    </i>

                </div>

            </div>

        </div>



        <!-- EMPRESAS -->

        <div class="group relative overflow-hidden rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-5
            transition-all duration-300
            hover:-translate-y-1
            hover:border-purple-500/30">

            <div class="absolute -right-5 -top-5
                h-24 w-24 rounded-full
                bg-purple-500/5
                blur-2xl">
            </div>


            <div class="relative flex items-start justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Empresas
                    </p>

                    <p class="mt-3 text-3xl font-bold text-white">
                        @ViewBag.TotalEmpresas
                    </p>

                    <div class="mt-3 flex items-center gap-1 text-xs text-slate-500">

                        <i data-lucide="building-2"
                           class="h-3.5 w-3.5">
                        </i>

                        Registradas

                    </div>

                </div>


                <div class="flex h-11 w-11 items-center justify-center
                    rounded-xl
                    bg-purple-500/10
                    text-purple-400">

                    <i data-lucide="building-2"
                       class="h-5 w-5">
                    </i>

                </div>

            </div>

        </div>



        <!-- ESCENARIOS -->

        <div class="group relative overflow-hidden rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-5
            transition-all duration-300
            hover:-translate-y-1
            hover:border-orange-500/30">

            <div class="absolute -right-5 -top-5
                h-24 w-24 rounded-full
                bg-orange-500/5
                blur-2xl">
            </div>


            <div class="relative flex items-start justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Escenarios
                    </p>

                    <p class="mt-3 text-3xl font-bold text-white">
                        @ViewBag.TotalEscenarios
                    </p>

                    <div class="mt-3 flex items-center gap-1 text-xs text-slate-500">

                        <i data-lucide="map-pin"
                           class="h-3.5 w-3.5">
                        </i>

                        Disponibles

                    </div>

                </div>


                <div class="flex h-11 w-11 items-center justify-center
                    rounded-xl
                    bg-orange-500/10
                    text-orange-400">

                    <i data-lucide="trophy"
                       class="h-5 w-5">
                    </i>

                </div>

            </div>

        </div>



        <!-- RESERVAS -->

        <div class="group relative overflow-hidden rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-5
            transition-all duration-300
            hover:-translate-y-1
            hover:border-emerald-500/30">

            <div class="absolute -right-5 -top-5
                h-24 w-24 rounded-full
                bg-emerald-500/5
                blur-2xl">
            </div>


            <div class="relative flex items-start justify-between">

                <div>

                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                        Reservas
                    </p>

                    <p class="mt-3 text-3xl font-bold text-emerald-400">
                        @ViewBag.TotalReservas
                    </p>

                    <div class="mt-3 flex items-center gap-1 text-xs text-emerald-400">

                        <i data-lucide="activity"
                           class="h-3.5 w-3.5">
                        </i>

                        Total registradas

                    </div>

                </div>


                <div class="flex h-11 w-11 items-center justify-center
                    rounded-xl
                    bg-emerald-500/10
                    text-emerald-400">

                    <i data-lucide="calendar-check"
                       class="h-5 w-5">
                    </i>

                </div>

            </div>

        </div>

    </div>



    <!-- ===================================================== -->
    <!-- GRAFICAS PRINCIPALES -->
    <!-- ===================================================== -->

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">


        <!-- RESERVAS -->

        <div class="xl:col-span-2 rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-6">

            <div class="flex items-start justify-between">

                <div>

                    <h2 class="text-lg font-bold text-white">
                        Actividad de reservas
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Comportamiento de las reservas durante la semana.
                    </p>

                </div>


                <div class="flex h-10 w-10 items-center justify-center
                    rounded-xl
                    bg-emerald-500/10
                    text-emerald-400">

                    <i data-lucide="trending-up"
                       class="h-5 w-5">
                    </i>

                </div>

            </div>


            <div class="mt-7 h-[340px]">

                <canvas id="reservasChart"></canvas>

            </div>

        </div>



        <!-- ESTADO FINANCIERO -->

        <div class="rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-6">

            <div>

                <h2 class="text-lg font-bold text-white">
                    Estado financiero
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Distribución de pagos registrados.
                </p>

            </div>


            <div class="mt-6 h-[230px]">

                <canvas id="finanzasChart"></canvas>

            </div>


            <div class="mt-5 space-y-4 border-t border-slate-800 pt-5">


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400">
                        </span>

                        <span class="text-sm text-slate-400">
                            Ingresos
                        </span>

                    </div>

                    <span class="font-semibold text-white">
                        $@ViewBag.Ingresos.ToString("N0")
                    </span>

                </div>


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <span class="h-2.5 w-2.5 rounded-full bg-red-400">
                        </span>

                        <span class="text-sm text-slate-400">
                            Pendiente
                        </span>

                    </div>

                    <span class="font-semibold text-white">
                        $@ViewBag.SaldoPendiente.ToString("N0")
                    </span>

                </div>

            </div>

        </div>

    </div>



    <!-- ===================================================== -->
    <!-- SEGUNDA FILA -->
    <!-- ===================================================== -->

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">


        <!-- RESUMEN FINANCIERO -->

        <div class="xl:col-span-2 rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-6">

            <div class="flex items-center justify-between">

                <div>

                    <h2 class="text-lg font-bold text-white">
                        Resumen financiero
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Estado general de los ingresos registrados.
                    </p>

                </div>

                <i data-lucide="wallet"
                   class="h-6 w-6 text-slate-500">
                </i>

            </div>


            <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">


                <!-- INGRESOS -->

                <div class="relative overflow-hidden
                    rounded-2xl
                    border border-emerald-500/20
                    bg-emerald-500/5
                    p-6">

                    <div class="absolute -right-4 -top-4
                        h-24 w-24
                        rounded-full
                        bg-emerald-500/10
                        blur-2xl">
                    </div>


                    <div class="relative">

                        <div class="flex items-center gap-3">

                            <div class="flex h-10 w-10 items-center justify-center
                                rounded-xl
                                bg-emerald-500/10
                                text-emerald-400">

                                <i data-lucide="circle-dollar-sign"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <p class="text-sm font-semibold text-slate-400">
                                Dinero recibido
                            </p>

                        </div>


                        <p class="mt-6 text-3xl font-bold text-emerald-400">

                            $@ViewBag.Ingresos.ToString("N0")

                        </p>

                        <p class="mt-2 text-xs text-slate-500">
                            Pagos registrados en Sportia.
                        </p>

                    </div>

                </div>



                <!-- SALDO -->

                <div class="relative overflow-hidden
                    rounded-2xl
                    border border-red-500/20
                    bg-red-500/5
                    p-6">

                    <div class="absolute -right-4 -top-4
                        h-24 w-24
                        rounded-full
                        bg-red-500/10
                        blur-2xl">
                    </div>


                    <div class="relative">

                        <div class="flex items-center gap-3">

                            <div class="flex h-10 w-10 items-center justify-center
                                rounded-xl
                                bg-red-500/10
                                text-red-400">

                                <i data-lucide="alert-circle"
                                   class="h-5 w-5">
                                </i>

                            </div>

                            <p class="text-sm font-semibold text-slate-400">
                                Saldo pendiente
                            </p>

                        </div>


                        <p class="mt-6 text-3xl font-bold text-red-400">

                            $@ViewBag.SaldoPendiente.ToString("N0")

                        </p>

                        <p class="mt-2 text-xs text-slate-500">
                            Pagos que todavía están pendientes.
                        </p>

                    </div>

                </div>

            </div>

        </div>



        <!-- PANEL DE ACTIVIDAD -->

        <div class="rounded-2xl
            border border-slate-800
            bg-slate-900/70
            p-6">

            <div class="flex items-center justify-between">

                <div>

                    <h2 class="text-lg font-bold text-white">
                        Resumen
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Información general.
                    </p>

                </div>

                <i data-lucide="sparkles"
                   class="h-5 w-5 text-emerald-400">
                </i>

            </div>


            <div class="mt-7 space-y-5">


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center
                            rounded-lg
                            bg-blue-500/10
                            text-blue-400">

                            <i data-lucide="users"
                               class="h-4 w-4">
                            </i>

                        </div>

                        <span class="text-sm text-slate-400">
                            Clientes
                        </span>

                    </div>

                    <span class="font-bold text-white">
                        @ViewBag.TotalClientes
                    </span>

                </div>


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center
                            rounded-lg
                            bg-purple-500/10
                            text-purple-400">

                            <i data-lucide="building-2"
                               class="h-4 w-4">
                            </i>

                        </div>

                        <span class="text-sm text-slate-400">
                            Empresas
                        </span>

                    </div>

                    <span class="font-bold text-white">
                        @ViewBag.TotalEmpresas
                    </span>

                </div>


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center
                            rounded-lg
                            bg-orange-500/10
                            text-orange-400">

                            <i data-lucide="trophy"
                               class="h-4 w-4">
                            </i>

                        </div>

                        <span class="text-sm text-slate-400">
                            Escenarios
                        </span>

                    </div>

                    <span class="font-bold text-white">
                        @ViewBag.TotalEscenarios
                    </span>

                </div>


                <div class="flex items-center justify-between">

                    <div class="flex items-center gap-3">

                        <div class="flex h-9 w-9 items-center justify-center
                            rounded-lg
                            bg-emerald-500/10
                            text-emerald-400">

                            <i data-lucide="calendar-check"
                               class="h-4 w-4">
                            </i>

                        </div>

                        <span class="text-sm text-slate-400">
                            Reservas
                        </span>

                    </div>

                    <span class="font-bold text-white">
                        @ViewBag.TotalReservas
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        // =====================================================
        // RESERVAS
        // =====================================================

        const reservasChart = document.getElementById('reservasChart');

        new Chart(reservasChart, {

            type: 'line',

            data: {

                labels: [
                    'Lunes',
                    'Martes',
                    'Miércoles',
                    'Jueves',
                    'Viernes',
                    'Sábado',
                    'Domingo'
                ],

                datasets: [{

                    label: 'Reservas',

                    data: [
                        4,
                        7,
                        5,
                        8,
                        12,
                        15,
                        10
                    ],

                    borderColor: '#34d399',

                    backgroundColor: 'rgba(52, 211, 153, 0.08)',

                    borderWidth: 3,

                    fill: true,

                    tension: 0.4,

                    pointRadius: 4,

                    pointHoverRadius: 6

                }]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    }

                },


                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {
                            color: '#64748b'
                        }

                    },


                    y: {

                        beginAtZero: true,

                        grid: {
                            color: 'rgba(148,163,184,0.08)'
                        },

                        ticks: {
                            color: '#64748b'
                        }

                    }

                }

            }

        });



        // =====================================================
        // FINANZAS
        // =====================================================

        const finanzasChart = document.getElementById('finanzasChart');

        new Chart(finanzasChart, {

            type: 'doughnut',

            data: {

                labels: [
                    'Ingresos',
                    'Pendiente'
                ],

                datasets: [{

                    data: [

                            @ViewBag.Ingresos,

                        @ViewBag.SaldoPendiente

                    ],

                    backgroundColor: [
                        '#34d399',
                        '#f87171'
                    ],

                    borderWidth: 0,

                    hoverOffset: 8

                }]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: '75%',

                plugins: {

                    legend: {
                        display: false
                    }

                }

            }

        });


        // =====================================================
        // LUCIDE
        // =====================================================

        lucide.createIcons();

    </script>

}