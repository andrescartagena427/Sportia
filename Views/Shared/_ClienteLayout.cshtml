@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Http
@using Sportia.Models

@inject SportiaDbContext _context

@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");

    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Cliente";

    var correoUsuario = Context.Session.GetString("CorreoUsuario") ?? "Sin correo";

    var rolUsuario = Context.Session.GetString("Rol") ?? "Cliente";

    // Obtener la primera letra del nombre real
    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim().Substring(0, 1).ToUpper()
        : "C";

    // Contar reservas del usuario
    var cantidadReservas = idUsuario.HasValue
        ? await _context.Reservas.CountAsync(r => r.IdUsuario == idUsuario.Value)
        : 0;

    // Página actual (para marcar el enlace activo del menú)
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var esPanel = controladorActual == "Cliente" && accionActual == "Index";
    var esContacto = controladorActual == "Contacto";
    var urlPanel = Url.Action("Index", "Cliente");

    string ClaseNav(bool activo) => activo
        ? "text-sm font-semibold text-emerald-400"
        : "text-sm font-medium text-slate-400 hover:text-white transition";

    string ClaseNavMovil(bool activo) => activo
        ? "shrink-0 rounded-full bg-emerald-500/15 px-4 py-2 font-semibold text-emerald-400"
        : "shrink-0 rounded-full border border-white/10 px-4 py-2 text-slate-300 hover:text-white";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sportia</title>


    <!-- =====================================================
         TAILWIND CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/output.css"
          asp-append-version="true" />


    <!-- =====================================================
         GOOGLE FONTS
    ====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         ESTILOS
    ====================================================== -->

    <style>

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: 'Inter', sans-serif;
                background: #020617;
            }

            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                font-family: 'Montserrat', sans-serif;
            }

            /* Scroll */

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #020617;
            }

            ::-webkit-scrollbar-thumb {
                background: #10b981;
                border-radius: 9999px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #34d399;
                }

            /* Selección */

            ::selection {
                background: #10b981;
                color: white;
            }

    </style>

</head>


<body class="min-h-screen bg-slate-950 text-white antialiased">


    <!-- =====================================================
         CONTENIDO DEL CLIENTE
    ====================================================== -->
    <!-- =========================================================
         HEADER DEL CLIENTE
    ========================================================== -->

    <header class="border-b border-white/10 bg-slate-950/90 backdrop-blur-xl sticky top-0 z-50">

        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">

            <div class="h-20 flex items-center justify-between">

                <!-- =================================================
                     LOGO
                ================================================== -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="flex items-center gap-3 group">

                    <div class="w-10 h-10 rounded-xl
                        bg-emerald-500
                        flex items-center justify-center
                        shadow-lg shadow-emerald-500/20
                        group-hover:scale-105 transition">

                        <svg class="w-6 h-6 text-white"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 4v16m8-8H4" />

                        </svg>

                    </div>

                    <div>

                        <span class="block text-xl font-black tracking-tight">
                            SPORTIA
                        </span>

                        <span class="block text-[10px] uppercase
                            tracking-[0.2em]
                            text-slate-500">
                            Sports Booking
                        </span>

                    </div>

                </a>


                <!-- =================================================
                     NAVEGACIÓN
                ================================================== -->

                <nav class="hidden md:flex items-center gap-8" aria-label="Principal">

                    <a href="@urlPanel" class="@ClaseNav(esPanel)">
                        Inicio
                    </a>

                    <a href="@(urlPanel)#escenarios" class="@ClaseNav(false)">
                        Escenarios
                    </a>

                    <a href="@(urlPanel)#reservas" class="@ClaseNav(false)">
                        Mis reservas
                    </a>

                    <a href="@(urlPanel)#ayuda" class="@ClaseNav(false)">
                        Ayuda
                    </a>

                    <a asp-controller="Contacto" asp-action="Index" class="@ClaseNav(esContacto)">
                        Contacto
                    </a>

                </nav>


                <!-- =================================================
                     PERFIL DEL CLIENTE
                ================================================== -->

                <div class="flex items-center gap-3">


                    <!-- NOTIFICACIONES -->

                    <button type="button"
                            class="hidden sm:flex w-10 h-10
                        rounded-xl
                        border border-white/10
                        bg-white/5
                        items-center justify-center
                        text-slate-400
                        hover:text-white
                        hover:bg-white/10
                        transition">

                        <svg class="w-5 h-5"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M15 17h5l-1.5-2A7 7 0 0012 5a7 7 0 00-6.5 10L4 17h5m6 0a3 3 0 11-6 0" />

                        </svg>

                    </button>


                    <!-- =================================================
                         CONTENEDOR DEL PERFIL
                    ================================================== -->

                    <div class="pl-3 border-l border-white/10 relative shrink-0">


                        <!-- BOTÓN DE LA INICIAL -->

                        <button id="clientMenuButton"
                                type="button"
                                onclick="toggleClientMenu()"
                                class="flex items-center gap-3
                            rounded-xl
                            p-1.5
                            hover:bg-white/5
                            transition">


                            <!-- INICIAL REAL -->

                            <div style="
                                width: 40px;
                                height: 40px;
                                min-width: 40px;
                                min-height: 40px;
                                max-width: 40px;
                                max-height: 40px;
                                flex: 0 0 40px;
                                aspect-ratio: 1 / 1;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                overflow: hidden;
                                box-sizing: border-box;
                                background: linear-gradient(135deg, #34d399, #047857);
                                color: white;
                                font-weight: 700;
                                line-height: 1;
                                text-align: center;
                                ">

                                @inicialUsuario

                            </div>


                            <!-- NOMBRE -->

                            <div class="hidden lg:block text-left">

                                <p class="text-sm font-semibold max-w-[160px] truncate">
                                    @nombreUsuario
                                </p>

                                <p class="text-xs text-slate-500">
                                    Cuenta activa
                                </p>

                            </div>


                            <!-- FLECHA -->

                            <svg class="hidden sm:block w-4 h-4 text-slate-500"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M19 9l-7 7-7-7" />

                            </svg>

                        </button>


                        <!-- =================================================
                             MENÚ DEL CLIENTE
                        ================================================== -->

                        <div id="clientMenu"
                             class="hidden
                            fixed
                            right-5
                            top-20
                            w-80
                            rounded-2xl
                            border border-white/10
                            bg-slate-900/95
                            backdrop-blur-xl
                            shadow-2xl
                            shadow-black/40
                            overflow-hidden
                            z-[9999]">


                            <!-- =================================================
                                 INFORMACIÓN DEL USUARIO
                            ================================================== -->

                            <div class="p-5
                                border-b border-white/10
                                bg-gradient-to-br
                                from-emerald-500/10
                                to-transparent">

                                <div class="flex items-center gap-3">


                                    <!-- INICIAL -->

                                    <div class="w-12 h-12
                                        rounded-full
                                        bg-gradient-to-br
                                        from-emerald-400
                                        to-emerald-700
                                        flex items-center
                                        justify-center
                                        font-bold
                                        text-lg">

                                        @inicialUsuario

                                    </div>


                                    <!-- DATOS -->

                                    <div class="min-w-0">

                                        <p class="font-bold truncate">
                                            @nombreUsuario
                                        </p>

                                        <p class="text-xs
                                            text-slate-500
                                            truncate
                                            mt-1">

                                            @correoUsuario

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================================
                                 DATOS DEL CLIENTE
                            ================================================== -->

                            <div class="px-5 py-4
                                border-b border-white/10">


                                <!-- NOMBRE -->

                                <div class="flex items-center justify-between gap-3">

                                    <span class="text-xs text-slate-500">
                                        Nombre
                                    </span>

                                    <span class="text-sm
                                        font-medium
                                        text-white
                                        max-w-[180px]
                                        truncate">

                                        @nombreUsuario

                                    </span>

                                </div>


                                <!-- CORREO -->

                                <div class="flex items-center
                                    justify-between
                                    gap-3
                                    mt-3">

                                    <span class="text-xs text-slate-500">
                                        Correo
                                    </span>

                                    <span class="text-sm
                                        text-slate-300
                                        max-w-[180px]
                                        truncate">

                                        @correoUsuario

                                    </span>

                                </div>


                                <!-- ROL -->

                                <div class="flex items-center
                                    justify-between
                                    gap-3
                                    mt-3">

                                    <span class="text-xs text-slate-500">
                                        Tipo de cuenta
                                    </span>

                                    <span class="text-sm
                                        text-slate-300">

                                        @rolUsuario

                                    </span>

                                </div>


                                <!-- ESTADO -->

                                <div class="flex items-center
                                    justify-between
                                    mt-3">

                                    <span class="text-xs text-slate-500">
                                        Estado
                                    </span>

                                    <span class="inline-flex
                                        items-center
                                        gap-1.5
                                        text-xs
                                        font-semibold
                                        text-emerald-400">

                                        <span class="w-2 h-2
                                            rounded-full
                                            bg-emerald-400">
                                        </span>

                                        Activo

                                    </span>

                                </div>

                            </div>


                            <!-- =================================================
                                 OPCIONES
                            ================================================== -->

                            <div class="p-2">


                                <!-- MI PERFIL -->

                                <a asp-controller="Usuario"
                                   asp-action="Perfil"
                                   class="flex items-center gap-3
                                    w-full
                                    px-3 py-3
                                    rounded-xl
                                    text-sm
                                    text-slate-300
                                    hover:bg-white/5
                                    hover:text-white
                                    transition">


                                    <div class="w-9 h-9
                                        rounded-lg
                                        bg-white/5
                                        flex items-center
                                        justify-center">

                                        👤

                                    </div>


                                    <div>

                                        <p class="font-semibold">
                                            Mi perfil
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Ver y editar mis datos
                                        </p>

                                    </div>

                                </a>


                                <!-- MIS RESERVAS -->

                                <a href="@(urlPanel)#reservas"
                                   onclick="toggleClientMenu()"
                                   class="flex items-center gap-3
                                    w-full
                                    px-3 py-3
                                    rounded-xl
                                    text-sm
                                    text-slate-300
                                    hover:bg-white/5
                                    hover:text-white
                                    transition">


                                    <div class="w-9 h-9
                                        rounded-lg
                                        bg-emerald-500/10
                                        flex items-center
                                        justify-center">

                                        📅

                                    </div>


                                    <div>

                                        <p class="font-semibold">
                                            Mis reservas
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Consultar mis reservas
                                        </p>

                                    </div>

                                </a>


                                <!-- CAMBIAR CONTRASEÑA -->

                                <a asp-controller="Usuario"
                                   asp-action="CambiarPassword"
                                   class="flex items-center gap-3
                                    w-full
                                    px-3 py-3
                                    rounded-xl
                                    text-sm
                                    text-slate-300
                                    hover:bg-white/5
                                    hover:text-white
                                    transition">


                                    <div class="w-9 h-9
                                        rounded-lg
                                        bg-cyan-500/10
                                        flex items-center
                                        justify-center">

                                        🔑

                                    </div>


                                    <div>

                                        <p class="font-semibold">
                                            Cambiar contraseña
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            Actualiza tu contraseña
                                        </p>

                                    </div>

                                </a>

                            </div>


                            <!-- =================================================
                                 CERRAR SESIÓN
                            ================================================== -->

                            <div class="p-2 border-t border-white/10">

                                <form asp-controller="Login"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="flex items-center gap-3
                                        w-full
                                        px-3 py-3
                                        rounded-xl
                                        text-sm
                                        text-red-400
                                        hover:bg-red-500/10
                                        hover:text-red-300
                                        transition">


                                        <div class="w-9 h-9
                                            rounded-lg
                                            bg-red-500/10
                                            flex items-center
                                            justify-center">

                                            🚪

                                        </div>


                                        <div class="text-left">

                                            <p class="font-semibold">
                                                Cerrar sesión
                                            </p>

                                            <p class="text-xs text-slate-600">
                                                Salir de mi cuenta
                                            </p>

                                        </div>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

                    <!-- =================================================
                 NAVEGACIÓN EN CELULAR
            ================================================== -->

            <nav class="md:hidden -mx-1 flex gap-2 overflow-x-auto px-1 pb-3 text-sm" aria-label="Principal (celular)">
                <a href="@urlPanel" class="@ClaseNavMovil(esPanel)">Inicio</a>
                <a href="@(urlPanel)#escenarios" class="@ClaseNavMovil(false)">Escenarios</a>
                <a href="@(urlPanel)#reservas" class="@ClaseNavMovil(false)">Mis reservas</a>
                <a href="@(urlPanel)#ayuda" class="@ClaseNavMovil(false)">Ayuda</a>
                <a asp-controller="Contacto" asp-action="Index" class="@ClaseNavMovil(esContacto)">Contacto</a>
            </nav>

        </div>

    </header>


    @RenderBody()


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =====================================================
         MENÚ DEL CLIENTE
    ====================================================== -->

    <script>

            function toggleClientMenu() {

                const menu = document.getElementById('clientMenu');

                if (menu) {
                    menu.classList.toggle('hidden');
                }
            }


            // Cerrar menú al hacer clic fuera

            document.addEventListener('click', function(event) {

                const menu = document.getElementById('clientMenu');

                const button = document.getElementById('clientMenuButton');

                if (!menu || !button) {
                    return;
                }

                if (!menu.contains(event.target) &&
                    !button.contains(event.target)) {

                    menu.classList.add('hidden');

                }

            });

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>