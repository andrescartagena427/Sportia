@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Http
@using Sportia.Models

@inject SportiaDbContext _context

@{
    var idUsuario = Context.Session.GetInt32("IdUsuario");

    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Cliente";

    var correoUsuario = Context.Session.GetString("CorreoUsuario") ?? "Sin correo";

    var rolUsuario = Context.Session.GetString("Rol") ?? "Cliente";

    // Teléfono para el menú de la cuenta (del cliente; si no, del usuario)
    string? telefonoUsuario = null;
    if (idUsuario.HasValue)
    {
        telefonoUsuario = Sportia.Helpers.ClienteActual.Obtener(_context, idUsuario.Value)?.Telefono;
        if (string.IsNullOrWhiteSpace(telefonoUsuario))
        {
            telefonoUsuario = await _context.Usuarios
                .Where(u => u.IdUsuario == idUsuario.Value)
                .Select(u => u.Telefono)
                .FirstOrDefaultAsync();
        }
    }

    // Obtener la primera letra del nombre real
    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim().Substring(0, 1).ToUpper()
        : "C";

    // Contar reservas del usuario
    var cantidadReservas = idUsuario.HasValue
        ? await _context.Reservas.CountAsync(r => r.IdUsuario == idUsuario.Value)
        : 0;

    // Página actual (para marcar el enlace activo del menú)
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var esPanel = controladorActual == "Cliente" && accionActual == "Index";
    var esContacto = controladorActual == "Contacto";
    var esMisReservas = controladorActual == "Reservas" && accionActual == "Mias";
    var urlMisReservas = Url.Action("Mias", "Reservas");
    var urlPanel = Url.Action("Index", "Cliente");

    string ClaseNav(bool activo) => activo
        ? "text-sm font-semibold text-emerald-400"
        : "text-sm font-medium text-slate-400 hover:text-white transition";

    string ClaseNavMovil(bool activo) => activo
        ? "shrink-0 rounded-full bg-emerald-500/15 px-4 py-2 font-semibold text-emerald-400"
        : "shrink-0 rounded-full border border-white/10 px-4 py-2 text-slate-300 hover:text-white";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sportia</title>


    <!-- =====================================================
         TAILWIND CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/output.css"
          asp-append-version="true" />


    <!-- =====================================================
         GOOGLE FONTS
    ====================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         ESTILOS
    ====================================================== -->

    <style>

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                font-family: 'Inter', sans-serif;
                background: #020617;
            }

            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                font-family: 'Montserrat', sans-serif;
            }

            /* Scroll */

            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: #020617;
            }

            ::-webkit-scrollbar-thumb {
                background: #10b981;
                border-radius: 9999px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: #34d399;
                }

            /* Selección */

            ::selection {
                background: #10b981;
                color: white;
            }


            /* =====================================================
               MENÚ DE LA CUENTA DEL CLIENTE (arriba a la derecha)
            ====================================================== */
            .cm-menu {
                position: fixed; right: 20px; top: 80px; z-index: 9999;
                width: 340px; max-width: calc(100vw - 24px); max-height: calc(100vh - 96px); overflow-y: auto;
                padding: 14px; border-radius: 18px;
                background: #09111e; border: 1px solid rgba(255, 255, 255, .09);
                box-shadow: 0 24px 60px rgba(0, 0, 0, .55); backdrop-filter: blur(16px);
                color: #eef3fa; font-size: 13px;
            }
            .cm-menu svg { flex-shrink: 0; }
            .cm-cab { padding: 14px; border-radius: 14px; border: 1px solid rgba(34, 211, 154, .22); background: linear-gradient(150deg, rgba(34, 211, 154, .12), rgba(34, 211, 154, .02)); }
            .cm-cab-fila { display: flex; align-items: center; gap: 12px; }
            .cm-avatar {
                position: relative; width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
                display: grid; place-items: center; font-size: 20px; font-weight: 800; color: #fff;
                background: linear-gradient(135deg, #34d399, #047857); box-shadow: 0 0 0 3px rgba(34, 211, 154, .18);
            }
            .cm-avatar-editar {
                position: absolute; right: -3px; bottom: -3px; width: 22px; height: 22px; border-radius: 50%;
                display: grid; place-items: center; background: #1e293b; border: 2px solid #0b1424; color: #cbd5e1;
            }
            .cm-avatar-editar:hover { color: #22d39a; }
            .cm-avatar-editar svg { width: 11px; height: 11px; }
            .cm-cab-datos { flex: 1; min-width: 0; }
            .cm-nombre { margin: 0; font-size: 15px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .cm-rol { margin: 2px 0 0; font-size: 12px; color: #94a3b8; }
            .cm-pill { padding: 4px 10px; border-radius: 999px; background: rgba(34, 211, 154, .14); border: 1px solid rgba(34, 211, 154, .35); color: #22d39a; font-size: 11px; font-weight: 700; }
            .cm-contacto { display: grid; gap: 7px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, .07); }
            .cm-contacto span { display: flex; align-items: center; gap: 9px; color: #cbd5e1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .cm-contacto svg { width: 15px; height: 15px; color: #64748b; }

            .cm-info { margin-top: 12px; padding: 12px 14px 6px; border-radius: 14px; background: rgba(255, 255, 255, .025); border: 1px solid rgba(255, 255, 255, .07); }
            .cm-info-titulo { margin: 0 0 6px; font-size: 13px; font-weight: 700; color: #fff; }
            .cm-dato { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255, 255, 255, .05); }
            .cm-dato:last-child { border-bottom: 0; }
            .cm-dato svg { width: 16px; height: 16px; color: #64748b; }
            .cm-dato span { flex: 0 0 auto; color: #94a3b8; font-size: 12px; }
            .cm-dato b { flex: 1; min-width: 0; text-align: right; font-weight: 600; font-size: 12px; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .cm-activo { display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px; color: #22d39a !important; }
            .cm-activo i { width: 7px; height: 7px; border-radius: 50%; background: #22d39a; }

            .cm-opciones { display: grid; gap: 4px; margin-top: 10px; }
            .cm-opcion {
                display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 12px;
                color: #e2e8f0; text-decoration: none; transition: background .15s ease;
            }
            .cm-opcion:hover { background: rgba(255, 255, 255, .05); color: #fff; }
            .cm-opcion-icono { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: rgba(34, 211, 154, .1); border: 1px solid rgba(34, 211, 154, .25); color: #22d39a; }
            .cm-opcion-icono svg { width: 19px; height: 19px; }
            .cm-opcion-texto { flex: 1; min-width: 0; text-align: left; }
            .cm-opcion-texto b { display: block; font-size: 14px; font-weight: 600; }
            .cm-opcion-texto small { display: block; margin-top: 2px; font-size: 12px; color: #94a3b8; }
            .cm-flecha { width: 16px; height: 16px; color: #64748b; }
            .cm-contador { min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; display: grid; place-items: center; background: rgba(34, 211, 154, .15); color: #22d39a; font-size: 11px; font-weight: 700; }

            .cm-salir-form { margin: 10px 0 0; }
            .cm-salir {
                width: 100%; display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 12px; cursor: pointer;
                background: rgba(239, 68, 68, .08); border: 1px solid rgba(239, 68, 68, .28); color: #f87171; font: inherit;
                transition: background .15s ease;
            }
            .cm-salir:hover { background: rgba(239, 68, 68, .15); }
            .cm-salir .cm-opcion-texto small { color: #fca5a5; opacity: .8; }
            .cm-salir-icono { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: rgba(239, 68, 68, .14); color: #f87171; }
            .cm-salir-icono svg { width: 19px; height: 19px; }
            .cm-menu.hidden { display: none; }
            @@media (max-width: 480px) { .cm-menu { right: 12px; left: 12px; width: auto; top: 72px; } }
    </style>

</head>


<body class="min-h-screen bg-slate-950 text-white antialiased">


    <!-- =====================================================
         CONTENIDO DEL CLIENTE
    ====================================================== -->
    <!-- =========================================================
         HEADER DEL CLIENTE
    ========================================================== -->

    <header class="border-b border-white/10 bg-slate-950/90 backdrop-blur-xl sticky top-0 z-50">

        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">

            <div class="h-20 flex items-center justify-between">

                <!-- =================================================
                     LOGO
                ================================================== -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="flex items-center gap-3 group">

                    <div class="w-10 h-10 rounded-xl
                        bg-emerald-500
                        flex items-center justify-center
                        shadow-lg shadow-emerald-500/20
                        group-hover:scale-105 transition">

                        <svg class="w-6 h-6 text-white"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 4v16m8-8H4" />

                        </svg>

                    </div>

                    <div>

                        <span class="block text-xl font-black tracking-tight">
                            SPORTIA
                        </span>

                        <span class="block text-[10px] uppercase
                            tracking-[0.2em]
                            text-slate-500">
                            Sports Booking
                        </span>

                    </div>

                </a>


                <!-- =================================================
                     NAVEGACIÓN
                ================================================== -->

                <nav class="hidden md:flex items-center gap-8" aria-label="Principal">

                    <a href="@urlPanel" class="@ClaseNav(esPanel)">
                        Inicio
                    </a>

                    <a href="@(urlPanel)#escenarios" class="@ClaseNav(false)">
                        Escenarios
                    </a>

                    <a href="@urlMisReservas" class="@ClaseNav(esMisReservas)">
                        Mis reservas
                    </a>

                    <a href="@(urlPanel)#ayuda" class="@ClaseNav(false)">
                        Ayuda
                    </a>

                    <a asp-controller="Contacto" asp-action="Index" class="@ClaseNav(esContacto)">
                        Contacto
                    </a>

                </nav>


                <!-- =================================================
                     PERFIL DEL CLIENTE
                ================================================== -->

                <div class="flex items-center gap-3">


                    <!-- NOTIFICACIONES -->

                    <button type="button"
                            class="hidden sm:flex w-10 h-10
                        rounded-xl
                        border border-white/10
                        bg-white/5
                        items-center justify-center
                        text-slate-400
                        hover:text-white
                        hover:bg-white/10
                        transition">

                        <svg class="w-5 h-5"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M15 17h5l-1.5-2A7 7 0 0012 5a7 7 0 00-6.5 10L4 17h5m6 0a3 3 0 11-6 0" />

                        </svg>

                    </button>


                    <!-- =================================================
                         CONTENEDOR DEL PERFIL
                    ================================================== -->

                    <div class="pl-3 border-l border-white/10 relative shrink-0">


                        <!-- BOTÓN DE LA INICIAL -->

                        <button id="clientMenuButton"
                                type="button"
                                onclick="toggleClientMenu()"
                                class="flex items-center gap-3
                            rounded-xl
                            p-1.5
                            hover:bg-white/5
                            transition">


                            <!-- INICIAL REAL -->

                            <div style="
                                width: 40px;
                                height: 40px;
                                min-width: 40px;
                                min-height: 40px;
                                max-width: 40px;
                                max-height: 40px;
                                flex: 0 0 40px;
                                aspect-ratio: 1 / 1;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                overflow: hidden;
                                box-sizing: border-box;
                                background: linear-gradient(135deg, #34d399, #047857);
                                color: white;
                                font-weight: 700;
                                line-height: 1;
                                text-align: center;
                                ">

                                @inicialUsuario

                            </div>


                            <!-- NOMBRE -->

                            <div class="hidden lg:block text-left">

                                <p class="text-sm font-semibold max-w-[160px] truncate">
                                    @nombreUsuario
                                </p>

                                <p class="text-xs text-slate-500">
                                    Cuenta activa
                                </p>

                            </div>


                            <!-- FLECHA -->

                            <svg class="hidden sm:block w-4 h-4 text-slate-500"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M19 9l-7 7-7-7" />

                            </svg>

                        </button>


                        <!-- =================================================
                             MENÚ DEL CLIENTE
                        ================================================== -->

                        <div id="clientMenu" class="hidden cm-menu" role="menu" aria-label="Mi cuenta">

                            <!-- ENCABEZADO: foto, nombre y contacto -->
                            <div class="cm-cab">
                                <div class="cm-cab-fila">
                                    <div class="cm-avatar">
                                        @inicialUsuario
                                        <a asp-controller="Usuario" asp-action="EditarPerfil" class="cm-avatar-editar" title="Editar mis datos" aria-label="Editar mis datos">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z" /></svg>
                                        </a>
                                    </div>
                                    <div class="cm-cab-datos">
                                        <p class="cm-nombre">@nombreUsuario</p>
                                        <p class="cm-rol">@rolUsuario</p>
                                    </div>
                                    <span class="cm-pill">Activo</span>
                                </div>
                                <div class="cm-contacto">
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6l8.5 7 8.5-7" /></svg>
                                        @correoUsuario
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(telefonoUsuario))
                                    {
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M6.6 3.5l2.6-.4 1.6 4.3-2 1.6a12.4 12.4 0 0 0 6.2 6.2l1.6-2 4.3 1.6-.4 2.6c-.2 1.2-1.3 2.1-2.5 2.1C10.4 19.5 4.5 13.6 4.5 6c0-1.2.9-2.3 2.1-2.5z" /></svg>
                                            @telefonoUsuario
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- INFORMACIÓN DE LA CUENTA -->
                            <div class="cm-info">
                                <p class="cm-info-titulo">Información de la cuenta</p>
                                <div class="cm-dato">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4.5 20.5c.8-3.8 3.8-6 7.5-6s6.7 2.2 7.5 6" /></svg>
                                    <span>Nombre completo</span>
                                    <b title="@nombreUsuario">@nombreUsuario</b>
                                </div>
                                <div class="cm-dato">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6l8.5 7 8.5-7" /></svg>
                                    <span>Correo electrónico</span>
                                    <b title="@correoUsuario">@correoUsuario</b>
                                </div>
                                <div class="cm-dato">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><path d="M6.6 3.5l2.6-.4 1.6 4.3-2 1.6a12.4 12.4 0 0 0 6.2 6.2l1.6-2 4.3 1.6-.4 2.6c-.2 1.2-1.3 2.1-2.5 2.1C10.4 19.5 4.5 13.6 4.5 6c0-1.2.9-2.3 2.1-2.5z" /></svg>
                                    <span>Teléfono</span>
                                    <b>@(string.IsNullOrWhiteSpace(telefonoUsuario) ? "Sin teléfono" : telefonoUsuario)</b>
                                </div>
                                <div class="cm-dato">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2.5" /><circle cx="9" cy="11" r="2.2" /><path d="M5.8 16.2c.5-1.5 1.7-2.4 3.2-2.4s2.7.9 3.2 2.4M15 10h4M15 13.5h3" /></svg>
                                    <span>Tipo de cuenta</span>
                                    <b>@rolUsuario</b>
                                </div>
                                <div class="cm-dato">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                    <span>Estado</span>
                                    <b class="cm-activo"><i></i>Activo</b>
                                </div>
                            </div>

                            <!-- OPCIONES -->
                            <div class="cm-opciones">
                                <a asp-controller="Usuario" asp-action="Perfil" class="cm-opcion" role="menuitem">
                                    <span class="cm-opcion-icono">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4.5 20.5c.8-3.8 3.8-6 7.5-6s6.7 2.2 7.5 6" /></svg>
                                    </span>
                                    <span class="cm-opcion-texto"><b>Mi perfil</b><small>Ver y editar mis datos</small></span>
                                    <svg class="cm-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
                                </a>
                                <a href="@urlMisReservas" onclick="toggleClientMenu()" class="cm-opcion" role="menuitem">
                                    <span class="cm-opcion-icono">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5" /><path d="M16 2.5v4M8 2.5v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01" /></svg>
                                    </span>
                                    <span class="cm-opcion-texto"><b>Mis reservas</b><small>Consultar y gestionar reservas</small></span>
                                    @if (cantidadReservas > 0)
                                    {
                                        <span class="cm-contador">@cantidadReservas</span>
                                    }
                                    <svg class="cm-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
                                </a>
                                <a asp-controller="Usuario" asp-action="CambiarPassword" class="cm-opcion" role="menuitem">
                                    <span class="cm-opcion-icono">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4" /><path d="M10.8 12.2L20 3M17 6l2.5 2.5M14.5 8.5L16.5 10.5" /></svg>
                                    </span>
                                    <span class="cm-opcion-texto"><b>Cambiar contraseña</b><small>Actualiza tu contraseña</small></span>
                                    <svg class="cm-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
                                </a>
                            </div>

                            <!-- CERRAR SESIÓN -->
                            <form asp-controller="Login" asp-action="Logout" method="post" class="cm-salir-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cm-salir" role="menuitem">
                                    <span class="cm-salir-icono">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" /><path d="M10 16l-4-4 4-4M6 12h10" /></svg>
                                    </span>
                                    <span class="cm-opcion-texto"><b>Cerrar sesión</b><small>Salir de mi cuenta</small></span>
                                </button>
                            </form>
                        </div>

                    </div>

                </div>

            </div>

                    <!-- =================================================
                 NAVEGACIÓN EN CELULAR
            ================================================== -->

            <nav class="md:hidden -mx-1 flex gap-2 overflow-x-auto px-1 pb-3 text-sm" aria-label="Principal (celular)">
                <a href="@urlPanel" class="@ClaseNavMovil(esPanel)">Inicio</a>
                <a href="@(urlPanel)#escenarios" class="@ClaseNavMovil(false)">Escenarios</a>
                <a href="@urlMisReservas" class="@ClaseNavMovil(esMisReservas)">Mis reservas</a>
                <a href="@(urlPanel)#ayuda" class="@ClaseNavMovil(false)">Ayuda</a>
                <a asp-controller="Contacto" asp-action="Index" class="@ClaseNavMovil(esContacto)">Contacto</a>
            </nav>

        </div>

    </header>


    @RenderBody()


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =====================================================
         MENÚ DEL CLIENTE
    ====================================================== -->

    <script>

            function toggleClientMenu() {

                const menu = document.getElementById('clientMenu');

                if (menu) {
                    menu.classList.toggle('hidden');
                }
            }


            // Cerrar menú al hacer clic fuera

            document.addEventListener('click', function(event) {

                const menu = document.getElementById('clientMenu');

                const button = document.getElementById('clientMenuButton');

                if (!menu || !button) {
                    return;
                }

                if (!menu.contains(event.target) &&
                    !button.contains(event.target)) {

                    menu.classList.add('hidden');

                }

            });

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>