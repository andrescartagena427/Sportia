<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sportia</title>

    <!-- Bootstrap CSS local de tu proyecto -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap CSS por CDN (respaldo, por si el archivo local no carga o no existe) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Íconos de Bootstrap CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts: Montserrat & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-main: #0B0F19;
                --bg-card: #1F2937;
                --accent-green: #10B981;
                --accent-hover: #059669;
            }

            body {
                background-color: var(--bg-main);
                color: #e5e7eb;
                font-family: 'Inter', sans-serif;
            }

            .font-heading {
                font-family: 'Montserrat', sans-serif;
            }

            /* Navbar */
            .navbar-sportia {
                background-color: rgba(11, 15, 25, 0.95);
                backdrop-filter: blur(8px);
                border-bottom: 1px solid #1f2937;
                padding: 16px 0;
            }

            .brand-logo {
                font-weight: 800;
                font-size: 1.5rem;
                color: #f3f4f6;
                text-decoration: none;
                letter-spacing: 1px;
            }

                .brand-logo i {
                    color: var(--accent-green);
                }

            .nav-link-custom {
                color: #d1d5db;
                font-weight: 500;
                text-decoration: none;
                margin: 0 14px;
            }

                .nav-link-custom:hover, .nav-link-custom.active {
                    color: var(--accent-green);
                }

            .btn-outline-sportia {
                border: 1px solid #4b5563;
                color: #e5e7eb;
                font-weight: 500;
                font-size: 0.85rem;
                padding: 8px 18px;
                border-radius: 8px;
                text-decoration: none;
            }

                .btn-outline-sportia:hover {
                    border-color: #9ca3af;
                    color: #fff;
                }

            .btn-accent {
                background-color: var(--accent-green);
                color: #fff !important;
                font-weight: 600;
                font-size: 0.85rem;
                padding: 8px 18px;
                border-radius: 8px;
                text-decoration: none;
                border: none;
                box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
            }

                .btn-accent:hover {
                    background-color: var(--accent-hover);
                    color: #fff !important;
                }

            /* Hero */
            .hero-banner {
                background: linear-gradient(rgba(11, 15, 25, 0.75), rgba(11, 15, 25, 0.92)), url('https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
                padding: 140px 20px 90px;
                color: #f3f4f6;
                text-align: center;
            }

            .hero-title {
                font-weight: 800;
                font-size: 2.6rem;
                letter-spacing: -0.5px;
            }

            .hero-subtitle {
                color: #9ca3af;
                max-width: 620px;
                margin: 0 auto 2.5rem;
            }

            /* Widget de búsqueda */
            .search-widget {
                background-color: var(--bg-card);
                border: 1px solid rgba(75, 85, 99, 0.5);
                border-radius: 16px;
                padding: 24px;
                max-width: 900px;
                margin: 0 auto;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            }

                .search-widget label {
                    font-size: 0.75rem;
                    font-weight: 700;
                    color: #9ca3af;
                    margin-bottom: 6px;
                    display: block;
                }

                .search-widget .form-select,
                .search-widget .form-control {
                    background-color: #111827;
                    border: 1px solid #374151;
                    color: #e5e7eb;
                    border-radius: 10px;
                    padding: 10px 14px;
                    font-size: 0.9rem;
                }

                    .search-widget .form-select:focus,
                    .search-widget .form-control:focus {
                        background-color: #111827;
                        color: #e5e7eb;
                        border-color: var(--accent-green);
                        box-shadow: none;
                    }

            /* Tarjetas de canchas */
            .court-card {
                background-color: var(--bg-card);
                border: 1px solid rgba(75, 85, 99, 0.5);
                border-radius: 16px;
                overflow: hidden;
                transition: transform 0.2s ease, border-color 0.2s ease;
                height: 100%;
            }

                .court-card:hover {
                    transform: translateY(-4px);
                    border-color: var(--accent-green);
                }

            .court-img {
                height: 190px;
                object-fit: cover;
                width: 100%;
            }

            .court-badge {
                position: absolute;
                top: 14px;
                left: 14px;
                background: rgba(11, 15, 25, 0.85);
                color: var(--accent-green);
                border: 1px solid var(--accent-green);
                font-size: 0.7rem;
                font-weight: 700;
                padding: 5px 12px;
                border-radius: 999px;
            }

            .court-price {
                color: var(--accent-green);
                font-weight: 700;
                font-size: 1.15rem;
            }

            .btn-court {
                background-color: var(--accent-green);
                color: #fff !important;
                font-size: 0.75rem;
                font-weight: 600;
                padding: 8px 16px;
                border-radius: 10px;
                text-decoration: none;
            }

                .btn-court:hover {
                    background-color: var(--accent-hover);
                    color: #fff !important;
                }

            /* Footer */
            .footer-sportia {
                background-color: #080b12;
                border-top: 1px solid #1f2937;
                color: #9ca3af;
                padding: 28px 0;
                font-size: 0.85rem;
                margin-top: 60px;
            }

                .footer-sportia i:hover {
                    color: var(--accent-green);
                }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Header / Menú Superior -->
    <header>
        <nav class="navbar navbar-expand-md navbar-sportia fixed-top">
            <div class="container">
                <a class="brand-logo d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-dribbble"></i>
                    <span class="font-heading">SPORTIA</span>
                </a>

                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <div class="navbar-nav mx-auto mt-3 mt-md-0">
                        <a class="nav-link-custom active" href="#inicio">Inicio</a>
                        <a class="nav-link-custom" href="#canchas">Canchas</a>
                        <a class="nav-link-custom" href="#torneos">Torneos</a>
                        <a class="nav-link-custom" href="#contacto">Contacto</a>
                    </div>
                    <div class="d-flex gap-2 mt-3 mt-md-0">

                        <a asp-controller="Login" asp-action="Index" class="btn-outline-sportia">
                            Iniciar sesión
                        </a>

                        <a asp-controller="Login" asp-action="Index" class="btn-accent">
                            Reservar ahora
                        </a>

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Espaciador para navbar fija -->
    <div style="height: 80px;"></div>

    <!-- Cuerpo principal dinámico -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-sportia">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-facebook"></i>
                <i class="bi bi-instagram"></i>
                <i class="bi bi-youtube"></i>
                <i class="bi bi-tiktok"></i>
                <span class="fw-semibold text-light ms-2">Soporte técnico</span>
            </div>
            <div>
                <span>Políticas de privacidad (Referencias de privacidad con Habeas Data)</span>
            </div>
        </div>
    </footer>

    <!-- Scripts locales de ASP.NET -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Respaldo CDN del JS de Bootstrap, por si el archivo local no existe -->
    <script>
            if (typeof bootstrap === 'undefined') {
                document.write('<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"><\/script>');
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>