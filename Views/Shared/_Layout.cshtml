    <!-- TAILWIND CSS -->
    <link rel="stylesheet" href="~/css/output.css" />

    <!-- BOOTSTRAP ICONS -->
    <!-- Solo iconos, NO Bootstrap CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800&display=swap"
          rel="stylesheet">

    <style>

            :root {
                --bg-main: #0B0F19;
                --bg-card: #1F2937;
                --accent-green: #10B981;
                --accent-hover: #059669;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                background-color: var(--bg-main);
                color: #e5e7eb;
                font-family: 'Inter', sans-serif;
            }

            .font-heading {
                font-family: 'Montserrat', sans-serif;
            }


            /* =========================================
                       NAVBAR
                       ========================================= */

            .navbar-sportia {
                background-color: rgba(11, 15, 25, 0.96);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid #1f2937;
            }


            /* LOGO */

            .brand-logo {
                color: #f3f4f6;
                text-decoration: none;
                font-family: 'Montserrat', sans-serif;
                font-size: 1.45rem;
                font-weight: 800;
                letter-spacing: 1px;
            }

                .brand-logo:hover {
                    color: #f3f4f6;
                }

                .brand-logo i {
                    color: var(--accent-green);
                }


            /* ENLACES */

            .nav-link-custom {
                color: #d1d5db;
                text-decoration: none;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                .nav-link-custom:hover {
                    color: var(--accent-green);
                }


            /* BOTÓN INICIAR SESIÓN */

            .btn-outline-sportia {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #4b5563;
                color: #e5e7eb;
                padding: 9px 17px;
                border-radius: 8px;
                font-size: 0.85rem;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .btn-outline-sportia:hover {
                    border-color: var(--accent-green);
                    color: var(--accent-green);
                }


            /* BOTÓN RESERVAR */

            .btn-accent {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background-color: var(--accent-green);
                color: white !important;
                padding: 9px 18px;
                border-radius: 8px;
                font-size: 0.85rem;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.2s ease;
                box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
            }

                .btn-accent:hover {
                    background-color: var(--accent-hover);
                    color: white !important;
                    transform: translateY(-1px);
                }


            /* =========================================
                       FOOTER
                       ========================================= */

            .footer-sportia {
                background-color: #080b12;
                border-top: 1px solid #1f2937;
                color: #9ca3af;
            }

                .footer-sportia i {
                    transition: color 0.2s ease;
                }

                    .footer-sportia i:hover {
                        color: var(--accent-green);
                    }


            /* =========================================
                       RESPONSIVE
                       ========================================= */

            @@media (max-width: 900px) {

                .nav-links {
                    display: none;
                }
            }

            @@media (max-width: 600px) {

                .navbar-buttons {
                    display: none;
                }
            }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>


    <!-- =========================================
         NAVBAR
         ========================================= -->

    <header class="fixed left-0 top-0 z-50 w-full navbar-sportia">

        <nav class="mx-auto max-w-7xl px-6">

            <div class="flex min-h-[72px] items-center justify-between gap-6">


                <!-- LOGO -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="brand-logo flex items-center gap-2">

                    <i class="bi bi-dribbble text-xl"></i>

                    <span>SPORTIA</span>

                </a>


                <!-- MENÚ -->

                <div class="nav-links flex items-center gap-7">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link-custom">

                        Inicio

                    </a>

                    <a href="#canchas"
                       class="nav-link-custom">

                        Canchas

                    </a>

                    <a href="#torneos"
                       class="nav-link-custom">

                        Torneos

                    </a>

                    <a href="#contacto"
                       class="nav-link-custom">

                        Contacto

                    </a>

                </div>


                <!-- BOTONES -->

                <div class="navbar-buttons flex items-center gap-2">


                    <!-- INICIAR SESIÓN -->

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn-outline-sportia">

                        <i class="bi bi-box-arrow-in-right mr-1"></i>

                        Iniciar sesión

                    </a>


                    <!-- RESERVAR -->

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn-accent">

                        <i class="bi bi-calendar-check mr-1"></i>

                        Reservar ahora

                    </a>

                </div>

            </div>

        </nav>

    </header>


    <!-- ESPACIO PARA LA NAVBAR -->

    <div class="h-[72px]"></div>


    <!-- =========================================
         CONTENIDO DE CADA PÁGINA
         ========================================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
         ========================================= -->

    <footer class="footer-sportia mt-16">

        <div class="mx-auto max-w-7xl px-6 py-8">

            <div class="flex flex-col items-center justify-between gap-5 text-center md:flex-row md:text-left">


                <!-- REDES SOCIALES -->

                <div class="flex items-center gap-4">

                    <i class="bi bi-facebook text-lg"></i>

                    <i class="bi bi-instagram text-lg"></i>

                    <i class="bi bi-youtube text-lg"></i>

                    <i class="bi bi-tiktok text-lg"></i>

                    <span class="ml-2 font-semibold text-gray-200">
                        Soporte técnico
                    </span>

                </div>


                <!-- PRIVACIDAD -->

                <div class="text-sm text-gray-500">

                    Políticas de privacidad

                    <span class="mx-1">
                        •
                    </span>

                    Habeas Data

                </div>


                <!-- COPYRIGHT -->

                <div class="text-sm text-gray-500">

                    &copy; 2026 Sportia

                </div>

            </div>

        </div>

    </footer>


    <!-- =========================================
         SCRIPTS
         ========================================= -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

