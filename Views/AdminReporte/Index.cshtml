@{
    ViewData["Title"] = "Reportes";
    Layout = "_DashboardLayout";
}

<div class="space-y-6">

    <!-- ENCABEZADO -->

    <div>

        <h1 class="text-2xl font-bold text-white">
            Reportes
        </h1>

        <p class="mt-1 text-sm text-slate-400">
            Consulta las estadísticas y el rendimiento general de Sportia.
        </p>

    </div>


    <!-- TARJETAS -->

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">


        <!-- CLIENTES -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">

            <p class="text-sm text-slate-400">
                Total clientes
            </p>

            <p class="mt-2 text-3xl font-bold text-white">
                @ViewBag.TotalClientes
            </p>

        </div>


        <!-- EMPRESAS -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">

            <p class="text-sm text-slate-400">
                Empresas
            </p>

            <p class="mt-2 text-3xl font-bold text-white">
                @ViewBag.TotalEmpresas
            </p>

        </div>


        <!-- RESERVAS -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">

            <p class="text-sm text-slate-400">
                Total reservas
            </p>

            <p class="mt-2 text-3xl font-bold text-emerald-400">
                @ViewBag.TotalReservas
            </p>

        </div>


        <!-- RESERVAS HOY -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">

            <p class="text-sm text-slate-400">
                Reservas hoy
            </p>

            <p class="mt-2 text-3xl font-bold text-blue-400">
                @ViewBag.ReservasHoy
            </p>

        </div>

    </div>


    <!-- INGRESOS -->

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">


        <!-- INGRESOS -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">

            <p class="text-sm font-semibold text-slate-400">
                Ingresos recibidos
            </p>

            <p class="mt-3 text-4xl font-bold text-emerald-400">

                $@ViewBag.IngresosTotales.ToString("N0")

            </p>

            <p class="mt-2 text-sm text-slate-500">
                Total de dinero registrado en pagos.
            </p>

        </div>


        <!-- SALDO PENDIENTE -->

        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">

            <p class="text-sm font-semibold text-slate-400">
                Saldo pendiente
            </p>

            <p class="mt-3 text-4xl font-bold text-red-400">

                $@ViewBag.SaldoPendiente.ToString("N0")

            </p>

            <p class="mt-2 text-sm text-slate-500">
                Dinero pendiente por pagar de las reservas.
            </p>

        </div>

    </div>


    <!-- RESUMEN DEL SISTEMA -->

    <div class="rounded-2xl border border-slate-800 bg-slate-900/70">

        <div class="border-b border-slate-800 p-6">

            <h2 class="text-lg font-bold text-white">
                Resumen del sistema
            </h2>

            <p class="mt-1 text-sm text-slate-500">
                Información general registrada en Sportia.
            </p>

        </div>


        <div class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2 xl:grid-cols-4">


            <div class="rounded-xl bg-slate-950 p-4">

                <p class="text-xs uppercase tracking-wider text-slate-500">
                    Usuarios
                </p>

                <p class="mt-2 text-2xl font-bold text-white">
                    @ViewBag.TotalUsuarios
                </p>

            </div>


            <div class="rounded-xl bg-slate-950 p-4">

                <p class="text-xs uppercase tracking-wider text-slate-500">
                    Escenarios
                </p>

                <p class="mt-2 text-2xl font-bold text-white">
                    @ViewBag.TotalEscenarios
                </p>

            </div>


            <div class="rounded-xl bg-slate-950 p-4">

                <p class="text-xs uppercase tracking-wider text-slate-500">
                    Pagos
                </p>

                <p class="mt-2 text-2xl font-bold text-white">
                    @ViewBag.TotalPagos
                </p>

            </div>


            <div class="rounded-xl bg-slate-950 p-4">

                <p class="text-xs uppercase tracking-wider text-slate-500">
                    Reservas
                </p>

                <p class="mt-2 text-2xl font-bold text-white">
                    @ViewBag.TotalReservas
                </p>

            </div>

        </div>

    </div>

</div>