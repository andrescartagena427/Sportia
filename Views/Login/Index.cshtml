@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-container">
    <div class="login-card">

        <div class="text-center mb-4">
            <div class="login-logo">
                <i class="bi bi-dribbble"></i>
            </div>

            <h1>SPORTIA</h1>
            <p>Inicia sesión en tu cuenta</p>
        </div>

        <form asp-controller="Login" asp-action="Index" method="post">

            <div class="mb-3">
                <label for="correo" class="form-label">
                    Correo electrónico
                </label>

                <input type="email"
                       id="correo"
                       name="correo"
                       class="form-control"
                       placeholder="Ingresa tu correo"
                       required />
            </div>

            <div class="mb-3">
                <label for="contrasena" class="form-label">
                    Contraseña
                </label>

                <input type="password"
                       id="contrasena"
                       name="contrasena"
                       class="form-control"
                       placeholder="Ingresa tu contraseña"
                       required />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn-login">
                Iniciar sesión
            </button>

        </form>

        <div class="register-link">
            <span>¿No tienes una cuenta?</span>

            <a asp-controller="Login" asp-action="Register">
                Registrarse
            </a>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" class="back-home">
                ← Volver al inicio
            </a>
        </div>

    </div>
</div>

<style>

    .login-container {
        min-height: calc(100vh - 80px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #0B0F19;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        background: #1F2937;
        padding: 40px;
        border-radius: 18px;
        border: 1px solid #374151;
        box-shadow: 0 20px 50px rgba(0,0,0,.4);
    }

    .login-logo {
        font-size: 45px;
        color: #10B981;
        margin-bottom: 10px;
    }

    .login-card h1 {
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .login-card p {
        color: #9CA3AF;
        margin-bottom: 30px;
    }

    .login-card .form-label {
        color: #E5E7EB;
        font-weight: 600;
    }

    .login-card .form-control {
        background: #111827;
        border: 1px solid #374151;
        color: #fff;
        padding: 12px;
        border-radius: 10px;
    }

        .login-card .form-control:focus {
            background: #111827;
            color: #fff;
            border-color: #10B981;
            box-shadow: 0 0 0 2px rgba(16,185,129,.15);
        }

        .login-card .form-control::placeholder {
            color: #6B7280;
        }

    .btn-login {
        width: 100%;
        border: none;
        background: #10B981;
        color: white;
        padding: 12px;
        border-radius: 10px;
        font-weight: 600;
        margin-top: 10px;
        transition: .2s;
    }

        .btn-login:hover {
            background: #059669;
        }

    .register-link {
        text-align: center;
        margin-top: 25px;
        color: #9CA3AF;
    }

        .register-link a {
            color: #10B981;
            text-decoration: none;
            font-weight: 600;
            margin-left: 5px;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    .back-home {
        color: #9CA3AF;
        text-decoration: none;
        font-size: 14px;
    }

        .back-home:hover {
            color: #10B981;
        }

</style>
