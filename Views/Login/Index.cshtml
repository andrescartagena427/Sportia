@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="min-h-[calc(100vh-72px)] bg-[#0B0F19] flex items-center justify-center px-5 py-10">

    <div class="w-full max-w-[430px]">

        <!-- TARJETA -->
        <div class="bg-[#1F2937] border border-[#374151] rounded-[18px] p-8 sm:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.4)]">


            <!-- LOGO Y TÍTULO -->
            <div class="text-center mb-8">

                <div class="text-[45px] text-[#10B981] mb-2">
                    <i class="bi bi-dribbble"></i>
                </div>

                <h1 class="text-white font-['Montserrat'] font-extrabold text-3xl mb-1">
                    SPORTIA
                </h1>

                <p class="text-[#9CA3AF] mb-0">
                    Inicia sesión en tu cuenta
                </p>

            </div>


            <!-- FORMULARIO -->
            <form asp-controller="Login"
                  asp-action="Index"
                  method="post">


                <!-- CORREO -->
                <div class="mb-5">

                    <label for="correo"
                           class="block text-[#E5E7EB] font-semibold text-sm mb-2">

                        Correo electrónico

                    </label>

                    <input type="email"
                           id="correo"
                           name="correo"
                           placeholder="Ingresa tu correo"
                           required
                           class="w-full bg-[#111827] border border-[#374151] text-white placeholder-[#6B7280] px-3 py-3 rounded-[10px] outline-none transition-all duration-200 focus:border-[#10B981] focus:ring-2 focus:ring-[#10B981]/15" />

                </div>


                <!-- CONTRASEÑA -->
                <div class="mb-5">

                    <label for="contrasena"
                           class="block text-[#E5E7EB] font-semibold text-sm mb-2">

                        Contraseña

                    </label>

                    <input type="password"
                           id="contrasena"
                           name="contrasena"
                           placeholder="Ingresa tu contraseña"
                           required
                           class="w-full bg-[#111827] border border-[#374151] text-white placeholder-[#6B7280] px-3 py-3 rounded-[10px] outline-none transition-all duration-200 focus:border-[#10B981] focus:ring-2 focus:ring-[#10B981]/15" />

                </div>


                <!-- MENSAJE DE ERROR -->
                @if (ViewBag.Error != null)
                {
                    <div class="mb-5 rounded-[10px] border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                        @ViewBag.Error
                    </div>
                }


                <!-- BOTÓN -->
                <button type="submit"
                        class="w-full border-0 bg-[#10B981] text-white py-3 px-4 rounded-[10px] font-semibold mt-1 transition-all duration-200 hover:bg-[#059669] hover:-translate-y-[1px] hover:shadow-[0_6px_20px_rgba(16,185,129,0.25)]">

                    <i class="bi bi-box-arrow-in-right mr-2"></i>

                    Iniciar sesión

                </button>

            </form>


            <!-- REGISTRO -->
            <div class="text-center mt-6 text-[#9CA3AF] text-sm">

                <span>
                    ¿No tienes una cuenta?
                </span>

                <a asp-controller="Login"
                   asp-action="Register"
                   class="text-[#10B981] font-semibold ml-1 hover:text-[#059669] hover:underline">

                    Registrarse

                </a>

            </div>


            <!-- VOLVER -->
            <div class="text-center mt-4">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-[#9CA3AF] text-sm no-underline transition-colors duration-200 hover:text-[#10B981]">

                    ← Volver al inicio

                </a>

            </div>

        </div>

    </div>

</div>