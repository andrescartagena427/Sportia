@{
    ViewData["Title"] = "Dashboard Administrador";

    var usuarios = Convert.ToInt32(ViewBag.TotalUsuarios ?? 0);
    var clientes = Convert.ToInt32(ViewBag.TotalClientes ?? 0);
    var escenarios = Convert.ToInt32(ViewBag.TotalEscenarios ?? 0);
    var reservas = Convert.ToInt32(ViewBag.TotalReservas ?? 0);
    var empresas = Convert.ToInt32(ViewBag.TotalEmpresas ?? 0);
    var pagos = Convert.ToInt32(ViewBag.TotalPagos ?? 0);

    var totalGeneral = usuarios + clientes + escenarios + reservas;

    var maxValor = Math.Max(
        Math.Max(usuarios, clientes),
        Math.Max(escenarios, reservas)
    );

    var usuariosWidth = maxValor > 0 ? usuarios * 100 / maxValor : 0;
    var clientesWidth = maxValor > 0 ? clientes * 100 / maxValor : 0;
    var escenariosWidth = maxValor > 0 ? escenarios * 100 / maxValor : 0;
    var reservasWidth = maxValor > 0 ? reservas * 100 / maxValor : 0;

    var totalDistribucion = usuarios + clientes + escenarios + reservas;

    var usuariosPercent = totalDistribucion > 0
        ? usuarios * 100 / totalDistribucion
        : 0;

    var clientesPercent = totalDistribucion > 0
        ? clientes * 100 / totalDistribucion
        : 0;

    var escenariosPercent = totalDistribucion > 0
        ? escenarios * 100 / totalDistribucion
        : 0;

    var reservasPercent = totalDistribucion > 0
        ? reservas * 100 / totalDistribucion
        : 0;
}

<style>

    /* =========================================================
           DASHBOARD SPORTIA
        ========================================================= */

    html {
        scroll-behavior: smooth;
    }

    body {
        background: #050816 !important;
    }

    .sportia-dashboard {
        background: radial-gradient(circle at 75% 10%, rgba(16, 185, 129, .08), transparent 25%), radial-gradient(circle at 20% 30%, rgba(59, 130, 246, .06), transparent 30%), #050816;
        min-height: 100vh;
    }

    .glass-card {
        background: rgba(11, 18, 32, .82);
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 20px 50px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.025);
        backdrop-filter: blur(18px);
    }

        .glass-card:hover {
            border-color: rgba(16,185,129,.22);
        }

    .sidebar-glow {
        box-shadow: 15px 0 50px rgba(0,0,0,.18), inset -1px 0 rgba(255,255,255,.04);
    }

    .stat-card {
        transition: all .25s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .chart-bar {
        transition: width .8s ease;
    }

    .dashboard-scroll::-webkit-scrollbar {
        width: 7px;
    }

    .dashboard-scroll::-webkit-scrollbar-track {
        background: #050816;
    }

    .dashboard-scroll::-webkit-scrollbar-thumb {
        background: #10b981;
        border-radius: 999px;
    }

</style>


