@using System.Globalization
@model Sportia.Models.ViewModels.DashboardAdminViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var co = new CultureInfo("es-CO");
    var primerNombre = (Model.NombreAdmin ?? "Admin").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Admin";

    const string imagenPorDefecto =
        "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=400&q=70";

    int columnasCalendario = (Model.HoraFinCalendario - Model.HoraInicioCalendario) * 2;
    string plantillaColumnas = $"grid-template-columns: 210px repeat({columnasCalendario}, minmax(44px, 1fr));";

    bool calendarioEsHoy = Model.FechaCalendario == Model.Hoy;

    // Canchas que se ven sin desplegar el calendario
    const int CanchasVisibles = 4;
    int indiceFila = 0;
    string fechaAnterior = Model.FechaCalendario.AddDays(-1).ToString("yyyy-MM-dd");
    string fechaSiguiente = Model.FechaCalendario.AddDays(1).ToString("yyyy-MM-dd");

    decimal maxIngresoDia = Model.IngresosSemana.Any() ? Model.IngresosSemana.Max(d => d.Total) : 0;
    if (maxIngresoDia <= 0) maxIngresoDia = 1;
}

@functions {
    // Texto de dinero: $840.000
    string Dinero(decimal valor) => "$" + valor.ToString("N0", new CultureInfo("es-CO"));

    // Dinero corto para ejes: 1,5M · 500K
    string Compacto(decimal valor)
    {
        if (valor >= 1_000_000) return (valor / 1_000_000m).ToString("0.#", new CultureInfo("es-CO")) + "M";
        if (valor >= 1_000) return (valor / 1_000m).ToString("0.#", new CultureInfo("es-CO")) + "K";
        return valor.ToString("0", new CultureInfo("es-CO"));
    }

    // Línea y área de una mini gráfica (sparkline) de 120 x 44
    (string linea, string area) Sparkline(List<double> valores)
    {
        if (valores == null || valores.Count == 0) return ("", "");
        double max = valores.Max(), min = valores.Min();
        double rango = max - min == 0 ? 1 : max - min;
        double paso = valores.Count > 1 ? 120.0 / (valores.Count - 1) : 120.0;
        var puntos = valores.Select((v, i) =>
            $"{(i * paso).ToString("0.#", CultureInfo.InvariantCulture)},{(40 - (v - min) / rango * 34).ToString("0.#", CultureInfo.InvariantCulture)}").ToList();
        string linea = "M" + string.Join(" L", puntos);
        string area = linea + " L120,44 L0,44 Z";
        return (linea, area);
    }

    // Clases del estado de una reserva
    string ClaseEstado(string estado)
    {
        var e = (estado ?? "").ToLowerInvariant();
        if (e.Contains("confirm")) return "border-emerald-500/40 bg-emerald-500/10 text-emerald-300";
        if (e.Contains("pend")) return "border-amber-500/40 bg-amber-500/10 text-amber-300";
        if (e.Contains("cancel")) return "border-red-500/40 bg-red-500/10 text-red-300";
        return "border-sky-500/40 bg-sky-500/10 text-sky-300";
    }

    // Color del bloque en el calendario según el estado
    string ClaseBloque(string estado)
    {
        var e = (estado ?? "").ToLowerInvariant();
        if (e.Contains("confirm")) return "bg-emerald-600 hover:bg-emerald-500";
        if (e.Contains("pend")) return "bg-amber-500 hover:bg-amber-400 text-slate-950";
        return "bg-sky-600 hover:bg-sky-500";
    }

    // Color del anillo de ocupación
    string ColorAnillo(int porcentaje) =>
        porcentaje >= 75 ? "#10b981" : porcentaje >= 50 ? "#38bdf8" : porcentaje > 0 ? "#f59e0b" : "#334155";
}

@* Indicador de variación ↑ 12% vs ayer *@
@functions {
    Microsoft.AspNetCore.Html.IHtmlContent Variacion(double? valor, string periodo)
    {
        string html;
        if (valor == null)
            html = $"<span class=\"text-xs font-semibold text-sky-300\">Nuevo</span><span class=\"block text-xs text-slate-500\">{periodo}</span>";
        else if (valor >= 0)
            html = $"<span class=\"text-xs font-semibold text-emerald-400\">↑ {valor.Value.ToString("0.#", new CultureInfo("es-CO"))}%</span><span class=\"block text-xs text-slate-500\">{periodo}</span>";
        else
            html = $"<span class=\"text-xs font-semibold text-red-400\">↓ {Math.Abs(valor.Value).ToString("0.#", new CultureInfo("es-CO"))}%</span><span class=\"block text-xs text-slate-500\">{periodo}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}


<!-- =====================================================
     BARRA SUPERIOR
====================================================== -->

<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <label class="flex h-12 w-full max-w-md items-center gap-3 rounded-xl border border-slate-800 bg-[#0d1422] px-4 text-slate-400 transition focus-within:border-emerald-500/50 sm:w-auto sm:flex-1">
        <i data-lucide="search" class="h-5 w-5"></i>
        <span class="sr-only">Buscar en el panel</span>
        <input id="buscadorPanel" type="search" placeholder="Buscar canchas, reservas, clientes..."
               class="h-full min-w-0 flex-1 bg-transparent text-sm text-white placeholder:text-slate-500 focus:outline-none" />
    </label>

    <div class="flex items-center gap-3">
        <a asp-controller="Reservas" asp-action="Index"
           class="relative flex h-12 w-12 items-center justify-center rounded-xl border border-slate-800 bg-[#0d1422] text-slate-300 transition hover:text-white"
           aria-label="Ver reservas próximas">
            <i data-lucide="bell" class="h-5 w-5"></i>
            @if (Model.ProximasReservas.Any())
            {
                <span class="absolute right-2 top-2 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">@Model.ProximasReservas.Count</span>
            }
        </a>
        <div class="flex h-12 items-center gap-2 rounded-xl border border-slate-800 bg-[#0d1422] px-4 text-sm text-slate-300">
            <i data-lucide="calendar" class="h-4 w-4"></i>
            @co.TextInfo.ToTitleCase(Model.Hoy.ToString("ddd, dd MMM yyyy", co))
        </div>
    </div>
</div>


<div class="grid gap-6 2xl:grid-cols-[minmax(0,1fr)_360px]">

    <!-- =====================================================
         COLUMNA PRINCIPAL
    ====================================================== -->

    <div class="min-w-0 space-y-6">

        <!-- ===== Saludo ===== -->
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <h1 class="text-3xl font-black tracking-tight sm:text-4xl">¡Hola, <span class="text-emerald-400">@primerNombre</span>!</h1>
                <p class="mt-1 text-slate-400">Aquí tienes un resumen de lo que está pasando en Sportia hoy.</p>
            </div>
            <a asp-controller="Reservas" asp-action="Create"
               class="inline-flex h-12 items-center gap-2 rounded-xl bg-emerald-500 px-5 font-bold text-[#03150d] shadow-lg shadow-emerald-500/25 transition hover:-translate-y-0.5 hover:bg-emerald-400">
                <i data-lucide="plus" class="h-5 w-5"></i>
                Nueva reserva
            </a>
        </div>

        <!-- ===== Tarjetas ===== -->
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

            @{
                var spReservas = Sparkline(Model.SerieReservas);
                var spIngresos = Sparkline(Model.SerieIngresos);
                var spClientes = Sparkline(Model.SerieClientes);
                double circunferencia = 2 * Math.PI * 26;
                double llenoOcupacion = circunferencia * Math.Clamp(Model.OcupacionHoy, 0, 100) / 100.0;
            }

            <!-- Reservas hoy -->
            <div class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400"><i data-lucide="calendar-check" class="h-5 w-5"></i></span>
                    <p class="text-sm font-medium text-slate-300">Reservas hoy</p>
                </div>
                <div class="mt-4">
                    <p class="whitespace-nowrap text-[clamp(1.5rem,1.9vw,1.9rem)] font-black leading-tight">@Model.ReservasHoy</p>
                    <div class="mt-2 flex items-end justify-between gap-2">
                        <p class="min-w-0 leading-tight">@Variacion(Model.VariacionReservas, "vs. ayer")</p>
                        <svg viewBox="0 0 120 44" class="h-10 w-20 shrink-0" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="gReservas" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#10b981" stop-opacity=".35" /><stop offset="1" stop-color="#10b981" stop-opacity="0" /></linearGradient></defs>
                        <path d="@spReservas.area" fill="url(#gReservas)" />
                        <path d="@spReservas.linea" fill="none" stroke="#10b981" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                    </div>
                </div>
            </div>

            <!-- Ingresos hoy -->
            <div class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/15 text-sky-400"><i data-lucide="circle-dollar-sign" class="h-5 w-5"></i></span>
                    <p class="text-sm font-medium text-slate-300">Ingresos hoy</p>
                </div>
                <div class="mt-4">
                    <p class="whitespace-nowrap text-[clamp(1.5rem,1.9vw,1.9rem)] font-black leading-tight">@Dinero(Model.IngresosHoy)</p>
                    <div class="mt-2 flex items-end justify-between gap-2">
                        <p class="min-w-0 leading-tight">@Variacion(Model.VariacionIngresos, "vs. ayer")</p>
                        <svg viewBox="0 0 120 44" class="h-10 w-20 shrink-0" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="gIngresos" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#3b82f6" stop-opacity=".35" /><stop offset="1" stop-color="#3b82f6" stop-opacity="0" /></linearGradient></defs>
                        <path d="@spIngresos.area" fill="url(#gIngresos)" />
                        <path d="@spIngresos.linea" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                    </div>
                </div>
            </div>

            <!-- Ocupación -->
            <div class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-500/15 text-violet-400"><i data-lucide="pie-chart" class="h-5 w-5"></i></span>
                    <p class="text-sm font-medium text-slate-300">Ocupación de canchas</p>
                </div>
                <div class="mt-4">
                    <p class="whitespace-nowrap text-[clamp(1.5rem,1.9vw,1.9rem)] font-black leading-tight">@Model.OcupacionHoy%</p>
                    <div class="mt-2 flex items-end justify-between gap-2">
                        <p class="min-w-0 leading-tight">@Variacion(Model.VariacionOcupacion, "vs. ayer")</p>
                        <svg viewBox="0 0 64 64" class="h-12 w-12 shrink-0 -rotate-90" aria-label="Ocupación @Model.OcupacionHoy%">
                        <circle cx="32" cy="32" r="26" fill="none" stroke="#1e293b" stroke-width="8" />
                        <circle cx="32" cy="32" r="26" fill="none" stroke="#10b981" stroke-width="8" stroke-linecap="round"
                                stroke-dasharray="@llenoOcupacion.ToString("0.##", CultureInfo.InvariantCulture) @circunferencia.ToString("0.##", CultureInfo.InvariantCulture)" />
                    </svg>
                    </div>
                </div>
            </div>

            <!-- Clientes activos -->
            <div class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/15 text-indigo-400"><i data-lucide="users" class="h-5 w-5"></i></span>
                    <p class="text-sm font-medium text-slate-300">Clientes activos</p>
                </div>
                <div class="mt-4">
                    <p class="whitespace-nowrap text-[clamp(1.5rem,1.9vw,1.9rem)] font-black leading-tight">@Model.ClientesActivos</p>
                    <div class="mt-2 flex items-end justify-between gap-2">
                        <p class="min-w-0 leading-tight">@Variacion(Model.VariacionClientes, "vs. 30 días antes")</p>
                        <svg viewBox="0 0 120 44" class="h-10 w-20 shrink-0" preserveAspectRatio="none" aria-hidden="true">
                        <defs><linearGradient id="gClientes" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#8b5cf6" stop-opacity=".35" /><stop offset="1" stop-color="#8b5cf6" stop-opacity="0" /></linearGradient></defs>
                        <path d="@spClientes.area" fill="url(#gClientes)" />
                        <path d="@spClientes.linea" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                    </div>
                </div>
            </div>
        </div>


        <!-- ===== Calendario de canchas ===== -->
        <section id="calendario" class="overflow-hidden rounded-2xl border border-slate-800 bg-[#0d1422]">

            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-800 p-5">
                <h2 class="flex items-center gap-3 text-lg font-bold">
                    <i data-lucide="calendar-days" class="h-6 w-6 text-emerald-400"></i>
                    Calendario de canchas
                </h2>

                <div class="flex flex-wrap items-center gap-2">
                    <a href="?fecha=@fechaAnterior#calendario" aria-label="Día anterior"
                       class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 text-slate-300 transition hover:border-emerald-500/60 hover:text-white">
                        <i data-lucide="chevron-left" class="h-5 w-5"></i>
                    </a>
                    <form method="get" class="contents">
                        <label for="fechaCalendario" class="sr-only">Elegir fecha</label>
                        <input id="fechaCalendario" type="date" name="fecha" value="@Model.FechaCalendario.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()"
                               class="h-10 rounded-lg border border-slate-700 bg-transparent px-3 text-sm font-semibold text-white [color-scheme:dark] focus:border-emerald-500/60 focus:outline-none" />
                    </form>
                    <a href="?fecha=@fechaSiguiente#calendario" aria-label="Día siguiente"
                       class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 text-slate-300 transition hover:border-emerald-500/60 hover:text-white">
                        <i data-lucide="chevron-right" class="h-5 w-5"></i>
                    </a>
                    @if (!calendarioEsHoy)
                    {
                        <a href="?#calendario" class="flex h-10 items-center rounded-lg bg-emerald-500 px-4 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400">Hoy</a>
                    }
                    else
                    {
                        <span class="flex h-10 items-center rounded-lg bg-emerald-500/15 px-4 text-sm font-bold text-emerald-400">Hoy</span>
                    }
                </div>
            </div>

            @if (!Model.Calendario.Any())
            {
                <p class="p-10 text-center text-slate-400">No hay canchas activas. Activa un escenario para verlo en el calendario.</p>
            }
            else
            {
                <div id="scrollCalendario" class="overflow-x-auto" data-hora-inicio="@Model.HoraInicioCalendario" data-es-hoy="@(calendarioEsHoy ? "1" : "0")">
                    <div class="grid min-w-max" style="@plantillaColumnas">

                        <!-- Encabezado de horas -->
                        <div class="sticky left-0 z-10 border-b border-r border-slate-800 bg-[#0d1422] px-4 py-2 text-sm font-semibold">Canchas</div>
                        @for (int h = Model.HoraInicioCalendario; h < Model.HoraFinCalendario; h++)
                        {
                            <div class="col-span-2 border-b border-slate-800 px-2 py-2 text-center text-xs font-semibold text-slate-300">@($"{h:00}:00")</div>
                        }

                        <!-- Filas por cancha -->
                        @foreach (var fila in Model.Calendario)
                        {
                            bool filaExtra = indiceFila++ >= CanchasVisibles;
                            <div class="fila-calendario @(filaExtra ? "fila-extra hidden" : "contents")" data-buscar="@($"{fila.Nombre} {fila.Tipo} {string.Join(" ", fila.Bloques.Select(b => b.Cliente))}".ToLower())">
                                <div class="sticky left-0 z-10 flex items-center gap-3 border-b border-r border-slate-800 bg-[#0d1422] px-4 py-1.5">
                                    <img src="@(string.IsNullOrWhiteSpace(fila.Imagen) ? imagenPorDefecto : fila.Imagen)" alt="" class="h-8 w-10 shrink-0 rounded-md object-cover" loading="lazy" />
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-semibold">@fila.Nombre</p>
                                        <p class="truncate text-xs text-slate-500">@fila.Tipo</p>
                                    </div>
                                </div>

                                @foreach (var b in fila.Bloques)
                                {
                                    string posicion = $"grid-column: {b.Columna + 1} / span {b.Span};";

                                    if (b.Tipo == "reserva")
                                    {
                                        <div class="border-b border-slate-800 p-1" style="@posicion">
                                            <div class="flex h-full min-h-9 flex-col justify-center rounded-md px-2 py-1 text-white shadow-sm transition @ClaseBloque(b.Estado ?? "")"
                                                 title="@b.Cliente · @b.Horario · @b.Estado">
                                                <p class="truncate text-xs font-bold leading-tight">@b.Cliente</p>
                                                <p class="truncate text-[10px] leading-tight opacity-80">@b.Horario</p>
                                            </div>
                                        </div>
                                    }
                                    else if (b.Tipo == "libre")
                                    {
                                        <div class="border-b border-slate-800 p-1" style="@posicion">
                                            <a asp-controller="Reservas" asp-action="Create"
                                               class="flex h-full min-h-9 items-center justify-center rounded-lg border border-slate-700/70 bg-slate-800/40 text-xs text-slate-400 transition hover:border-emerald-500/60 hover:text-emerald-300"
                                               title="Libre · crear una reserva">
                                                Libre
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="border-b border-slate-800 p-1" style="@posicion">
                                            <div class="flex h-full min-h-9 items-center justify-center rounded-lg bg-[repeating-linear-gradient(45deg,transparent,transparent_6px,rgba(148,163,184,0.07)_6px,rgba(148,163,184,0.07)_12px)] text-[11px] text-slate-600">Cerrado</div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (Model.Calendario.Count > CanchasVisibles)
                {
                    <button type="button" id="btnVerCanchas" aria-expanded="false"
                            data-texto-mas="Ver todas las canchas (@Model.Calendario.Count)" data-texto-menos="Ver menos canchas"
                            class="flex w-full items-center justify-center gap-2 border-t border-slate-800 py-3 text-sm font-semibold text-emerald-400 transition hover:bg-emerald-500/5">
                        <span id="textoVerCanchas">Ver todas las canchas (@Model.Calendario.Count)</span>
                        <i data-lucide="chevron-down" id="iconoVerCanchas" class="h-4 w-4 transition"></i>
                    </button>
                }

                <div class="flex flex-wrap items-center gap-4 border-t border-slate-800 px-5 py-3 text-xs text-slate-400">
                    <span class="flex items-center gap-2"><span class="h-3 w-3 rounded bg-emerald-600"></span>Confirmada</span>
                    <span class="flex items-center gap-2"><span class="h-3 w-3 rounded bg-amber-500"></span>Pendiente</span>
                    <span class="flex items-center gap-2"><span class="h-3 w-3 rounded bg-sky-600"></span>Otro estado</span>
                    <span class="flex items-center gap-2"><span class="h-3 w-3 rounded border border-slate-700 bg-slate-800/40"></span>Libre (clic para reservar)</span>
                </div>
            }
        </section>


        <!-- ===== Ingresos de la semana + Próximas reservas ===== -->
        <div class="grid gap-6 xl:grid-cols-2">

            <section class="flex flex-col rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <h2 class="flex items-center gap-3 font-bold">
                        <svg class="h-6 w-6 text-emerald-400" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="12" width="4" height="9" rx="1" /><rect x="10" y="7" width="4" height="14" rx="1" /><rect x="17" y="3" width="4" height="18" rx="1" /></svg>
                        Ingresos de la semana
                    </h2>
                    <div class="text-right">
                        <p class="text-2xl font-black text-emerald-400">@Dinero(Model.TotalIngresosSemana)</p>
                        <p>@Variacion(Model.VariacionIngresosSemana, "vs. semana pasada")</p>
                    </div>
                </div>

                <div class="mt-auto flex gap-3 pt-6">
                    <div class="flex h-44 flex-col justify-between pb-6 text-right text-[11px] text-slate-500">
                        <span>@Compacto(maxIngresoDia)</span>
                        <span>@Compacto(maxIngresoDia / 2)</span>
                        <span>0</span>
                    </div>
                    <div class="grid h-44 flex-1 grid-cols-7 items-end gap-2 border-b border-l border-slate-800 pl-2">
                        @foreach (var dia in Model.IngresosSemana)
                        {
                            double alto = (double)(dia.Total / maxIngresoDia) * 100;
                            <div class="flex h-full flex-col items-center justify-end" title="@dia.Etiqueta @dia.Fecha.ToString("dd/MM"): @Dinero(dia.Total)">
                                <div class="w-full max-w-9 rounded-t-md transition-all @(dia.EsHoy ? "bg-gradient-to-t from-emerald-600 to-emerald-300" : "bg-gradient-to-t from-emerald-700 to-emerald-500")"
                                     style="height: @(Math.Max(alto, dia.Total > 0 ? 3 : 0).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
                            </div>
                        }
                    </div>
                </div>
                <div class="ml-10 mt-2 grid grid-cols-7 gap-2 text-center text-xs text-slate-400">
                    @foreach (var dia in Model.IngresosSemana)
                    {
                        <span class="@(dia.EsHoy ? "font-bold text-emerald-400" : "")">@dia.Etiqueta</span>
                    }
                </div>
            </section>

            <!-- ===== Próximas reservas ===== -->
            <section class="flex flex-col rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
                <div class="flex items-center justify-between">
                    <h2 class="flex items-center gap-3 font-bold">
                        <i data-lucide="calendar-clock" class="h-6 w-6 text-emerald-400"></i>
                        Próximas reservas
                    </h2>
                    <a asp-controller="Reservas" asp-action="Index" class="flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-emerald-400">Ver todas <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i></a>
                </div>

                @if (!Model.ProximasReservas.Any())
                {
                    <p class="flex flex-1 items-center justify-center py-10 text-center text-sm text-slate-500">No hay reservas próximas.</p>
                }
                else
                {
                    <ul class="mt-3 divide-y divide-slate-800">
                        @foreach (var r in Model.ProximasReservas)
                        {
                            <li class="item-buscable flex items-center gap-3 py-2.5" data-buscar="@($"{r.Cliente} {r.Escenario} {r.Tipo} {r.Estado}".ToLower())">
                                <img src="@(string.IsNullOrWhiteSpace(r.Imagen) ? imagenPorDefecto : r.Imagen)" alt="" class="h-11 w-11 shrink-0 rounded-lg object-cover" loading="lazy" />
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold">
                                        @r.HoraInicio.ToString("HH:mm") - @r.HoraFin.ToString("HH:mm")
                                        <span class="ml-1 text-xs font-normal text-slate-500">· @(r.Fecha == Model.Hoy ? "Hoy" : r.Fecha.ToString("dd MMM", co))</span>
                                    </p>
                                    <p class="truncate text-xs text-slate-400">@r.Escenario · @r.Cliente</p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs font-semibold @ClaseEstado(r.Estado)">@r.Estado</span>
                                    <p class="mt-1.5 text-sm font-bold">@Dinero(r.Valor)</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>


    <!-- =====================================================
         COLUMNA DERECHA
    ====================================================== -->

    <aside class="grid min-w-0 content-start gap-6 lg:grid-cols-2 2xl:flex 2xl:flex-col">

        <!-- ===== Reservas recientes ===== -->
        <section class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5 lg:col-span-2 2xl:col-span-1">
            <div class="flex items-center justify-between">
                <h2 class="flex items-center gap-3 font-bold">
                    <i data-lucide="clipboard-list" class="h-6 w-6 text-emerald-400"></i>
                    Reservas recientes
                </h2>
                <a asp-controller="Reservas" asp-action="Index" class="flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-emerald-400">Ver todas <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i></a>
            </div>

            @if (!Model.ReservasRecientes.Any())
            {
                <p class="py-8 text-center text-sm text-slate-500">Todavía no hay reservas registradas.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-slate-800">
                    @foreach (var r in Model.ReservasRecientes)
                    {
                        <li class="item-buscable flex items-center gap-3 py-3" data-buscar="@($"{r.Cliente} {r.Escenario} {r.Tipo} {r.Estado}".ToLower())">
                            <img src="@(string.IsNullOrWhiteSpace(r.Imagen) ? imagenPorDefecto : r.Imagen)" alt="" class="h-12 w-12 shrink-0 rounded-xl object-cover" loading="lazy" />
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-semibold">@r.Cliente</p>
                                <p class="truncate text-xs text-slate-400">@r.Escenario</p>
                                <p class="text-xs text-slate-500">@r.Fecha.ToString("dd MMM", co) · @r.HoraInicio.ToString("HH:mm")</p>
                            </div>
                            <div class="shrink-0 text-right">
                                <span class="whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs font-semibold @ClaseEstado(r.Estado)">@r.Estado</span>
                                <p class="mt-2 text-sm font-bold">@Dinero(r.Valor)</p>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <!-- ===== Estado de las canchas ===== -->
        <section class="rounded-2xl border border-slate-800 bg-[#0d1422] p-5">
            <div class="flex items-center justify-between">
                <h2 class="flex items-center gap-3 font-bold">
                    <i data-lucide="activity" class="h-6 w-6 text-emerald-400"></i>
                    Estado de las canchas
                </h2>
                <a asp-controller="Escenarios" asp-action="Index" class="flex items-center gap-1 text-xs font-semibold text-slate-400 hover:text-emerald-400">Ver todas <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i></a>
            </div>
            <p class="mt-1 text-xs text-slate-500">Ocupación de hoy (horas reservadas / horas abiertas)</p>

            @if (!Model.EstadoCanchas.Any())
            {
                <p class="py-8 text-center text-sm text-slate-500">No hay canchas activas.</p>
            }
            else
            {
                <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
                    @foreach (var c in Model.EstadoCanchas)
                    {
                        double circ = 2 * Math.PI * 26;
                        double lleno = circ * Math.Clamp(c.Porcentaje, 0, 100) / 100.0;
                        <div class="text-center" title="@c.Nombre: @c.HorasReservadas de @c.HorasDisponibles horas reservadas">
                            <div class="relative mx-auto h-16 w-16">
                                <svg viewBox="0 0 64 64" class="h-16 w-16 -rotate-90">
                                    <circle cx="32" cy="32" r="26" fill="none" stroke="#1e293b" stroke-width="6" />
                                    <circle cx="32" cy="32" r="26" fill="none" stroke="@ColorAnillo(c.Porcentaje)" stroke-width="6" stroke-linecap="round"
                                            stroke-dasharray="@lleno.ToString("0.##", CultureInfo.InvariantCulture) @circ.ToString("0.##", CultureInfo.InvariantCulture)" />
                                </svg>
                                <span class="absolute inset-0 flex items-center justify-center text-sm font-bold">@c.Porcentaje%</span>
                            </div>
                            <p class="mt-2 line-clamp-2 text-xs font-semibold leading-tight text-slate-200">@c.Nombre</p>
                            <p class="text-[11px] text-slate-500">@c.HorasReservadas.ToString("0.#", co)/@c.HorasDisponibles.ToString("0.#", co) h</p>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- ===== Tarjeta de acceso rápido ===== -->
        <section class="relative flex flex-col justify-center overflow-hidden rounded-2xl border border-slate-800 2xl:flex-1">
            <img src="https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=800&q=70" alt=""
                 class="dash-kenburns absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-r from-[#0d1422] via-[#0d1422]/85 to-[#0d1422]/30"></div>
            <div class="relative p-6">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 font-black text-[#03150d]">S</span>
                <h3 class="mt-4 text-xl font-black leading-tight">Gestiona tus canchas<br>de forma fácil y rápida</h3>
                <p class="mt-2 text-xs text-slate-300">Más reservas · Más clientes · Más ingresos</p>
                <a asp-controller="Escenarios" asp-action="Index"
                   class="mt-5 inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-bold text-[#03150d] transition hover:bg-emerald-400">
                    Ver escenarios
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>
                </a>
            </div>
        </section>
    </aside>
</div>

<p id="sinResultadosPanel" class="mt-6 hidden rounded-2xl border border-dashed border-slate-700 p-5 text-center text-sm text-slate-400">
    No encontramos canchas, reservas ni clientes con ese texto.
</p>


<style>
    @@keyframes dashKenBurns {
        0% { transform: scale(1); }
        100% { transform: scale(1.12) translate(-2%, -1%); }
    }

    .dash-kenburns {
        animation: dashKenBurns 18s ease-in-out infinite alternate;
    }

    @@media (prefers-reduced-motion: reduce) {
        .dash-kenburns { animation: none; }
    }
</style>


<script>
    // =====================================================
    // BUSCADOR DEL PANEL: filtra canchas del calendario,
    // próximas reservas y reservas recientes
    // =====================================================
    (function () {
        const input = document.getElementById('buscadorPanel');
        const aviso = document.getElementById('sinResultadosPanel');
        if (!input) return;

        input.addEventListener('input', function () {
            const texto = this.value.trim().toLowerCase();
            let visibles = 0;

            const expandido = document.getElementById('btnVerCanchas')?.getAttribute('aria-expanded') === 'true';
            document.querySelectorAll('.fila-calendario').forEach(fila => {
                const esExtra = fila.classList.contains('fila-extra');
                const ok = texto ? (fila.dataset.buscar || '').includes(texto) : (!esExtra || expandido);
                fila.classList.toggle('hidden', !ok);
                fila.classList.toggle('contents', ok);
                if (ok) visibles++;
            });

            document.querySelectorAll('.item-buscable').forEach(item => {
                const ok = !texto || (item.dataset.buscar || '').includes(texto);
                item.classList.toggle('hidden', !ok);
                if (ok) visibles++;
            });

            aviso.classList.toggle('hidden', !texto || visibles > 0);
        });
    })();

    // =====================================================
    // CALENDARIO: ver todas las canchas / ver menos
    // =====================================================
    (function () {
        const btn = document.getElementById('btnVerCanchas');
        if (!btn) return;
        btn.addEventListener('click', function () {
            const abrir = this.getAttribute('aria-expanded') !== 'true';
            this.setAttribute('aria-expanded', abrir);
            document.querySelectorAll('.fila-extra').forEach(f => {
                f.classList.toggle('hidden', !abrir);
                f.classList.toggle('contents', abrir);
            });
            document.getElementById('textoVerCanchas').textContent = abrir ? this.dataset.textoMenos : this.dataset.textoMas;
            const icono = this.querySelector('svg, i');
            if (icono) icono.style.transform = abrir ? 'rotate(180deg)' : '';
            if (!abrir) document.getElementById('calendario').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    })();

    // =====================================================
    // CALENDARIO: abrir en la hora actual (si es hoy)
    // =====================================================
    (function () {
        const caja = document.getElementById('scrollCalendario');
        if (!caja || caja.dataset.esHoy !== '1') return;
        const inicio = parseInt(caja.dataset.horaInicio, 10);
        const ahora = new Date();
        const horasDesdeInicio = ahora.getHours() - inicio - 1;
        if (horasDesdeInicio <= 0) return;
        const anchoHora = (caja.scrollWidth - 210) / Math.max(1, caja.querySelectorAll('.col-span-2').length);
        caja.scrollLeft = Math.max(0, horasDesdeInicio * anchoHora);
    })();
</script>
