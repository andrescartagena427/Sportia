@using Sportia.Models

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var totalReservas = (int)(ViewBag.TotalReservas ?? 0);
    var totalClientes = (int)(ViewBag.TotalClientes ?? 0);
    var totalEscenarios = (int)(ViewBag.TotalEscenarios ?? 0);
    var escenariosActivos = (int)(ViewBag.EscenariosActivos ?? 0);
    var reservasHoy = (int)(ViewBag.ReservasHoy ?? 0);
    var totalUsuarios = (int)(ViewBag.TotalUsuarios ?? 0);
    var totalEmpresas = (int)(ViewBag.TotalEmpresas ?? 0);
    var totalPagos = (int)(ViewBag.TotalPagos ?? 0);

    decimal ingresosMes = ViewBag.IngresosMes != null
        ? (decimal)ViewBag.IngresosMes
        : 0;

    var reservasRecientes =
        ViewBag.ReservasRecientes as List<Reserva>
        ?? new List<Reserva>();

    var escenariosMasReservados =
        ViewBag.EscenariosMasReservados as List<Escenario>
        ?? new List<Escenario>();

    var fechasGrafica =
        ViewBag.FechasGrafica as List<DateOnly>
        ?? new List<DateOnly>();

    var reservasPorDia =
        ViewBag.ReservasPorDia as List<int>
        ?? new List<int>();

    var maxReservasGrafica =
        reservasPorDia.Any()
            ? Math.Max(reservasPorDia.Max(), 1)
            : 1;

    // Meta mensual de reservas (ajusta este valor o tráelo desde tu backend)
    var metaMensualReservas = 60;
    var porcentajeMeta = metaMensualReservas > 0
        ? Math.Min(totalReservas * 100.0 / metaMensualReservas, 100)
        : 0;
    var faltantesMeta = Math.Max(metaMensualReservas - totalReservas, 0);

    // % de crecimiento simple comparando reservas de hoy vs promedio de la semana
    var promedioSemana = reservasPorDia.Any() ? reservasPorDia.Average() : 0;
    var crecimientoTexto = promedioSemana > 0
        ? Math.Round(((reservasHoy - promedioSemana) / promedioSemana) * 100, 1)
        : 0;
}

<style>

    /* =====================================================
               BANNER DE INSIGHT (HERO SUPERIOR)
               ===================================================== */

    .insight-banner {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 28px 30px;
        margin-bottom: 18px;
        border-radius: 18px;
        background: radial-gradient(circle at 15% 20%, rgba(139,92,246,.25), transparent 45%), radial-gradient(circle at 85% 80%, rgba(34,199,122,.25), transparent 50%), linear-gradient(135deg, #0c1420 0%, #101928 60%, #0c1420 100%);
        border: 1px solid #202d43;
    }

        .insight-banner::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
            background-size: 34px 34px;
            mask-image: radial-gradient(circle at 30% 40%, black, transparent 75%);
            pointer-events: none;
        }

    .insight-left {
        position: relative;
        z-index: 1;
        max-width: 560px;
    }

    .insight-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.4);
        color: #c4b5fd;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

        .insight-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #a78bfa;
            box-shadow: 0 0 8px 2px rgba(167,139,250,.7);
        }

    .insight-title {
        font-size: 21px;
        font-weight: 800;
        line-height: 1.35;
        color: #f4f7fb;
    }

        .insight-title .highlight-green {
            color: #4ee69b;
        }

        .insight-title .highlight-red {
            color: #f87171;
        }

    .insight-desc {
        margin-top: 12px;
        color: #93a2b8;
        font-size: 13px;
        line-height: 1.6;
    }

        .insight-desc b {
            color: #d5dce6;
        }

    .insight-right {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 16px;
        flex-shrink: 0;
    }

    .range-tabs {
        display: flex;
        gap: 4px;
        padding: 4px;
        border-radius: 10px;
        background: rgba(16, 25, 40, 0.7);
        border: 1px solid #202d43;
    }

    .range-tab {
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        color: #8c99ae;
        cursor: pointer;
        transition: all .2s ease;
    }

        .range-tab.active {
            background: #22c77a;
            color: #04150c;
        }

    .insight-mini-stats {
        display: flex;
        gap: 22px;
    }

    .insight-mini-stat {
        text-align: right;
    }

    .insight-mini-label {
        font-size: 10px;
        color: #718097;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .insight-mini-value {
        margin-top: 4px;
        font-size: 17px;
        font-weight: 800;
        color: #f4f7fb;
    }

        .insight-mini-value.accent {
            color: #4ee69b;
        }

    /* =====================================================
               GRID DE TARJETAS PEQUEÑAS (ESTILO DASHLY)
               ===================================================== */

    .quick-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1.35fr;
        gap: 16px;
        margin-bottom: 18px;
    }

    .qcard {
        padding: 20px;
        background: linear-gradient(160deg, #131f32 0%, #0c1420 100%);
        border: 1px solid #202d43;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        transition: border-color .2s ease, transform .2s ease;
    }

        .qcard:hover {
            transform: translateY(-2px);
            border-color: #2c4a3c;
        }

    .qcard-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .qcard-value {
        font-size: 22px;
        font-weight: 800;
        color: #f4f7fb;
    }

    .qcard-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 800;
    }

        .qcard-badge.up {
            background: rgba(34,199,122,.15);
            color: #4ee69b;
        }

        .qcard-badge.down {
            background: rgba(239,83,101,.15);
            color: #f87171;
        }

    .qcard-label {
        margin-top: 3px;
        color: #718097;
        font-size: 11px;
    }

    /* --- Tarjeta 1: Dona de distribución --- */

    .qcard-donut-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 12px;
    }

    .mini-donut {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
    }

        .mini-donut svg {
            width: 72px;
            height: 72px;
            transform: rotate(-90deg);
        }

    .mini-legend {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .mini-legend-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #b7c1d1;
    }

        .mini-legend-row .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
            box-shadow: 0 0 6px currentColor;
        }

    .mini-legend-value {
        margin-left: auto;
        color: #718097;
    }

    /* --- Tarjeta 2: Barras --- */

    .mini-bars {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        height: 56px;
        margin-top: 14px;
        flex: 1;
    }

    .mini-bar {
        flex: 1;
        border-radius: 5px 5px 2px 2px;
        background: linear-gradient(180deg, #3b82f6, #1d4ed8);
        min-height: 4px;
        transition: transform .2s ease;
    }

        .mini-bar:hover {
            transform: scaleY(1.05);
            filter: brightness(1.2);
        }

    /* --- Tarjeta 3: Progreso de meta --- */

    .goal-track {
        margin-top: 16px;
        height: 8px;
        border-radius: 10px;
        background: #182337;
        overflow: hidden;
    }

    .goal-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #22c77a, #4ee69b);
        box-shadow: 0 0 10px rgba(34,199,122,.6);
    }

    .goal-footer {
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #718097;
    }

    /* --- Tarjeta 4: Área con etiquetas de fecha --- */

    .qcard-wide {
        position: relative;
    }

    .trend-chart-wrap {
        margin-top: 10px;
        flex: 1;
    }

    .trend-tooltip {
        position: absolute;
        padding: 6px 10px;
        border-radius: 8px;
        background: #1a2942;
        border: 1px solid #2c4a6e;
        font-size: 10px;
        color: #dfe5ed;
        white-space: nowrap;
        box-shadow: 0 6px 16px rgba(0,0,0,.4);
        transform: translate(-50%, -130%);
        pointer-events: none;
    }

        .trend-tooltip b {
            color: #4ee69b;
        }

    /* =====================================================
               SECCIÓN INFERIOR
               ===================================================== */

    .bottom-section {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 15px;
    }

    .panel {
        min-width: 0;
        padding: 20px;
        background: linear-gradient(160deg, #121d2f 0%, #0c1420 100%);
        border: 1px solid #202d43;
        border-radius: 16px;
    }

    .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 15px;
    }

    .panel-title {
        font-size: 15px;
        font-weight: 750;
        color: #f4f7fb;
    }

    .panel-subtitle {
        margin-top: 3px;
        color: #8c99ae;
        font-size: 11px;
    }

    .panel-button {
        padding: 6px 12px;
        border-radius: 8px;
        background: rgba(34,199,122,.1);
        border: 1px solid rgba(34,199,122,.35);
        color: #4ee69b;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
    }

    /* --- TABS ESTILO DASHLY --- */

    .filter-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        overflow-x: auto;
    }

    .filter-tab {
        padding: 9px 16px;
        border-radius: 10px;
        border: 1px solid #202d43;
        background: #101928;
        color: #8c99ae;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
        transition: all .2s ease;
    }

        .filter-tab.active {
            background: rgba(34,199,122,.12);
            border-color: #22c77a;
            color: #4ee69b;
        }

    /* --- TABLA --- */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .reservations-table {
        width: 100%;
        min-width: 640px;
        border-collapse: collapse;
    }

        .reservations-table th {
            padding: 0 9px 11px;
            color: #627087;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .reservations-table td {
            padding: 12px 9px;
            border-top: 1px solid #202d43;
            color: #dfe5ed;
            font-size: 12px;
        }

    .client {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .client-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c77a, #0e8c53);
        color: #04150c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }

    .client-sub {
        font-size: 10px;
        color: #718097;
        margin-top: 1px;
    }

    .status {
        display: inline-flex;
        padding: 4px 9px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-green {
        background: rgba(34, 199, 122, .13);
        color: #22c77a;
    }

    .status-orange {
        background: rgba(245, 166, 35, .13);
        color: #f5a623;
    }

    .status-red {
        background: rgba(239, 83, 101, .13);
        color: #ef5365;
    }

    .total-cell {
        font-weight: 800;
        color: #f4f7fb;
    }

    /* --- PANEL DERECHO: INGRESOS --- */

    .revenue-value {
        font-size: 26px;
        font-weight: 800;
        color: #f4f7fb;
        margin-top: 4px;
    }

    .revenue-sub {
        color: #718097;
        font-size: 11px;
        margin-top: 4px;
    }

    .revenue-chart-wrap {
        margin-top: 18px;
    }

    /* =====================================================
               RESPONSIVE
               ===================================================== */

    @@media (max-width: 1300px) {
        .quick-grid {
            grid-template-columns: 1fr 1fr;
        }

        .bottom-section {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {
        .insight-banner {
            flex-direction: column;
            align-items: flex-start;
        }

        .insight-right {
            align-items: flex-start;
            width: 100%;
        }
    }

    @@media (max-width: 560px) {
        .quick-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<!-- =====================================================
     BANNER DE INSIGHT
     ===================================================== -->

<div class="insight-banner">

    <div class="insight-left">

        <div class="insight-badge">
            <span class="dot"></span>
            Resumen inteligente
        </div>

        <div class="insight-title">
            @if (crecimientoTexto >= 0)
            {
                <text>
                    Hoy vas <span class="highlight-green">@crecimientoTexto% por encima</span> del promedio semanal
                </text>
            }
            else
            {
                <text>
                    Hoy vas <span class="highlight-red">@Math.Abs(crecimientoTexto)% por debajo</span> del promedio semanal
                </text>
            }
        </div>

        <div class="insight-desc">
            <b>@totalReservas</b> reservas totales, <b>@totalClientes</b> clientes activos y
            <b>$@ingresosMes.ToString("N0")</b> facturados este mes.
            @if (escenariosMasReservados.Any())
            {
                <text>
                    La <b>@escenariosMasReservados.First().Nombre</b> lidera las reservas del mes.
                </text>
            }
        </div>

    </div>


    <div class="insight-right">

        <div class="range-tabs">
            <div class="range-tab active">Hoy</div>
            <div class="range-tab">7 días</div>
            <div class="range-tab">30 días</div>
            <div class="range-tab">Año</div>
        </div>

        <div class="insight-mini-stats">

            <div class="insight-mini-stat">
                <div class="insight-mini-label">Reservas hoy</div>
                <div class="insight-mini-value accent">@reservasHoy</div>
            </div>

            <div class="insight-mini-stat">
                <div class="insight-mini-label">Escenarios activos</div>
                <div class="insight-mini-value">@escenariosActivos / @totalEscenarios</div>
            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     GRID DE TARJETAS PEQUEÑAS
     ===================================================== -->

<div class="quick-grid">


    <!-- TARJETA 1: DISTRIBUCIÓN (DONA) -->

    <div class="qcard">

        <div class="qcard-top">
            <div>
                <div class="qcard-value">@totalReservas.ToString("N0")</div>
                <div class="qcard-label">Reservas totales</div>
            </div>
            <span class="qcard-badge up">▲ @totalPagos pagos</span>
        </div>

        @{
            var topEscenarios = escenariosMasReservados.Take(5).ToList();
            var totalDist = topEscenarios.Sum(e => e.Reservas.Count);
            if (totalDist == 0) { totalDist = 1; }
            string[] paletaColores = { "#22c77a", "#3b82f6", "#8b5cf6", "#f5a623", "#ef5365" };
        }

        <div class="qcard-donut-row">

            <div class="mini-donut">
                <svg viewBox="0 0 42 42">
                    <circle cx="21" cy="21" r="15.9" fill="none" stroke="#182337" stroke-width="6" />

                    @{
                        double offAcumulado = 0;
                    }

                    @for (int i = 0; i < topEscenarios.Count; i++)
                    {
                        var cant = topEscenarios[i].Reservas.Count;
                        var pct = Math.Round(cant * 100.0 / totalDist, 2);
                        var resto = Math.Round(100 - pct, 2);

                        var dasharray = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
                            + " " + resto.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        var dashoffset = (-offAcumulado).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                        <circle cx="21" cy="21" r="15.9" fill="none"
                                stroke="@paletaColores[i % paletaColores.Length]"
                                stroke-width="6"
                                stroke-linecap="round"
                                stroke-dasharray="@dasharray"
                                stroke-dashoffset="@dashoffset" />

                        offAcumulado += pct;
                    }
                </svg>
            </div>

            <div class="mini-legend">

                @if (topEscenarios.Any())
                {
                    for (int i = 0; i < topEscenarios.Count && i < 3; i++)
                    {
                        var esc = topEscenarios[i];

                        <div class="mini-legend-row">
                            <span class="dot" style="background:@paletaColores[i % paletaColores.Length]; color:@paletaColores[i % paletaColores.Length];"></span>
                            <span>@esc.Nombre</span>
                            <span class="mini-legend-value">@esc.Reservas.Count</span>
                        </div>
                    }
                }
                else
                {
                    <div class="mini-legend-row">Sin datos aún</div>
                }

            </div>

        </div>

    </div>


    <!-- TARJETA 2: RESERVAS POR DÍA (BARRAS) -->

    <div class="qcard">

        <div class="qcard-top">
            <div>
                <div class="qcard-value">@reservasPorDia.Sum().ToString("N0")</div>
                <div class="qcard-label">Reservas (últimos 7 días)</div>
            </div>
            <span class="qcard-badge up">▲ activo</span>
        </div>

        <div class="mini-bars">

            @if (reservasPorDia.Any())
            {
                foreach (var val in reservasPorDia)
                {
                    var alturaPct = (val / (double)maxReservasGrafica) * 100;
                    if (alturaPct < 6) { alturaPct = 6; }

                    <div class="mini-bar" style="height:@alturaPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;" title="@val reservas"></div>
                }
            }
            else
            {
                <div style="color:#718097; font-size:11px;">Sin datos aún</div>
            }

        </div>

    </div>


    <!-- TARJETA 3: META DEL MES (PROGRESO) -->

    <div class="qcard">

        <div class="qcard-top">
            <div>
                <div class="qcard-value">@totalReservas.ToString("N0")</div>
                <div class="qcard-label">Reservas este mes</div>
            </div>
            <span class="qcard-badge @(porcentajeMeta >= 100 ? "up" : "down")">
                @porcentajeMeta.ToString("0")%
            </span>
        </div>

        <div class="goal-track">
            <div class="goal-fill" style="width:@porcentajeMeta.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
        </div>

        <div class="goal-footer">
            <span>Meta: @metaMensualReservas</span>
            <span>Faltan @faltantesMeta</span>
        </div>

    </div>


    <!-- TARJETA 4: TENDENCIA (ÁREA ANCHA CON FECHAS) -->

    <div class="qcard qcard-wide">

        <div class="qcard-top">
            <div>
                <div class="qcard-value">$@ingresosMes.ToString("N0")</div>
                <div class="qcard-label">Ingresos del mes · @totalPagos pagos</div>
            </div>
            <span class="qcard-badge up">▲ meta 12%</span>
        </div>

        <div class="trend-chart-wrap">

            <svg viewBox="0 0 260 78" preserveAspectRatio="none" style="width:100%; height:78px;">

                <defs>
                    <linearGradient id="qtrendArea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#22c77a" stop-opacity="0.4" />
                        <stop offset="100%" stop-color="#22c77a" stop-opacity="0" />
                    </linearGradient>
                </defs>

                @{
                    var puntosQ = new List<string>();
                    var dataQ = reservasPorDia.Any() ? reservasPorDia : new List<int> { 0, 0, 0, 0, 0, 0, 0 };
                    var maxQ = Math.Max(dataQ.Max(), 1);

                    for (int i = 0; i < dataQ.Count; i++)
                    {
                        double x = dataQ.Count == 1 ? 0 : (260.0 / (dataQ.Count - 1)) * i;
                        double y = 56 - ((dataQ[i] / (double)maxQ) * 46);
                        puntosQ.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");
                    }

                    var lineaQ = string.Join(" ", puntosQ);
                    var areaQ = $"0,56 {lineaQ} 260,56";
                }

                <polygon points="@areaQ" fill="url(#qtrendArea)" />
                <polyline points="@lineaQ" fill="none" stroke="#22c77a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                @for (int i = 0; i < fechasGrafica.Count; i++)
                {
                    double x = fechasGrafica.Count == 1 ? 0 : (260.0 / (fechasGrafica.Count - 1)) * i;
                    string fechaTxt = fechasGrafica[i].ToString("dd/MM", new System.Globalization.CultureInfo("es-CO"));

                    @Html.Raw($"<text x=\"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"70\" fill=\"#718097\" font-size=\"7\" text-anchor=\"middle\">{fechaTxt}</text>")
                }

            </svg>

        </div>

    </div>

</div>


<!-- =====================================================
     SECCIÓN INFERIOR: TABLA + INGRESOS
     ===================================================== -->

<div class="bottom-section">


    <!-- =================================================
         RESERVAS RECIENTES CON PESTAÑAS
         ================================================= -->

    <div class="panel">

        <div class="panel-header">
            <div>
                <div class="panel-title">Reservas recientes</div>
                <div class="panel-subtitle">Últimas reservas registradas en Sportia</div>
            </div>

            <a asp-controller="Reservas" asp-action="Index" class="panel-button">Ver todas</a>
        </div>

        <div class="filter-tabs">
            <div class="filter-tab active">Todas</div>

            @foreach (var esc in escenariosMasReservados.Take(4))
            {
                <div class="filter-tab">@esc.Nombre</div>
            }
        </div>

        <div class="table-wrapper">

            <table class="reservations-table">

                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Escenario</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th style="text-align:right;">Total</th>
                    </tr>
                </thead>

                <tbody>

                    @if (reservasRecientes.Any())
                    {
                        foreach (var reserva in reservasRecientes)
                        {
                            var cliente = reserva.IdClienteNavigation;
                            var escenario = reserva.IdEscenarioNavigation;
                            var estado = reserva.IdEstadoNavigation;

                            string nombreCliente = cliente != null
                                ? $"{cliente.Nombres} {cliente.Apellidos}"
                                : "Sin cliente";

                            string iniciales = "CL";
                            if (cliente != null)
                            {
                                string primera = string.IsNullOrWhiteSpace(cliente.Nombres) ? "" : cliente.Nombres.Substring(0, 1);
                                string segunda = string.IsNullOrWhiteSpace(cliente.Apellidos) ? "" : cliente.Apellidos.Substring(0, 1);
                                iniciales = $"{primera}{segunda}".ToUpper();
                            }

                            string nombreEstado = estado?.Nombre ?? "Sin estado";

                            string claseEstado = nombreEstado.ToLower().Contains("cancel")
                                ? "status-red"
                                : nombreEstado.ToLower().Contains("pend")
                                    ? "status-orange"
                                    : "status-green";

                            <tr>
                                <td>
                                    <div class="client">
                                        <div class="client-avatar">@iniciales</div>
                                        <div>
                                            @nombreCliente
                                            <div class="client-sub">@reserva.HoraInicio.ToString("hh\\:mm")</div>
                                        </div>
                                    </div>
                                </td>

                                <td>@(escenario?.Nombre ?? "Sin escenario")</td>

                                <td>@reserva.FechaUso.ToString("dd/MM/yyyy")</td>

                                <td><span class="status @claseEstado">@nombreEstado</span></td>

                                <td style="text-align:right;" class="total-cell">
                                    $@reserva.ValorTotal.ToString("N0")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; color:#718097;">
                                No hay reservas registradas.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =================================================
         PANEL DE INGRESOS (ÁREA)
         ================================================= -->

    <div class="panel">

        <div class="panel-header">
            <div>
                <div class="panel-title">Ingresos del mes</div>
                <div class="panel-subtitle">@totalPagos pagos registrados</div>
            </div>
        </div>

        <div class="revenue-value">$@ingresosMes.ToString("N0")</div>
        <div class="revenue-sub">Facturación acumulada del mes actual</div>

        <div class="revenue-chart-wrap">

            <svg viewBox="0 0 320 140" preserveAspectRatio="none" style="width:100%; height:160px;">

                <defs>
                    <linearGradient id="revenueArea" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.45" />
                        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                    </linearGradient>
                </defs>

                @{
                    var lineaGridY = new[] { 20, 55, 90, 125 };
                }

                @foreach (var gy in lineaGridY)
                {
                    <line x1="0" y1="@gy" x2="320" y2="@gy" stroke="#1b2942" stroke-width="1" stroke-dasharray="4 4" />
                }

                @{
                    var dataRev = reservasPorDia.Any() ? reservasPorDia : new List<int> { 0, 0, 0, 0, 0, 0, 0 };
                    var maxRev = Math.Max(dataRev.Max(), 1);
                    var puntosRev = new List<string>();

                    for (int i = 0; i < dataRev.Count; i++)
                    {
                        double x = dataRev.Count == 1 ? 0 : (320.0 / (dataRev.Count - 1)) * i;
                        double y = 125 - ((dataRev[i] / (double)maxRev) * 95);
                        puntosRev.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");
                    }

                    var lineaRev = string.Join(" ", puntosRev);
                    var areaRev = $"0,125 {lineaRev} 320,125";
                }

                <polygon points="@areaRev" fill="url(#revenueArea)" />
                <polyline points="@lineaRev" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                @for (int i = 0; i < fechasGrafica.Count; i++)
                {
                    double x = fechasGrafica.Count == 1 ? 0 : (320.0 / (fechasGrafica.Count - 1)) * i;
                    string fechaTxt = fechasGrafica[i].ToString("ddd", new System.Globalization.CultureInfo("es-CO"));

                    @Html.Raw($"<text x=\"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"138\" fill=\"#718097\" font-size=\"9\" text-anchor=\"middle\">{fechaTxt}</text>")
                }

            </svg>

        </div>

    </div>

</div>


<script>
    // Tabs de rango (Hoy / 7 días / 30 días / Año) - visuales por ahora
    document.querySelectorAll('.range-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.range-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // Tabs de filtro de reservas por escenario - visuales por ahora
    document.querySelectorAll('.filter-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
        });
    });
</script>
