@model Sportia.Models.Pago

@{
    ViewData["Title"] = "Registrar pago";
    Layout = "_DashboardLayout";
}

<div class="mx-auto max-w-3xl">

    <div class="mb-6">

        <a asp-action="Index"
           class="text-sm text-slate-400 hover:text-white">

            ← Volver a pagos

        </a>

        <h1 class="mt-3 text-2xl font-bold text-white">
            Registrar pago
        </h1>

        <p class="mt-1 text-sm text-slate-400">
            Registra un pago realizado para una reserva
        </p>

    </div>


    <form asp-action="Create"
          method="post"
          class="space-y-6">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm text-red-400">
        </div>


        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">

            <div class="space-y-5">

                <!-- RESERVA -->

                <div>

                    <label asp-for="IdReserva"
                           class="mb-2 block text-sm font-semibold text-white">

                        Reserva

                    </label>

                    <select asp-for="IdReserva"
                            asp-items="ViewBag.Reservas"
                            class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-emerald-500">

                        <option value="">
                            Seleccione una reserva
                        </option>

                    </select>

                    <span asp-validation-for="IdReserva"
                          class="mt-1 block text-sm text-red-400">
                    </span>

                </div>


                <!-- METODO -->

                <div>

                    <label asp-for="IdMetodo"
                           class="mb-2 block text-sm font-semibold text-white">

                        Método de pago

                    </label>

                    <select asp-for="IdMetodo"
                            asp-items="ViewBag.MetodosPago"
                            class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-emerald-500">

                        <option value="">
                            Seleccione un método
                        </option>

                    </select>

                    <span asp-validation-for="IdMetodo"
                          class="mt-1 block text-sm text-red-400">
                    </span>

                </div>


                <!-- MONTO -->

                <div>

                    <label asp-for="MontoPagado"
                           class="mb-2 block text-sm font-semibold text-white">

                        Monto pagado

                    </label>

                    <input asp-for="MontoPagado"
                           type="number"
                           step="0.01"
                           min="1"
                           placeholder="Ejemplo: 50000"
                           class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-emerald-500" />

                    <span asp-validation-for="MontoPagado"
                          class="mt-1 block text-sm text-red-400">
                    </span>

                </div>


                <!-- COMPROBANTE -->

                <div>

                    <label asp-for="Comprobante"
                           class="mb-2 block text-sm font-semibold text-white">

                        Comprobante

                        <span class="font-normal text-slate-500">
                            (Opcional)
                        </span>

                    </label>

                    <input asp-for="Comprobante"
                           placeholder="Número de referencia o comprobante"
                           class="w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-emerald-500" />

                </div>

            </div>

        </div>


        <!-- BOTONES -->

        <div class="flex justify-end gap-3">

            <a asp-action="Index"
               class="rounded-xl border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-300 hover:bg-slate-800">

                Cancelar

            </a>

            <button type="submit"
                    class="rounded-xl bg-emerald-500 px-6 py-3 text-sm font-bold text-slate-950 hover:bg-emerald-400">

                Registrar pago

            </button>

        </div>

    </form>

</div>