@model Sportia.Models.Cliente

@{
    ViewData["Title"] = "Detalle del cliente";
    Layout = "_DashboardLayout";
}

<div class="mx-auto max-w-5xl space-y-6">

    <!-- ENCABEZADO -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div class="flex items-center gap-4">

            <a asp-controller="AdminCliente"
               asp-action="Index"
               class="flex h-10 w-10 items-center justify-center rounded-xl
                border border-slate-800 bg-slate-900
                text-slate-400 transition
                hover:bg-slate-800 hover:text-white">

                <svg class="h-5 w-5"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                    <path d="m15 18-6-6 6-6" />

                </svg>

            </a>

            <div>
                <h1 class="text-2xl font-bold text-white">
                    Detalle del cliente
                </h1>

                <p class="text-sm text-slate-400">
                    Información registrada del cliente
                </p>
            </div>

        </div>

        <!-- BOTÓN EDITAR -->
        <a asp-controller="AdminCliente"
           asp-action="Edit"
           asp-route-id="@Model.IdCliente"
           class="inline-flex items-center justify-center gap-2
            rounded-xl bg-emerald-500 px-5 py-3
            text-sm font-bold text-slate-950
            transition hover:bg-emerald-400">

            <svg class="h-5 w-5"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 viewBox="0 0 24 24">

                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

            </svg>

            Editar cliente

        </a>

    </div>


    <!-- TARJETA PRINCIPAL -->
    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70">

        <!-- PERFIL -->
        <div class="border-b border-slate-800 px-6 py-7">

            <div class="flex flex-col gap-5 sm:flex-row sm:items-center">

                <!-- AVATAR -->
                <div class="flex h-20 w-20 shrink-0 items-center justify-center
                    rounded-2xl bg-emerald-500/10
                    text-3xl font-bold text-emerald-400">

                    @(string.IsNullOrWhiteSpace(Model.Nombres)
                        ? "?"
                        : Model.Nombres.Substring(0, 1).ToUpper())

                </div>


                <!-- NOMBRE -->
                <div class="flex-1">

                    <div class="flex flex-wrap items-center gap-3">

                        <h2 class="text-2xl font-bold text-white">
                            @Model.Nombres @Model.Apellidos
                        </h2>

                        <span class="rounded-full border border-emerald-500/20
                            bg-emerald-500/10 px-3 py-1
                            text-xs font-semibold text-emerald-400">

                            Cliente

                        </span>

                    </div>

                    <p class="mt-1 text-sm text-slate-500">
                        Cliente #@Model.IdCliente
                    </p>

                </div>

            </div>

        </div>


        <!-- INFORMACIÓN -->
        <div class="p-6">

            <h3 class="mb-5 text-lg font-bold text-white">
                Información personal
            </h3>


            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">


                <!-- DOCUMENTO -->
                <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">

                    <div class="flex items-start gap-4">

                        <div class="flex h-10 w-10 shrink-0 items-center justify-center
                            rounded-xl bg-blue-500/10 text-blue-400">

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 viewBox="0 0 24 24">

                                <path d="M6 2h9l3 3v17H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" />
                                <path d="M14 2v4h4" />
                                <path d="M8 11h8" />
                                <path d="M8 15h8" />

                            </svg>

                        </div>

                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Documento
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.Documento))
                            {
                                <p class="mt-1 text-sm font-semibold text-white">
                                    @Model.Documento
                                </p>
                            }
                            else
                            {
                                <p class="mt-1 text-sm text-slate-600">
                                    No registrado
                                </p>
                            }
                        </div>

                    </div>

                </div>


                <!-- TELEFONO -->
                <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">

                    <div class="flex items-start gap-4">

                        <div class="flex h-10 w-10 shrink-0 items-center justify-center
                            rounded-xl bg-purple-500/10 text-purple-400">

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 viewBox="0 0 24 24">

                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                19.79 19.79 0 0 1-8.63-3.07
                                19.5 19.5 0 0 1-6-6
                                19.79 19.79 0 0 1-3.07-8.67
                                A2 2 0 0 1 4.11 2h3
                                a2 2 0 0 1 2 1.72
                                12.84 12.84 0 0 0 .7 2.81
                                2 2 0 0 1-.45 2.11L8.09 9.91
                                a16 16 0 0 0 6 6l1.27-1.27
                                a2 2 0 0 1 2.11-.45
                                12.84 12.84 0 0 0 2.81.7
                                A2 2 0 0 1 22 16.92z" />

                            </svg>

                        </div>

                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Teléfono
                            </p>

                            <p class="mt-1 text-sm font-semibold text-white">
                                @Model.Telefono
                            </p>
                        </div>

                    </div>

                </div>


                <!-- CORREO -->
                <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">

                    <div class="flex items-start gap-4">

                        <div class="flex h-10 w-10 shrink-0 items-center justify-center
                            rounded-xl bg-emerald-500/10 text-emerald-400">

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 viewBox="0 0 24 24">

                                <rect x="3" y="5" width="18" height="14" rx="2" />
                                <path d="m3 7 9 6 9-6" />

                            </svg>

                        </div>

                        <div class="min-w-0">

                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Correo electrónico
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.Correo))
                            {
                                <p class="mt-1 truncate text-sm font-semibold text-white">
                                    @Model.Correo
                                </p>
                            }
                            else
                            {
                                <p class="mt-1 text-sm text-slate-600">
                                    No registrado
                                </p>
                            }

                        </div>

                    </div>

                </div>


                <!-- FECHA REGISTRO -->
                <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">

                    <div class="flex items-start gap-4">

                        <div class="flex h-10 w-10 shrink-0 items-center justify-center
                            rounded-xl bg-orange-500/10 text-orange-400">

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 viewBox="0 0 24 24">

                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                <path d="M16 2v4" />
                                <path d="M8 2v4" />
                                <path d="M3 10h18" />

                            </svg>

                        </div>

                        <div>

                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                                Fecha de registro
                            </p>

                            <p class="mt-1 text-sm font-semibold text-white">
                                @(Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")
                                    ?? "Sin fecha")
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- RESERVAS -->
            <div class="mt-8">

                <div class="mb-4 flex items-center justify-between">

                    <div>
                        <h3 class="text-lg font-bold text-white">
                            Reservas
                        </h3>

                        <p class="text-sm text-slate-500">
                            Reservas asociadas a este cliente
                        </p>
                    </div>

                    <span class="rounded-full border border-blue-500/20
                        bg-blue-500/10 px-3 py-1
                        text-xs font-semibold text-blue-400">

                        @Model.Reservas.Count reserva(s)

                    </span>

                </div>


                @if (Model.Reservas.Any())
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-800">

                        <table class="w-full min-w-[700px]">

                            <thead class="border-b border-slate-800 bg-slate-950/60">

                                <tr>

                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Código
                                    </th>

                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Fecha de uso
                                    </th>

                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Hora
                                    </th>

                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Valor
                                    </th>

                                </tr>

                            </thead>

                            <tbody class="divide-y divide-slate-800">

                                @foreach (var reserva in Model.Reservas)
                                {
                                    <tr class="transition hover:bg-slate-800/40">

                                        <td class="px-5 py-4 text-sm font-semibold text-white">
                                            @reserva.Codigo
                                        </td>

                                        <td class="px-5 py-4 text-sm text-slate-400">
                                            @reserva.FechaUso.ToString("dd/MM/yyyy")
                                        </td>

                                        <td class="px-5 py-4 text-sm text-slate-400">
                                            @reserva.HoraInicio.ToString(@"hh\:mm")
                                            -
                                            @reserva.HoraFin.ToString(@"hh\:mm")
                                        </td>

                                        <td class="px-5 py-4 text-sm font-semibold text-emerald-400">
                                            $@reserva.ValorTotal
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="rounded-xl border border-slate-800
                        bg-slate-950/40 px-6 py-10 text-center">

                        <svg class="mx-auto h-10 w-10 text-slate-600"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">

                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <path d="M16 2v4" />
                            <path d="M8 2v4" />
                            <path d="M3 10h18" />

                        </svg>

                        <p class="mt-3 text-sm font-semibold text-slate-400">
                            Este cliente todavía no tiene reservas
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- BOTÓN VOLVER -->
    <div class="flex justify-end">

        <a asp-controller="AdminCliente"
           asp-action="Index"
           class="inline-flex items-center gap-2 rounded-xl
            border border-slate-700 px-5 py-3
            text-sm font-semibold text-slate-400
            transition hover:bg-slate-800 hover:text-white">

            Volver a clientes

        </a>

    </div>

</div>