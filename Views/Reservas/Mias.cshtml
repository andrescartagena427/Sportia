@using System.Globalization
@model Sportia.Models.ViewModels.MisReservasViewModel

@{
    ViewData["Title"] = "Mis reservas";
    Layout = "_ClienteLayout";

    var co = new CultureInfo("es-CO");
    var total = Model.Proximas.Count + Model.Pasadas.Count + Model.Canceladas.Count;
}

@functions {
    string Dinero(decimal valor) => "$" + valor.ToString("N0", new CultureInfo("es-CO"));

    string Fecha(DateOnly fecha)
    {
        var texto = fecha.ToString("ddd d 'de' MMM yyyy", new CultureInfo("es-CO")).Replace(".", "");
        return char.ToUpper(texto[0]) + texto[1..];
    }

    string Hora(TimeOnly hora) => hora.ToString("h:mm tt", new CultureInfo("en-US")).Replace("AM", "a. m.").Replace("PM", "p. m.");

    string ClaseEstado(string estado)
    {
        var e = (estado ?? "").ToLowerInvariant();
        if (e.Contains("confirm") || e.Contains("pagad") || e.Contains("complet")) return "border-emerald-500/40 bg-emerald-500/15 text-emerald-300";
        if (e.Contains("pend")) return "border-amber-500/40 bg-amber-500/15 text-amber-300";
        if (e.Contains("cancel")) return "border-red-500/40 bg-red-500/15 text-red-300";
        return "border-sky-500/40 bg-sky-500/15 text-sky-300";
    }

    string ImagenDe(Sportia.Models.ViewModels.MiReservaViewModel r)
    {
        if (!string.IsNullOrWhiteSpace(r.Imagen)) return r.Imagen!;
        return ImagenPorTipo(r.Tipo);
    }

    string ImagenPorTipo(string? tipo)
    {
        var t = (tipo ?? "").ToLowerInvariant();
        if (t.Contains("balon") || t.Contains("basket")) return "https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&w=600&q=70";
        if (t.Contains("tenis")) return "https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=600&q=70";
        return "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=600&q=70";
    }
}

<main class="mx-auto max-w-[1200px] px-4 py-8 sm:px-6 lg:px-8">

    <!-- Encabezado -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a asp-controller="Cliente" asp-action="Index" class="inline-flex items-center gap-1.5 text-sm text-slate-400 transition hover:text-emerald-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                Volver al panel
            </a>
            <h1 class="mt-2 text-3xl font-black tracking-tight">Mis reservas</h1>
            <p class="mt-1 text-slate-400">Consulta tus reservas, su estado de pago y cancela si lo necesitas.</p>
        </div>
        <a asp-controller="Cliente" asp-action="Index" asp-fragment="escenarios"
           class="inline-flex h-11 w-fit items-center gap-2 rounded-xl bg-emerald-500 px-5 text-sm font-bold text-white shadow-lg shadow-emerald-500/20 transition hover:-translate-y-0.5 hover:bg-emerald-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            Nueva reserva
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["MensajeReserva"] != null)
    {
        <div class="mt-6 flex items-start gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-4 text-sm font-semibold text-emerald-300" role="status">
            <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg>
            <span>@TempData["MensajeReserva"]</span>
        </div>
    }
    @if (TempData["ErrorReserva"] != null)
    {
        <div class="mt-6 flex items-start gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm font-semibold text-red-300" role="alert">
            <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
            <span>@TempData["ErrorReserva"]</span>
        </div>
    }

    <!-- Resumen -->
    <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-sm text-slate-400">Próximas</p>
            <p class="mt-1 text-3xl font-black text-emerald-400">@Model.Proximas.Count</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-sm text-slate-400">Jugadas</p>
            <p class="mt-1 text-3xl font-black">@Model.Pasadas.Count</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-sm text-slate-400">Canceladas</p>
            <p class="mt-1 text-3xl font-black text-red-400">@Model.Canceladas.Count</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
            <p class="text-sm text-slate-400">Total en reservas</p>
            <p class="mt-1 truncate text-2xl font-black sm:text-3xl">@Dinero(Model.TotalInvertido)</p>
        </div>
    </div>

    @if (total == 0)
    {
        <div class="mt-8 rounded-2xl border border-dashed border-white/15 bg-slate-900/40 p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            <h2 class="mt-4 text-xl font-bold">Aún no tienes reservas</h2>
            <p class="mt-1 text-slate-400">Elige un escenario y reserva tu primer partido.</p>
            <a asp-controller="Cliente" asp-action="Index" asp-fragment="escenarios"
               class="mt-6 inline-flex rounded-xl bg-emerald-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-400">
                Buscar escenario
            </a>
        </div>
    }
    else
    {
        <!-- Pestañas -->
        <div class="mt-8 flex gap-2 overflow-x-auto border-b border-white/10" role="tablist">
            <button type="button" role="tab" data-pestana="proximas" aria-selected="true"
                    class="pestana -mb-px whitespace-nowrap border-b-2 border-emerald-400 px-4 py-3 text-sm font-semibold text-white">
                Próximas <span class="ml-1 rounded-full bg-white/10 px-2 py-0.5 text-xs">@Model.Proximas.Count</span>
            </button>
            <button type="button" role="tab" data-pestana="pasadas" aria-selected="false"
                    class="pestana -mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-400 hover:text-white">
                Historial <span class="ml-1 rounded-full bg-white/10 px-2 py-0.5 text-xs">@Model.Pasadas.Count</span>
            </button>
            <button type="button" role="tab" data-pestana="canceladas" aria-selected="false"
                    class="pestana -mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-400 hover:text-white">
                Canceladas <span class="ml-1 rounded-full bg-white/10 px-2 py-0.5 text-xs">@Model.Canceladas.Count</span>
            </button>
        </div>

        @foreach (var grupo in new[] { ("proximas", Model.Proximas, "No tienes reservas próximas."), ("pasadas", Model.Pasadas, "Todavía no has jugado ningún partido."), ("canceladas", Model.Canceladas, "No tienes reservas canceladas.") })
        {
            <section data-panel="@grupo.Item1" class="panel-reservas mt-6 space-y-4 @(grupo.Item1 == "proximas" ? "" : "hidden")">

                @if (!grupo.Item2.Any())
                {
                    <p class="rounded-2xl border border-white/10 bg-slate-900/40 p-8 text-center text-slate-400">@grupo.Item3</p>
                }

                @foreach (var r in grupo.Item2)
                {
                    bool esNueva = Model.IdReservaNueva == r.IdReserva;

                    <article id="reserva-@r.IdReserva"
                             class="overflow-hidden rounded-2xl border bg-slate-900/60 transition @(esNueva ? "border-emerald-500/60 ring-2 ring-emerald-500/30" : "border-white/10") @(r.Cancelada ? "opacity-75" : "")">
                        <div class="flex flex-col sm:flex-row">

                            <div class="relative h-40 shrink-0 sm:h-auto sm:w-56">
                                <img src="@ImagenDe(r)" alt="@r.Escenario" loading="lazy" onerror="this.onerror=null;this.src='@ImagenPorTipo(r.Tipo)';" class="absolute inset-0 h-full w-full object-cover @(r.Cancelada ? "grayscale" : "")" />
                                @if (esNueva)
                                {
                                    <span class="absolute left-3 top-3 rounded-full bg-emerald-500 px-2.5 py-1 text-xs font-bold text-white">Nueva</span>
                                }
                            </div>

                            <div class="flex min-w-0 flex-1 flex-col gap-4 p-5 lg:flex-row lg:items-center">

                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="rounded-full border px-2.5 py-0.5 text-xs font-semibold @ClaseEstado(r.Estado)">@r.Estado</span>
                                        @if (!string.IsNullOrWhiteSpace(r.Tipo))
                                        {
                                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">@r.Tipo</span>
                                        }
                                        <span class="text-xs text-slate-500">@r.Codigo</span>
                                    </div>

                                    <h3 class="mt-2 truncate text-lg font-bold">@r.Escenario</h3>
                                    @if (!string.IsNullOrWhiteSpace(r.Ubicacion))
                                    {
                                        <p class="truncate text-sm text-slate-400">@r.Ubicacion</p>
                                    }

                                    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-300">
                                        <span class="flex items-center gap-1.5">
                                            <svg class="h-4 w-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                            @Fecha(r.FechaUso)
                                        </span>
                                        <span class="flex items-center gap-1.5">
                                            <svg class="h-4 w-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                            @Hora(r.HoraInicio) – @Hora(r.HoraFin)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(r.MetodoPago))
                                        {
                                            <span class="flex items-center gap-1.5">
                                                <svg class="h-4 w-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
                                                @r.MetodoPago
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="flex shrink-0 flex-col gap-3 border-t border-white/10 pt-4 lg:w-56 lg:border-l lg:border-t-0 lg:pl-5 lg:pt-0">
                                    <div>
                                        <p class="text-xs text-slate-400">Total</p>
                                        <p class="text-xl font-black">@Dinero(r.ValorTotal)</p>
                                        @if (!r.Cancelada)
                                        {
                                            @if (r.Saldo > 0)
                                            {
                                                <p class="text-xs text-amber-300">Saldo pendiente: @Dinero(r.Saldo)</p>
                                            }
                                            else
                                            {
                                                <p class="text-xs text-emerald-300">Pagada</p>
                                            }
                                        }
                                    </div>

                                    @if (r.PuedeCancelar)
                                    {
                                        <div class="zona-cancelar">
                                            <button type="button" data-pedir-cancelar
                                                    class="w-full rounded-xl border border-red-500/40 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-red-500/10">
                                                Cancelar reserva
                                            </button>
                                            <form asp-controller="Reservas" asp-action="CancelarMia" asp-route-id="@r.IdReserva" method="post"
                                                  class="confirmar-cancelar hidden rounded-xl border border-red-500/40 bg-red-500/10 p-3">
                                                @Html.AntiForgeryToken()
                                                <p class="text-xs font-semibold text-red-200">¿Seguro que quieres cancelarla? El horario quedará libre.</p>
                                                <div class="mt-2 flex gap-2">
                                                    <button type="submit" class="flex-1 rounded-lg bg-red-500 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-red-400">Sí, cancelar</button>
                                                    <button type="button" data-no-cancelar class="flex-1 rounded-lg border border-white/15 px-3 py-1.5 text-xs font-semibold text-slate-300 transition hover:text-white">No</button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else if (grupo.Item1 == "proximas")
                                    {
                                        <p class="text-xs text-slate-500">Para cancelar con menos de @Model.HorasMinimasParaCancelar horas, <a asp-controller="Contacto" asp-action="Index" class="text-emerald-400 hover:underline">escríbenos</a>.</p>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cliente" asp-action="Reservar" asp-route-idEscenario="@r.IdEscenario"
                                           class="rounded-xl border border-emerald-500/40 px-4 py-2 text-center text-sm font-semibold text-emerald-300 transition hover:bg-emerald-500/10">
                                            Reservar de nuevo
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
    }
</main>

<script>
    (() => {
        // Pestañas
        const pestanas = document.querySelectorAll('.pestana');
        const paneles = document.querySelectorAll('.panel-reservas');

        function abrir(nombre) {
            pestanas.forEach(p => {
                const activa = p.dataset.pestana === nombre;
                p.setAttribute('aria-selected', activa);
                p.classList.toggle('border-emerald-400', activa);
                p.classList.toggle('text-white', activa);
                p.classList.toggle('border-transparent', !activa);
                p.classList.toggle('text-slate-400', !activa);
            });
            paneles.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== nombre));
        }

        pestanas.forEach(p => p.addEventListener('click', () => abrir(p.dataset.pestana)));

        // Confirmación para cancelar (sin ventanas emergentes del navegador)
        document.querySelectorAll('.zona-cancelar').forEach(zona => {
            const pedir = zona.querySelector('[data-pedir-cancelar]');
            const confirmar = zona.querySelector('.confirmar-cancelar');
            pedir.addEventListener('click', () => { pedir.classList.add('hidden'); confirmar.classList.remove('hidden'); });
            zona.querySelector('[data-no-cancelar]').addEventListener('click', () => { confirmar.classList.add('hidden'); pedir.classList.remove('hidden'); });
        });

        // Llevar a la vista la reserva recién creada
        const nueva = document.querySelector('[id^="reserva-"].ring-2');
        if (nueva) nueva.scrollIntoView({ behavior: 'smooth', block: 'center' });
    })();
</script>
