    string icoBalon = $"<svg {svgAttr}><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7.5l3.4 2.5-1.3 4h-4.2l-1.3-4z\"/><path d=\"M12 3v4.5M15.4 10l4.3-1.6M14.1 14l2.6 3.8M9.9 14l-2.6 3.8M8.6 10L4.3 8.4\"/></svg>";
