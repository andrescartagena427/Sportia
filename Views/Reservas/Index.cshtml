@model Sportia.Models.ViewModels.AdminReservasViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var co = new CultureInfo("es-CO");
    string Dinero(decimal v) => "$ " + v.ToString("N0", co);

    // Enlace a esta misma página conservando los filtros
    string UrlPagina(int pagina) => Url.Action("Index", "Reservas", new
    {
        buscar = Model.Buscar,
        desde = Model.Desde.ToString("yyyy-MM-dd"),
        hasta = Model.Hasta.ToString("yyyy-MM-dd"),
        estado = Model.IdEstado,
        escenario = Model.IdEscenario,
        pagina
    }) ?? "#";

    string urlActual = UrlPagina(Model.Pagina);

    string ClaseEstado(string e)
    {
        var x = e.ToLower();
        if (x.Contains("confirm")) return "chip-ok";
        if (x.Contains("pend")) return "chip-pend";
        if (x.Contains("cancel")) return "chip-cancel";
        return "chip-otro";
    }

    string ColorAvatar(string nombre)
    {
        string[] colores = { "#7c5cff", "#2f80ed", "#f59e0b", "#e8508a", "#14b88a", "#0ea5c6" };
        int h = 0;
        foreach (char c in nombre) h = (h * 31 + c) & 0x7fffffff;
        return colores[h % colores.Length];
    }

    // Tipo de icono según el tipo o el nombre del escenario
    string TipoIcono(string tipo, string nombre)
    {
        var x = (tipo + " " + nombre).ToLower();
        if (x.Contains("tenis") || x.Contains("pádel") || x.Contains("padel")) return "raqueta";
        if (x.Contains("balonc") || x.Contains("basket")) return "basket";
        if (x.Contains("fútbol") || x.Contains("futbol") || x.Contains("micro") || x.Contains("sintética") || x.Contains("sintetica")) return "balon";
        return "cancha";
    }

    string selEstado = Model.IdEstado.HasValue
        ? Model.Estados.FirstOrDefault(e => e.IdEstado == Model.IdEstado)?.Nombre ?? "Todos"
        : "Todos";
    string selEscenario = Model.IdEscenario.HasValue
        ? Model.Escenarios.FirstOrDefault(e => e.IdEscenario == Model.IdEscenario)?.Nombre ?? "Todos"
        : "Todos";
}

@functions {
    // Línea "↑ 22% que el mes anterior" de cada tarjeta
    private Microsoft.AspNetCore.Html.IHtmlContent Variacion(double? v, string texto)
    {
        string html;
        if (v == null)
        {
            html = $"<span class=\"kpi-var sube\">Nuevo</span> {texto.Replace("que el", "frente al")}";
        }
        else if (v >= 0)
        {
            html = $"<span class=\"kpi-var sube\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg>{v:0}%</span> {texto}";
        }
        else
        {
            html = $"<span class=\"kpi-var baja\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12l7 7 7-7\"/></svg>{Math.Abs(v.Value):0}%</span> {texto}";
        }
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}

<style>
    .rv {
        --rv-bg: #0b1424;
        --rv-card: #0f1a2c;
        --rv-borde: #1e2c44;
        --rv-borde-2: #263650;
        --rv-texto: #eef3fa;
        --rv-suave: #a3b0c4;
        --rv-tenue: #6b7a92;
        --rv-verde: #22d39a;
        --rv-verde-2: #17b884;
        --rv-ambar: #f5b031;
        --rv-rojo: #f05d6c;
        width: 100%;
        color: var(--rv-texto);
    }

    .rv *, .rv *::before, .rv *::after { box-sizing: border-box; }
    .rv svg { flex-shrink: 0; }

    /* ---------- Mensajes ---------- */
    .rv-alerta {
        display: flex; align-items: center; gap: 12px;
        margin-bottom: 18px; padding: 13px 16px;
        border-radius: 12px; font-size: 13px;
    }
    .rv-alerta.ok { background: rgba(34, 211, 154, .10); border: 1px solid rgba(34, 211, 154, .30); color: var(--rv-verde); }
    .rv-alerta.error { background: rgba(240, 93, 108, .10); border: 1px solid rgba(240, 93, 108, .30); color: var(--rv-rojo); }
    .rv-alerta svg { width: 18px; height: 18px; }

    /* ---------- Encabezado con cancha ---------- */
    .rv-hero {
        position: relative; overflow: hidden;
        display: flex; align-items: center; justify-content: space-between; gap: 20px;
        min-height: 128px; padding: 26px 30px; margin-bottom: 22px;
        border-radius: 18px; border: 1px solid var(--rv-borde);
        background:
            radial-gradient(120% 140% at 85% 0%, rgba(34, 211, 154, .16) 0%, rgba(34, 211, 154, 0) 55%),
            linear-gradient(100deg, #0c1628 0%, #0c1628 38%, #0d2a24 72%, #10382c 100%);
    }
    .rv-hero-cancha {
        position: absolute; right: -40px; top: -10px; bottom: -10px;
        width: 62%; pointer-events: none;
        -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
        mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
    }
    .rv-hero-cancha svg { width: 100%; height: 100%; }
    .rv-hero-izq { position: relative; display: flex; align-items: center; gap: 22px; z-index: 1; }
    .rv-hero-icono {
        width: 66px; height: 66px; border-radius: 16px;
        display: grid; place-items: center;
        background: linear-gradient(145deg, #2ee6ac, #14a978);
        box-shadow: 0 10px 30px rgba(34, 211, 154, .25);
        color: #062519;
    }
    .rv-hero-icono svg { width: 32px; height: 32px; }
    .rv-hero h1 { margin: 0; font-size: 34px; line-height: 1.1; font-weight: 800; letter-spacing: -.5px; color: #fff; }
    .rv-hero p { margin: 6px 0 0; font-size: 14px; color: var(--rv-suave); }

    .rv-btn-nueva {
        position: relative; z-index: 1;
        display: inline-flex; align-items: center; gap: 10px;
        padding: 14px 22px; border-radius: 12px;
        background: linear-gradient(135deg, #2ee6ac, #19c48d);
        color: #04241a; font-size: 14px; font-weight: 800;
        text-decoration: none; white-space: nowrap;
        box-shadow: 0 8px 24px rgba(34, 211, 154, .28);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .rv-btn-nueva:hover { color: #04241a; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(34, 211, 154, .38); }
    .rv-btn-nueva svg { width: 20px; height: 20px; }

    /* ---------- Tarjetas ---------- */
    .rv-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .rv-kpi {
        display: flex; gap: 16px; padding: 20px;
        border-radius: 16px; border: 1px solid;
        min-width: 0;
    }
    .rv-kpi-icono { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; }
    .rv-kpi-icono svg { width: 24px; height: 24px; }
    .rv-kpi-num { font-size: 26px; font-weight: 800; line-height: 1.15; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rv-kpi-label { margin-top: 4px; font-size: 14px; color: #d4dceb; }
    .rv-kpi-pie { margin-top: 10px; font-size: 12px; color: var(--rv-suave); }
    .kpi-var { display: inline-flex; align-items: center; gap: 2px; font-weight: 700; }
    .kpi-var svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .kpi-var.sube { color: var(--rv-verde); }
    .kpi-var.baja { color: var(--rv-rojo); }

    .rv-kpi.verde { background: linear-gradient(160deg, #0f2a26, #0d1f22); border-color: rgba(34, 211, 154, .25); }
    .rv-kpi.verde .rv-kpi-icono { background: linear-gradient(145deg, #2ee6ac, #14a978); color: #062519; }
    .rv-kpi.azul { background: linear-gradient(160deg, #10234a, #0e1a36); border-color: rgba(59, 130, 246, .30); }
    .rv-kpi.azul .rv-kpi-icono { background: linear-gradient(145deg, #4f8cff, #2563eb); color: #fff; }
    .rv-kpi.morado { background: linear-gradient(160deg, #1f1a4a, #171436); border-color: rgba(139, 92, 246, .32); }
    .rv-kpi.morado .rv-kpi-icono { background: linear-gradient(145deg, #9b6bff, #6d3fe0); color: #fff; }
    .rv-kpi.ambar { background: linear-gradient(160deg, #2b2717, #1d1c16); border-color: rgba(245, 176, 49, .30); }
    .rv-kpi.ambar .rv-kpi-icono { background: linear-gradient(145deg, #ffc94a, #e29b12); color: #3a2600; }

    /* ---------- Filtros ---------- */
    .rv-filtros {
        display: grid;
        grid-template-columns: minmax(220px, 1.7fr) minmax(190px, 1fr) minmax(150px, .8fr) minmax(150px, .8fr) auto;
        gap: 12px; margin-bottom: 22px;
    }
    .rv-caja {
        position: relative;
        display: flex; align-items: center; gap: 12px;
        min-height: 64px; padding: 10px 14px;
        background: var(--rv-card); border: 1px solid var(--rv-borde); border-radius: 14px;
        min-width: 0;
    }
    .rv-caja > svg { width: 20px; height: 20px; color: var(--rv-suave); }
    .rv-buscar input {
        flex: 1; min-width: 0; height: 42px; padding: 0 14px 0 44px;
        background: #0a1322; border: 1px solid var(--rv-borde-2); border-radius: 10px;
        color: var(--rv-texto); font-size: 14px; outline: none;
    }
    .rv-buscar input::placeholder { color: var(--rv-tenue); }
    .rv-buscar input:focus { border-color: var(--rv-verde); }
    .rv-buscar > svg { position: absolute; left: 28px; pointer-events: none; }

    .rv-sel { cursor: pointer; transition: border-color .15s ease; }
    .rv-sel:hover, .rv-sel.abierto { border-color: var(--rv-borde-2); }
    .rv-sel-txt { flex: 1; min-width: 0; line-height: 1.35; }
    .rv-sel-txt small { display: block; font-size: 12px; color: var(--rv-texto); font-weight: 600; }
    .rv-sel-txt span { display: block; font-size: 12px; color: var(--rv-suave); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rv-sel .rv-flecha { width: 16px; height: 16px; color: var(--rv-suave); transition: transform .15s ease; }
    .rv-sel.abierto .rv-flecha { transform: rotate(180deg); }
    /* el select real queda invisible encima de la caja */
    .rv-sel select { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .rv-sel select option { background: #0f1a2c; color: #eef3fa; }

    .rv-rango-panel {
        display: none; position: absolute; top: calc(100% + 8px); left: 0; z-index: 30;
        width: 290px; padding: 16px;
        background: #101c30; border: 1px solid var(--rv-borde-2); border-radius: 14px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, .45); cursor: default;
    }
    .rv-sel.abierto .rv-rango-panel { display: block; }
    .rv-rango-panel label { display: block; margin-bottom: 12px; font-size: 12px; color: var(--rv-suave); }
    .rv-rango-panel input[type=date] {
        display: block; width: 100%; margin-top: 6px; height: 40px; padding: 0 10px;
        background: #0a1322; border: 1px solid var(--rv-borde-2); border-radius: 9px;
        color: var(--rv-texto); color-scheme: dark; font-size: 13px;
    }
    .rv-rango-atajos { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
    .rv-rango-atajos button {
        padding: 6px 10px; border-radius: 8px; border: 1px solid var(--rv-borde-2);
        background: transparent; color: var(--rv-suave); font-size: 12px; cursor: pointer;
    }
    .rv-rango-atajos button:hover { color: var(--rv-verde); border-color: var(--rv-verde); }
    .rv-rango-aplicar {
        width: 100%; height: 40px; border: 0; border-radius: 9px;
        background: var(--rv-verde); color: #04241a; font-weight: 800; cursor: pointer;
    }

    .rv-btn-actualizar {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 64px; padding: 0 22px; border-radius: 14px;
        background: transparent; border: 1px solid var(--rv-verde); color: var(--rv-verde);
        font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;
        transition: background .15s ease;
    }
    .rv-btn-actualizar:hover { background: rgba(34, 211, 154, .10); }
    .rv-btn-actualizar svg { width: 18px; height: 18px; }

    /* ---------- Tabla ---------- */
    .rv-tabla-card { background: var(--rv-card); border: 1px solid var(--rv-borde); border-radius: 16px; overflow: hidden; }
    .rv-tabla-wrap { width: 100%; overflow-x: auto; }
    .rv-tabla { width: 100%; min-width: 1050px; border-collapse: collapse; }
    .rv-tabla th {
        padding: 18px 16px; text-align: left;
        font-size: 14px; font-weight: 700; color: #e3e9f3;
        border-bottom: 1px solid var(--rv-borde); white-space: nowrap;
    }
    .rv-tabla td { padding: 12px 16px; font-size: 13px; color: #dbe3ef; border-bottom: 1px solid #18253a; vertical-align: middle; }
    .rv-tabla tbody tr { transition: background .15s ease; }
    .rv-tabla tbody tr:hover { background: #13213a; }
    .rv-tabla tbody tr:last-child td { border-bottom: 0; }
    .rv-tabla th:first-child, .rv-tabla td:first-child { padding-left: 22px; }
    .rv-tabla th:last-child, .rv-tabla td:last-child { padding-right: 22px; }

    .rv-codigo {
        display: inline-block; padding: 6px 9px; border-radius: 8px;
        background: rgba(34, 211, 154, .08); border: 1px solid rgba(34, 211, 154, .22);
        color: var(--rv-verde); font-size: 12px; font-weight: 800; white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }
    .rv-cliente { display: flex; align-items: center; gap: 10px; }
    .rv-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        display: grid; place-items: center; flex-shrink: 0;
        color: #fff; font-size: 12px; font-weight: 800;
    }
    .rv-cliente b { display: block; font-weight: 600; color: #eef3fa; white-space: nowrap; }
    .rv-cliente small { display: block; margin-top: 2px; font-size: 11px; color: var(--rv-tenue); }
    .rv-icono-txt { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; }
    .rv-icono-txt svg { width: 20px; height: 20px; color: #c9d3e2; }
    .rv-icono-txt.suave svg { width: 16px; height: 16px; color: var(--rv-suave); }
    .rv-valor { font-weight: 600; color: #eef3fa; white-space: nowrap; font-variant-numeric: tabular-nums; }

    .rv-chip {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 6px 12px; border-radius: 999px;
        font-size: 12px; font-weight: 700; white-space: nowrap;
    }
    .rv-chip::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .chip-ok { background: rgba(34, 211, 154, .14); color: var(--rv-verde); }
    .chip-pend { background: rgba(245, 176, 49, .15); color: var(--rv-ambar); }
    .chip-cancel { background: rgba(240, 93, 108, .14); color: var(--rv-rojo); }
    .chip-otro { background: rgba(163, 176, 196, .14); color: var(--rv-suave); }

    .rv-acciones { display: flex; align-items: center; gap: 8px; }
    .rv-btn-icono {
        width: 36px; height: 36px; border-radius: 9px;
        display: grid; place-items: center;
        background: #0c1627; border: 1px solid var(--rv-borde-2); color: #d4dceb;
        cursor: pointer; transition: .15s ease;
    }
    .rv-btn-icono:hover { color: var(--rv-verde); border-color: var(--rv-verde); }
    .rv-btn-icono svg { width: 18px; height: 18px; }

    .rv-menu { position: relative; }
    .rv-menu-lista {
        display: none; position: absolute; right: 0; top: calc(100% + 6px); z-index: 40;
        min-width: 230px; padding: 6px;
        background: #101c30; border: 1px solid var(--rv-borde-2); border-radius: 12px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, .45);
    }
    .rv-menu.abierto .rv-menu-lista { display: block; }
    .rv-menu.arriba .rv-menu-lista { top: auto; bottom: calc(100% + 6px); }
    .rv-menu-lista form { margin: 0; }
    .rv-menu-lista button {
        width: 100%; display: flex; align-items: center; gap: 10px;
        padding: 9px 10px; border: 0; border-radius: 8px;
        background: transparent; color: #dbe3ef; font-size: 13px; text-align: left; cursor: pointer; white-space: nowrap;
    }
    .rv-menu-lista button:hover { background: #172741; }
    .rv-menu-lista button svg { width: 16px; height: 16px; }
    .rv-menu-lista .peligro { color: var(--rv-rojo); }

    .rv-pie {
        display: flex; align-items: center; justify-content: space-between; gap: 14px;
        padding: 16px 22px; border-top: 1px solid var(--rv-borde);
        font-size: 13px; color: var(--rv-suave);
    }
    .rv-paginas { display: flex; align-items: center; gap: 8px; }
    .rv-paginas a, .rv-paginas span {
        min-width: 34px; height: 34px; padding: 0 8px;
        display: grid; place-items: center;
        border-radius: 9px; border: 1px solid var(--rv-borde-2);
        background: #0c1627; color: #dbe3ef; font-size: 13px; font-weight: 600;
        text-decoration: none;
    }
    .rv-paginas a:hover { border-color: var(--rv-verde); color: var(--rv-verde); }
    .rv-paginas .actual { background: var(--rv-verde); border-color: var(--rv-verde); color: #04241a; }
    .rv-paginas .apagado { opacity: .4; }
    .rv-paginas svg { width: 16px; height: 16px; }

    .rv-vacio { padding: 64px 20px; text-align: center; }
    .rv-vacio-icono { width: 58px; height: 58px; margin: 0 auto 16px; display: grid; place-items: center; border-radius: 16px; background: rgba(34, 211, 154, .10); color: var(--rv-verde); }
    .rv-vacio-icono svg { width: 28px; height: 28px; }
    .rv-vacio h3 { margin: 0; font-size: 16px; font-weight: 800; color: #fff; }
    .rv-vacio p { margin: 8px 0 0; font-size: 13px; color: var(--rv-suave); }

    /* ---------- Modal de detalle ---------- */
    .rv-modal { display: none; position: fixed; inset: 0; z-index: 100; align-items: center; justify-content: center; padding: 16px; background: rgba(3, 8, 18, .72); }
    .rv-modal.abierto { display: flex; }
    .rv-modal-caja { width: 100%; max-width: 520px; max-height: 92vh; overflow: auto; background: #0f1a2c; border: 1px solid var(--rv-borde-2); border-radius: 18px; box-shadow: 0 30px 60px rgba(0, 0, 0, .5); }
    .rv-modal-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 20px 22px; border-bottom: 1px solid var(--rv-borde); }
    .rv-modal-cab h3 { margin: 0 0 8px; font-size: 18px; font-weight: 800; color: #fff; }
    .rv-modal-cuerpo { padding: 8px 22px 20px; }
    .rv-dato { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid #18253a; font-size: 13px; }
    .rv-dato:last-child { border-bottom: 0; }
    .rv-dato span { color: var(--rv-suave); }
    .rv-dato b { color: #eef3fa; font-weight: 600; text-align: right; word-break: break-word; }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1280px) {
        .rv-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .rv-filtros { grid-template-columns: 1fr 1fr; }
        .rv-buscar { grid-column: 1 / -1; }
        .rv-btn-actualizar { min-height: 52px; }
    }
    @@media (max-width: 760px) {
        .rv-hero { flex-direction: column; align-items: flex-start; padding: 22px; }
        .rv-hero h1 { font-size: 28px; }
        .rv-hero-cancha { width: 100%; opacity: .5; }
        .rv-btn-nueva { width: 100%; justify-content: center; }
        .rv-kpis, .rv-filtros { grid-template-columns: 1fr; }
        .rv-pie { flex-direction: column; }
    }
</style>

@* ===================== ICONOS REUTILIZABLES ===================== *@
@{
