@model IEnumerable<Sportia.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var reservas = Model?.ToList() ?? new List<Sportia.Models.Reserva>();
}

<style>
    .reservas-page {
        width: 100%;
    }

    /* =====================================================
           MENSAJE DE ÉXITO
           ===================================================== */

    .mensaje-exito {
        width: 100%;
        margin-bottom: 18px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(34, 199, 122, .10);
        border: 1px solid rgba(34, 199, 122, .30);
        border-radius: 10px;
        color: #22c77a;
    }

    .mensaje-exito-icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(34, 199, 122, .15);
        color: #22c77a;
        font-size: 17px;
        font-weight: 800;
    }

    .mensaje-exito strong {
        display: block;
        color: #22c77a;
        font-size: 13px;
        font-weight: 800;
    }

    .mensaje-exito p {
        margin: 3px 0 0;
        color: #8c99ae;
        font-size: 12px;
    }


    .reservas-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .reservas-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
        color: #edf2f7;
        letter-spacing: -.5px;
    }

    .reservas-title p {
        margin: 6px 0 0;
        color: #8c99ae;
        font-size: 13px;
    }

    .btn-nueva-reserva {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 9px;
        background: #22c77a;
        color: #03150d;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: .15s ease;
        white-space: nowrap;
        border: 1px solid #22c77a;
    }

        .btn-nueva-reserva:hover {
            background: #1fb86f;
            color: #03150d;
            transform: translateY(-1px);
        }

        .btn-nueva-reserva svg {
            width: 16px;
            height: 16px;
        }

    .reservas-card {
        width: 100%;
        background: #101928;
        border: 1px solid #202d43;
        border-radius: 14px;
        overflow: hidden;
    }

    .reservas-card-header {
        min-height: 72px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid #202d43;
    }

    .reservas-card-title {
        color: #edf2f7;
        font-size: 15px;
        font-weight: 800;
    }

    .reservas-card-subtitle {
        margin-top: 4px;
        color: #8c99ae;
        font-size: 12px;
    }

    .reservas-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 8px;
        background: rgba(34, 199, 122, .10);
        color: #22c77a;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .reservas-count svg {
            width: 15px;
            height: 15px;
        }

    .reservas-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .reservas-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

        .reservas-table thead {
            background: #0d1625;
        }

        .reservas-table th {
            padding: 12px 16px;
            text-align: left;
            color: #5e6c83;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .7px;
            text-transform: uppercase;
            border-bottom: 1px solid #202d43;
            white-space: nowrap;
        }

        .reservas-table td {
            padding: 15px 16px;
            color: #edf2f7;
            font-size: 13px;
            border-bottom: 1px solid #1b2739;
            vertical-align: middle;
        }

        .reservas-table tbody tr {
            transition: .15s ease;
        }

            .reservas-table tbody tr:hover {
                background: #141f32;
            }

            .reservas-table tbody tr:last-child td {
                border-bottom: none;
            }

    .codigo {
        color: #22c77a;
        font-weight: 800;
        white-space: nowrap;
    }

    .cliente-nombre {
        color: #edf2f7;
        font-weight: 700;
    }

    .cliente-documento {
        margin-top: 3px;
        color: #5e6c83;
        font-size: 11px;
    }

    .escenario {
        color: #cbd5e1;
    }

    .fecha {
        color: #cbd5e1;
        white-space: nowrap;
    }

    .horario {
        color: #8c99ae;
        white-space: nowrap;
    }

    .valor {
        color: #edf2f7;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .estado-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .estado-confirmada {
        background: rgba(34, 199, 122, .12);
        color: #22c77a;
    }

        .estado-confirmada .estado-dot {
            background: #22c77a;
        }

    .estado-pendiente {
        background: rgba(245, 166, 35, .12);
        color: #f5a623;
    }

        .estado-pendiente .estado-dot {
            background: #f5a623;
        }

    .estado-cancelada {
        background: rgba(239, 83, 101, .12);
        color: #ef5365;
    }

        .estado-cancelada .estado-dot {
            background: #ef5365;
        }

    .estado-default {
        background: rgba(140, 153, 174, .12);
        color: #8c99ae;
    }

        .estado-default .estado-dot {
            background: #8c99ae;
        }

    .acciones {
        text-align: right !important;
    }

    .btn-accion {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid #263449;
        background: #0d1625;
        color: #8c99ae;
        text-decoration: none;
        transition: .15s ease;
    }

        .btn-accion:hover {
            background: #141f32;
            color: #22c77a;
            border-color: #22c77a;
        }

        .btn-accion svg {
            width: 15px;
            height: 15px;
        }

    .reservas-empty {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(34, 199, 122, .10);
        color: #22c77a;
    }

        .empty-icon svg {
            width: 25px;
            height: 25px;
        }

    .reservas-empty h3 {
        margin: 0;
        color: #edf2f7;
        font-size: 15px;
        font-weight: 800;
    }

    .reservas-empty p {
        margin: 7px 0 18px;
        color: #8c99ae;
        font-size: 12px;
    }

    .btn-empty {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        border-radius: 8px;
        background: #22c77a;
        color: #03150d;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

        .btn-empty:hover {
            background: #1fb86f;
            color: #03150d;
        }

        .btn-empty svg {
            width: 14px;
            height: 14px;
        }

    @@media (max-width: 700px) {
        .reservas-header {
            flex-direction: column;
        }

        .btn-nueva-reserva {
            width: 100%;
        }

        .reservas-card-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>


<div class="reservas-page">

    <!-- =====================================================
         MENSAJE DE ÉXITO
         ===================================================== -->
    @if (TempData["MensajeReserva"] != null)
    {
        <div class="mensaje-exito">

            <span class="mensaje-exito-icon">
                ✓
            </span>

            <div>
                <strong>
                    Reserva creada correctamente
                </strong>

                <p>
                    @TempData["MensajeReserva"]
                </p>
            </div>

        </div>
    }


    <!-- ENCABEZADO -->
    <div class="reservas-header">

        <div class="reservas-title">
            <h1>Reservas</h1>
            <p>Gestiona las reservas de los escenarios deportivos</p>
        </div>

        <a asp-controller="Reservas"
           asp-action="Create"
           class="btn-nueva-reserva">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>

            Nueva reserva
        </a>

    </div>


    <!-- TARJETA -->
    <div class="reservas-card">

        <div class="reservas-card-header">

            <div>
                <div class="reservas-card-title">
                    Todas las reservas
                </div>

                <div class="reservas-card-subtitle">
                    Registro de reservas realizadas
                </div>
            </div>

            <div class="reservas-count">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">
                    <rect x="3" y="4" width="18" height="17" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>

                @reservas.Count reserva@(reservas.Count == 1 ? "" : "s")

            </div>

        </div>


        @if (reservas.Any())
        {
            <!-- TABLA -->
            <div class="reservas-table-wrapper">

                <table class="reservas-table">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Escenario</th>
                            <th>Fecha</th>
                            <th>Horario</th>
                            <th>Valor</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reserva in reservas)
                        {
                            var estadoNombre =
                                reserva.IdEstadoNavigation?.Nombre
                                ?? "Sin estado";

                            var estadoClase = estadoNombre.ToLower() switch
                            {
                                var x when x.Contains("confirm") => "estado-confirmada",
                                var x when x.Contains("pend") => "estado-pendiente",
                                var x when x.Contains("cancel") => "estado-cancelada",
                                _ => "estado-default"
                            };

                            var clienteNombre =
                                reserva.IdClienteNavigation != null
                                ? $"{reserva.IdClienteNavigation.Nombres} {reserva.IdClienteNavigation.Apellidos}"
                                : "Cliente no disponible";

                            var escenarioNombre =
                                reserva.IdEscenarioNavigation?.Nombre
                                ?? "Escenario no disponible";

                            <tr>

                                <!-- CÓDIGO -->
                                <td>
                                    <span class="codigo">
                                        @reserva.Codigo
                                    </span>
                                </td>


                                <!-- CLIENTE -->
                                <td>
                                    <div class="cliente-nombre">
                                        @clienteNombre
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        reserva.IdClienteNavigation?.Documento))
                                    {
                                        <div class="cliente-documento">
                                            @reserva.IdClienteNavigation.Documento
                                        </div>
                                    }
                                </td>


                                <!-- ESCENARIO -->
                                <td>
                                    <span class="escenario">
                                        @escenarioNombre
                                    </span>
                                </td>


                                <!-- FECHA -->
                                <td>
                                    <span class="fecha">
                                        @reserva.FechaUso.ToString("dd/MM/yyyy")
                                    </span>
                                </td>


                                <!-- HORARIO -->
                                <td>
                                    <span class="horario">
                                        @reserva.HoraInicio.ToString("hh\\:mm")
                                        -
                                        @reserva.HoraFin.ToString("hh\\:mm")
                                    </span>
                                </td>


                                <!-- VALOR -->
                                <td>
                                    <span class="valor">
                                        @reserva.ValorTotal.ToString("C0")
                                    </span>
                                </td>


                                <!-- ESTADO -->
                                <td>

                                    <span class="estado @estadoClase">

                                        <span class="estado-dot"></span>

                                        @estadoNombre

                                    </span>

                                </td>


                                <!-- ACCIONES -->
                                <td class="acciones">

                                    <a href="#"
                                       class="btn-accion"
                                       title="Ver reserva">

                                        <svg viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">
                                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" />
                                            <circle cx="12" cy="12" r="2.5" />
                                        </svg>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- SIN RESERVAS -->
            <div class="reservas-empty">

                <div class="empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <rect x="3" y="4" width="18" height="17" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                        <path d="M8 15h8" />

                    </svg>

                </div>

                <h3>
                    No hay reservas registradas
                </h3>

                <p>
                    Crea la primera reserva para comenzar.
                </p>

                <a asp-controller="Reservas"
                   asp-action="Create"
                   class="btn-empty">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>

                    Crear reserva

                </a>

            </div>
        }

    </div>

</div>