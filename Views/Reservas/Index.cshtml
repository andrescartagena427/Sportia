<div class="rv">

    @if (TempData["MensajeReserva"] != null)
    {
        <div class="rv-alerta ok">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6L9 17l-5-5" /></svg>
            <span>@TempData["MensajeReserva"]</span>
        </div>
    }
    @if (TempData["ErrorReserva"] != null)
    {
        <div class="rv-alerta error">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
            <span>@TempData["ErrorReserva"]</span>
        </div>
    }

    <!-- ===================== ENCABEZADO ===================== -->
    <section class="rv-hero">

        <!-- Cancha de fondo (dibujada, no necesita imagen) -->
        <div class="rv-hero-cancha" aria-hidden="true">
            <svg viewBox="0 0 600 200" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="rvPasto" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#0f3b2c" />
                        <stop offset="1" stop-color="#0a2a20" />
                    </linearGradient>
                    <radialGradient id="rvLuz" cx="0.75" cy="0" r="0.8">
                        <stop offset="0" stop-color="#7dffcf" stop-opacity=".28" />
                        <stop offset="1" stop-color="#7dffcf" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="rvBalon" cx="0.35" cy="0.3" r="0.75">
                        <stop offset="0" stop-color="#ffffff" />
                        <stop offset="0.6" stop-color="#d9e2ea" />
                        <stop offset="1" stop-color="#7f8c99" />
                    </radialGradient>
                </defs>
                <!-- franjas del pasto en perspectiva -->
                <polygon points="60,200 600,200 600,70 250,70" fill="url(#rvPasto)" />
                <g fill="#ffffff" opacity=".035">
                    <polygon points="60,200 150,200 300,70 250,70" />
                    <polygon points="240,200 330,200 400,70 350,70" />
                    <polygon points="420,200 510,200 500,70 450,70" />
                </g>
                <!-- líneas de la cancha -->
                <g fill="none" stroke="#bff5df" stroke-opacity=".45" stroke-width="1.5">
                    <polygon points="110,195 590,195 575,78 270,78" />
                    <line x1="190" y1="137" x2="582" y2="137" />
                    <ellipse cx="400" cy="137" rx="70" ry="16" />
                    <polyline points="330,78 318,104 535,104 528,78" />
                </g>
                <rect width="600" height="200" fill="url(#rvLuz)" />
                <!-- balón -->
                <g transform="translate(345 118) scale(.85)">
                    <ellipse cx="4" cy="30" rx="30" ry="6" fill="#000" opacity=".35" />
                    <circle r="30" fill="url(#rvBalon)" />
                    <g fill="#1d2733" opacity=".85">
                        <polygon points="0,-10 9.5,-3 6,8 -6,8 -9.5,-3" />
                        <polygon points="-3,-30 3,-30 6,-22 0,-17 -6,-22" />
                        <polygon points="24,-15 29,-5 25,2 19,-3 18,-11" />
                        <polygon points="16,22 22,16 27,19 22,27 15,28" />
                        <polygon points="-16,22 -22,16 -27,19 -22,27 -15,28" />
                        <polygon points="-24,-15 -29,-5 -25,2 -19,-3 -18,-11" />
                    </g>
                </g>
            </svg>
        </div>

        <div class="rv-hero-izq">
            <div class="rv-hero-icono">@Html.Raw(icoCalendario)</div>
            <div>
                <h1>Reservas</h1>
                <p>Gestiona todas las reservas de los escenarios deportivos</p>
            </div>
        </div>

        <a asp-controller="Reservas" asp-action="Create" class="rv-btn-nueva">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
            Nueva reserva
        </a>
    </section>

    <!-- ===================== TARJETAS ===================== -->
    <section class="rv-kpis">

        <div class="rv-kpi verde">
            <div class="rv-kpi-icono">@Html.Raw(icoCalendario)</div>
            <div>
                <div class="rv-kpi-num">@Model.TotalReservas</div>
                <div class="rv-kpi-label">Total de reservas</div>
                <div class="rv-kpi-pie">@Variacion(Model.VariacionReservas, Model.TextoComparacion)</div>
            </div>
        </div>

        <div class="rv-kpi azul">
            <div class="rv-kpi-icono">
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="8" r="3.6" /><path d="M2.5 19.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6v.5h-13z" /><circle cx="17" cy="9" r="2.8" opacity=".85" /><path d="M16.6 13.6c2.9.2 5 2.2 5 5.2v1.2h-4.4v-.5c0-2.3-.8-4.3-2.2-5.6.5-.2 1-.3 1.6-.3z" opacity=".85" /></svg>
            </div>
            <div>
                <div class="rv-kpi-num">@Model.ClientesUnicos</div>
                <div class="rv-kpi-label">Clientes únicos</div>
                <div class="rv-kpi-pie">@Variacion(Model.VariacionClientes, Model.TextoComparacion)</div>
            </div>
        </div>

        <div class="rv-kpi morado">
            <div class="rv-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M14.8 9.2c-.5-.9-1.5-1.4-2.8-1.4-1.6 0-2.8.8-2.8 2.1 0 3 5.8 1.5 5.8 4.3 0 1.3-1.2 2.1-3 2.1-1.4 0-2.5-.6-3-1.6M12 6v1.8M12 16.3V18" /></svg>
            </div>
            <div style="min-width:0">
                <div class="rv-kpi-num">@Dinero(Model.ValorTotal)</div>
                <div class="rv-kpi-label">Valor total reservado</div>
                <div class="rv-kpi-pie">@Variacion(Model.VariacionValor, Model.TextoComparacion)</div>
            </div>
        </div>

        <div class="rv-kpi ambar">
            <div class="rv-kpi-icono">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".18" /><path d="M8 12.3l2.7 2.7L16.2 9.4" /></svg>
            </div>
            <div>
                <div class="rv-kpi-num">@Model.Confirmadas</div>
                <div class="rv-kpi-label">Confirmadas</div>
                <div class="rv-kpi-pie">@Variacion(Model.VariacionConfirmadas, Model.TextoComparacion)</div>
            </div>
        </div>
    </section>

    <!-- ===================== FILTROS ===================== -->
    <form method="get" asp-controller="Reservas" asp-action="Index" id="rvFiltros" class="rv-filtros">

        <input type="hidden" name="desde" id="rvDesde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="hasta" id="rvHasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />

        <div class="rv-caja rv-buscar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input type="search" name="buscar" value="@Model.Buscar" placeholder="Buscar por cliente, código o escenario..." autocomplete="off" />
        </div>

        <!-- Rango de fechas -->
        <div class="rv-caja rv-sel" id="rvRango">
            @Html.Raw(icoCalendario)
            <div class="rv-sel-txt">
                <small>Rango de fechas</small>
                <span>@Model.Desde.ToString("dd/MM/yyyy") - @Model.Hasta.ToString("dd/MM/yyyy")</span>
            </div>
            <svg class="rv-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>

            <div class="rv-rango-panel" id="rvRangoPanel">
                <div class="rv-rango-atajos">
                    <button type="button" data-rango="hoy">Hoy</button>
                    <button type="button" data-rango="semana">Esta semana</button>
                    <button type="button" data-rango="mes">Este mes</button>
                    <button type="button" data-rango="anterior">Mes anterior</button>
                </div>
                <label>Desde <input type="date" id="rvDesdeTmp" value="@Model.Desde.ToString("yyyy-MM-dd")" /></label>
                <label>Hasta <input type="date" id="rvHastaTmp" value="@Model.Hasta.ToString("yyyy-MM-dd")" /></label>
                <button type="button" class="rv-rango-aplicar" id="rvAplicarRango">Aplicar</button>
            </div>
        </div>

        <!-- Estado -->
        <div class="rv-caja rv-sel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3.5 5h17l-6.5 7.6V19l-4 1.5v-7.9z" /></svg>
            <div class="rv-sel-txt">
                <small>Estado</small>
                <span>@selEstado</span>
            </div>
            <svg class="rv-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            <select name="estado" aria-label="Estado" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var e in Model.Estados)
                {
                    <option value="@e.IdEstado" selected="@(Model.IdEstado == e.IdEstado)">@e.Nombre</option>
                }
            </select>
        </div>

        <!-- Escenario -->
        <div class="rv-caja rv-sel">
            @Html.Raw(icoCancha)
            <div class="rv-sel-txt">
                <small>Escenario</small>
                <span>@selEscenario</span>
            </div>
            <svg class="rv-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
            <select name="escenario" aria-label="Escenario" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var e in Model.Escenarios)
                {
                    <option value="@e.IdEscenario" selected="@(Model.IdEscenario == e.IdEscenario)">@e.Nombre</option>
                }
            </select>
        </div>

        <button type="submit" class="rv-btn-actualizar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 11a8 8 0 0 0-14.6-4.5L4 8M4 4v4h4M4 13a8 8 0 0 0 14.6 4.5L20 16M20 20v-4h-4" /></svg>
            Actualizar
        </button>
    </form>

    <!-- ===================== TABLA ===================== -->
    <section class="rv-tabla-card">

        @if (Model.Reservas.Any())
        {
            <div class="rv-tabla-wrap">
                <table class="rv-tabla">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Escenario</th>
                            <th>Fecha</th>
                            <th>Horario</th>
                            <th>Valor</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Reservas)
                        {
                            var est = r.Estado.ToLower();
                            var icono = TipoIcono(r.TipoEscenario, r.Escenario) switch
                            {
                                "raqueta" => icoRaqueta,
                                "basket" => icoBasket,
                                "balon" => icoBalon,
                                _ => icoCancha
                            };
                            var horario = $"{r.HoraInicio:HH\\:mm} - {r.HoraFin:HH\\:mm}";

                            <tr>
                                <td><span class="rv-codigo">@r.Codigo</span></td>

                                <td>
                                    <div class="rv-cliente">
                                        <span class="rv-avatar" style="background:@ColorAvatar(r.Cliente)">@r.Iniciales</span>
                                        <div>
                                            <b>@r.Cliente</b>
                                            @if (!string.IsNullOrWhiteSpace(r.Documento))
                                            {
                                                <small>@r.Documento</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td><span class="rv-icono-txt">@Html.Raw(icono) @r.Escenario</span></td>

                                <td><span class="rv-icono-txt suave">@Html.Raw(icoCalendario) @r.FechaUso.ToString("dd/MM/yyyy")</span></td>

                                <td><span class="rv-icono-txt suave">@Html.Raw(icoReloj) @horario</span></td>

                                <td><span class="rv-valor">@Dinero(r.ValorTotal)</span></td>

                                <td><span class="rv-chip @ClaseEstado(r.Estado)">@r.Estado</span></td>

                                <td>
                                    <div class="rv-acciones">
                                        <button type="button" class="rv-btn-icono rv-ver" title="Ver reserva"
                                                data-codigo="@r.Codigo"
                                                data-estado="@r.Estado"
                                                data-clase="@ClaseEstado(r.Estado)"
                                                data-cliente="@r.Cliente"
                                                data-documento="@(r.Documento ?? "—")"
                                                data-telefono="@(string.IsNullOrWhiteSpace(r.Telefono) ? "—" : r.Telefono)"
                                                data-correo="@(r.Correo ?? "—")"
                                                data-escenario="@r.Escenario"
                                                data-fecha="@r.FechaUso.ToString("dddd dd 'de' MMMM 'de' yyyy", co)"
                                                data-horario="@horario"
                                                data-valor="@Dinero(r.ValorTotal)"
                                                data-pagado="@Dinero(r.Pagado)"
                                                data-metodo="@(r.MetodoPago ?? "Sin pago registrado")"
                                                data-creada="@(r.FechaReserva?.ToString("dd/MM/yyyy hh:mm tt", co) ?? "—")"
                                                data-obs="@(string.IsNullOrWhiteSpace(r.Observaciones) ? "—" : r.Observaciones)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="2.8" /></svg>
                                        </button>

                                        <div class="rv-menu">
                                            <button type="button" class="rv-btn-icono rv-menu-btn" title="Más opciones" aria-haspopup="true">
                                                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5.5" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="12" cy="18.5" r="1.7" /></svg>
                                            </button>
                                            <div class="rv-menu-lista">
                                                @if (!est.Contains("confirm"))
                                                {
                                                    <form method="post" asp-action="CambiarEstado">
                                                        <input type="hidden" name="id" value="@r.IdReserva" />
                                                        <input type="hidden" name="accion" value="confirmar" />
                                                        <input type="hidden" name="volver" value="@urlActual" />
                                                        <button type="submit">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="#22d39a" stroke-width="2.2"><path d="M20 6L9 17l-5-5" /></svg>
                                                            Confirmar reserva
                                                        </button>
                                                    </form>
                                                }
                                                @if (!est.Contains("pend"))
                                                {
                                                    <form method="post" asp-action="CambiarEstado">
                                                        <input type="hidden" name="id" value="@r.IdReserva" />
                                                        <input type="hidden" name="accion" value="pendiente" />
                                                        <input type="hidden" name="volver" value="@urlActual" />
                                                        <button type="submit">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="#f5b031" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                                            Marcar como pendiente
                                                        </button>
                                                    </form>
                                                }
                                                @if (!est.Contains("cancel"))
                                                {
                                                    <form method="post" asp-action="CambiarEstado" class="rv-form-cancelar" data-codigo="@r.Codigo">
                                                        <input type="hidden" name="id" value="@r.IdReserva" />
                                                        <input type="hidden" name="accion" value="cancelar" />
                                                        <input type="hidden" name="volver" value="@urlActual" />
                                                        <button type="submit" class="peligro">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M15 9l-6 6M9 9l6 6" /></svg>
                                                            Cancelar reserva
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="rv-pie">
                <span>Mostrando @Model.MostrandoDesde - @Model.MostrandoHasta de @Model.TotalFiltradas reserva@(Model.TotalFiltradas == 1 ? "" : "s")</span>

                <nav class="rv-paginas" aria-label="Páginas">
                    @if (Model.Pagina > 1)
                    {
                        <a href="@UrlPagina(Model.Pagina - 1)" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" /></svg></a>
                    }
                    else
                    {
                        <span class="apagado"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" /></svg></span>
                    }

                    @{
                        int ini = Math.Max(1, Model.Pagina - 2);
                        int fin = Math.Min(Model.TotalPaginas, ini + 4);
                        ini = Math.Max(1, fin - 4);
                    }
                    @for (int p = ini; p <= fin; p++)
                    {
                        if (p == Model.Pagina)
                        {
                            <span class="actual">@p</span>
                        }
                        else
                        {
                            <a href="@UrlPagina(p)">@p</a>
                        }
                    }

                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <a href="@UrlPagina(Model.Pagina + 1)" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></a>
                    }
                    else
                    {
                        <span class="apagado"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg></span>
                    }
                </nav>
            </div>
        }
        else
        {
            <div class="rv-vacio">
                <div class="rv-vacio-icono">@Html.Raw(icoCalendario)</div>
                <h3>No hay reservas para mostrar</h3>
                <p>Cambia el rango de fechas o los filtros, o crea una nueva reserva.</p>
            </div>
        }
    </section>

    <!-- ===================== MODAL DETALLE ===================== -->
    <div class="rv-modal" id="rvModal" role="dialog" aria-modal="true" aria-labelledby="rvModalTitulo">
        <div class="rv-modal-caja">
            <div class="rv-modal-cab">
                <div>
                    <h3 id="rvModalTitulo">Reserva</h3>
                    <span class="rv-chip" id="rvModalEstado"></span>
                </div>
                <button type="button" class="rv-btn-icono" id="rvModalCerrar" title="Cerrar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12" /></svg>
                </button>
            </div>
            <div class="rv-modal-cuerpo">
                <div class="rv-dato"><span>Cliente</span><b data-campo="cliente"></b></div>
                <div class="rv-dato"><span>Documento</span><b data-campo="documento"></b></div>
                <div class="rv-dato"><span>Teléfono</span><b data-campo="telefono"></b></div>
                <div class="rv-dato"><span>Correo</span><b data-campo="correo"></b></div>
                <div class="rv-dato"><span>Escenario</span><b data-campo="escenario"></b></div>
                <div class="rv-dato"><span>Fecha</span><b data-campo="fecha"></b></div>
                <div class="rv-dato"><span>Horario</span><b data-campo="horario"></b></div>
                <div class="rv-dato"><span>Valor</span><b data-campo="valor"></b></div>
                <div class="rv-dato"><span>Pagado</span><b data-campo="pagado"></b></div>
                <div class="rv-dato"><span>Método de pago</span><b data-campo="metodo"></b></div>
                <div class="rv-dato"><span>Creada el</span><b data-campo="creada"></b></div>
                <div class="rv-dato"><span>Observaciones</span><b data-campo="obs"></b></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const form = document.getElementById('rvFiltros');

        // ---------- Rango de fechas ----------
        const rango = document.getElementById('rvRango');
        const panel = document.getElementById('rvRangoPanel');
        const dTmp = document.getElementById('rvDesdeTmp');
        const hTmp = document.getElementById('rvHastaTmp');
        const iso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');

        rango.addEventListener('click', e => {
            if (!panel.contains(e.target)) rango.classList.toggle('abierto');
        });

        panel.querySelectorAll('[data-rango]').forEach(b => b.addEventListener('click', () => {
            const hoy = new Date();
            let d = new Date(hoy), h = new Date(hoy);
            switch (b.dataset.rango) {
                case 'semana':
                    const dia = (hoy.getDay() + 6) % 7; // lunes = 0
                    d.setDate(hoy.getDate() - dia); h = new Date(d); h.setDate(d.getDate() + 6); break;
                case 'mes':
                    d = new Date(hoy.getFullYear(), hoy.getMonth(), 1); h = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0); break;
                case 'anterior':
                    d = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 1); h = new Date(hoy.getFullYear(), hoy.getMonth(), 0); break;
            }
            dTmp.value = iso(d); hTmp.value = iso(h);
        }));

        document.getElementById('rvAplicarRango').addEventListener('click', () => {
            if (!dTmp.value || !hTmp.value) return;
            document.getElementById('rvDesde').value = dTmp.value;
            document.getElementById('rvHasta').value = hTmp.value;
            form.submit();
        });

        // ---------- Menú de tres puntos ----------
        document.querySelectorAll('.rv-menu-btn').forEach(btn => btn.addEventListener('click', e => {
            e.stopPropagation();
            const menu = btn.closest('.rv-menu');
            const abierto = menu.classList.contains('abierto');
            document.querySelectorAll('.rv-menu.abierto').forEach(m => m.classList.remove('abierto'));
            if (!abierto) {
                // si no cabe hacia abajo, se abre hacia arriba
                menu.classList.toggle('arriba', btn.getBoundingClientRect().bottom > window.innerHeight - 170);
                menu.classList.add('abierto');
            }
        }));

        document.addEventListener('click', e => {
            if (!e.target.closest('.rv-menu')) document.querySelectorAll('.rv-menu.abierto').forEach(m => m.classList.remove('abierto'));
            if (!e.target.closest('#rvRango')) rango.classList.remove('abierto');
        });

        document.querySelectorAll('.rv-form-cancelar').forEach(f => f.addEventListener('submit', e => {
            if (!confirm('¿Seguro que deseas cancelar la reserva ' + f.dataset.codigo + '? El horario quedará libre.')) e.preventDefault();
        }));

        // ---------- Modal de detalle ----------
        const modal = document.getElementById('rvModal');
        const estado = document.getElementById('rvModalEstado');

        document.querySelectorAll('.rv-ver').forEach(btn => btn.addEventListener('click', () => {
            const d = btn.dataset;
            document.getElementById('rvModalTitulo').textContent = d.codigo;
            estado.textContent = d.estado;
            estado.className = 'rv-chip ' + d.clase;
            modal.querySelectorAll('[data-campo]').forEach(el => el.textContent = d[el.dataset.campo] || '—');
            modal.classList.add('abierto');
        }));

        const cerrar = () => modal.classList.remove('abierto');
        document.getElementById('rvModalCerrar').addEventListener('click', cerrar);
        modal.addEventListener('click', e => { if (e.target === modal) cerrar(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') { cerrar(); document.querySelectorAll('.rv-menu.abierto').forEach(m => m.classList.remove('abierto')); } });
    })();
</script>
