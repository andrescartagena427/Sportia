    string icoCancha = $"<svg {svgAttr}><rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"1.5\"/><path d=\"M12 5v14\"/><circle cx=\"12\" cy=\"12\" r=\"2.6\"/><path d=\"M2.5 9.5h3v5h-3M21.5 9.5h-3v5h3\"/></svg>";
