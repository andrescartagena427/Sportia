@model Sportia.Models.Escenario

@{
    ViewData["Title"] = "Nuevo escenario";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div style="max-width:900px; margin:0 auto; padding:25px;">

    <div style="margin-bottom:25px;">

        <h1 style="color:#edf2f7; margin:0;">
            Nuevo escenario
        </h1>

        <p style="color:#8c99ae; margin-top:6px;">
            Registra una nueva cancha o escenario deportivo.
        </p>

    </div>


    <div style="background:#101928;
        border:1px solid #202d43;
        border-radius:12px;
        overflow:hidden;">

        <!-- IMPORTANTE:
         enctype permite enviar archivos/imágenes -->
        <form asp-controller="Escenarios"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div style="padding:25px;">

                <!-- ERRORES -->

                <div asp-validation-summary="ModelOnly"
                     style="color:#ef5365;
                    margin-bottom:20px;">
                </div>


                <!-- ================================================= -->
                <!-- NOMBRE -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="Nombre"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Nombre del escenario

                    </label>

                    <input asp-for="Nombre"
                           style="width:100%;
                    box-sizing:border-box;
                    padding:11px;
                    background:#0d1422;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:white;"
                           placeholder="Ej: Cancha de fútbol 1" />

                    <span asp-validation-for="Nombre"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- TIPO -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="IdTipo"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Tipo de escenario

                    </label>

                    <select asp-for="IdTipo"
                            style="width:100%;
                        padding:11px;
                        background:#0d1422;
                        border:1px solid #202d43;
                        border-radius:8px;
                        color:white;">

                        <option value="0">
                            Selecciona un tipo
                        </option>

                        @if (ViewBag.Tipos != null)
                        {
                            foreach (var tipo in ViewBag.Tipos)
                            {
                                <option value="@tipo.IdTipo">
                                    @tipo.Nombre
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="IdTipo"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- EMPRESA -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="IdEmpresa"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Empresa / sede

                    </label>

                    <select asp-for="IdEmpresa"
                            style="width:100%;
                        padding:11px;
                        background:#0d1422;
                        border:1px solid #202d43;
                        border-radius:8px;
                        color:white;">

                        <option value="0">
                            Selecciona una empresa
                        </option>

                        @if (ViewBag.Empresas != null)
                        {
                            foreach (var empresa in ViewBag.Empresas)
                            {
                                <option value="@empresa.IdEmpresa">
                                    @empresa.Nombre
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="IdEmpresa"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- DESCRIPCIÓN -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="Descripcion"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Descripción

                    </label>

                    <textarea asp-for="Descripcion"
                              rows="4"
                              style="width:100%;
                    box-sizing:border-box;
                    padding:11px;
                    background:#0d1422;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:white;"
                              placeholder="Describe el escenario, ubicación, características, etc."></textarea>

                    <span asp-validation-for="Descripcion"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- CANTIDAD DE CANCHAS -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="Capacidad"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Cantidad de canchas

                    </label>

                    <input asp-for="Capacidad"
                           type="number"
                           min="1"
                           style="width:100%;
                    box-sizing:border-box;
                    padding:11px;
                    background:#0d1422;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:white;"
                           placeholder="Ej: 3" />

                    <small style="color:#8c99ae;">
                        Indica cuántas canchas o unidades tiene este escenario.
                    </small>

                    <br />

                    <span asp-validation-for="Capacidad"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- PRECIO POR HORA -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label asp-for="Precio"
                           style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Precio por hora

                    </label>

                    <input asp-for="Precio"
                           type="number"
                           step="0.01"
                           min="0"
                           style="width:100%;
                    box-sizing:border-box;
                    padding:11px;
                    background:#0d1422;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:white;"
                           placeholder="Ej: 50000" />

                    <small style="color:#8c99ae;">
                        Valor que se cobrará por cada hora reservada en este escenario.
                    </small>

                    <br />

                    <span asp-validation-for="Precio"
                          style="color:#ef5365;
                        font-size:12px;">
                    </span>

                </div>


                <!-- ================================================= -->
                <!-- IMAGEN -->
                <!-- ================================================= -->

                <div style="margin-bottom:20px;">

                    <label style="display:block;
                        color:#cbd5e1;
                        margin-bottom:7px;">

                        Imagen de la cancha

                    </label>

                    <input type="file"
                           name="imagenArchivo"
                           id="imagenArchivo"
                           accept="image/*"
                           style="width:100%;
                    box-sizing:border-box;
                    padding:11px;
                    background:#0d1422;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:#cbd5e1;
                    cursor:pointer;" />

                    <small style="display:block;
                        color:#8c99ae;
                        margin-top:7px;">

                        Selecciona una fotografía de la cancha.
                        Formatos recomendados: JPG, JPEG, PNG o WEBP.

                    </small>

                </div>


                <!-- ================================================= -->
                <!-- VISTA PREVIA DE LA IMAGEN -->
                <!-- ================================================= -->

                <div id="previewContainer"
                     style="display:none;
                    margin-bottom:20px;">

                    <div style="color:#cbd5e1;
                        font-size:13px;
                        margin-bottom:8px;">

                        Vista previa

                    </div>

                    <img id="previewImagen"
                         src=""
                         alt="Vista previa"
                         style="display:block;
                    width:100%;
                    max-height:350px;
                    object-fit:cover;
                    border-radius:10px;
                    border:1px solid #202d43;" />

                </div>


                <!-- ================================================= -->
                <!-- ESTADO -->
                <!-- ================================================= -->

                <div style="margin-bottom:10px;">

                    <label style="color:#cbd5e1;">

                        <input asp-for="Estado" />

                        Escenario activo

                    </label>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- BOTONES -->
            <!-- ===================================================== -->

            <div style="padding:18px 25px;
                border-top:1px solid #202d43;
                background:#0d1422;
                display:flex;
                justify-content:flex-end;
                gap:10px;">

                <a asp-controller="Escenarios"
                   asp-action="Index"
                   style="padding:10px 16px;
                    border:1px solid #202d43;
                    border-radius:8px;
                    color:#8c99ae;
                    text-decoration:none;">

                    Cancelar

                </a>

                <button type="submit"
                        style="padding:10px 18px;
                    border:1px solid #22c77a;
                    border-radius:8px;
                    background:#22c77a;
                    color:#03150d;
                    font-weight:700;
                    cursor:pointer;">

                    ✓ Crear escenario

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const inputImagen = document.getElementById("imagenArchivo");
            const previewContainer = document.getElementById("previewContainer");
            const previewImagen = document.getElementById("previewImagen");

            if (inputImagen) {

                inputImagen.addEventListener("change", function() {

                    const archivo = this.files[0];

                    if (!archivo) {

                        previewContainer.style.display = "none";
                        previewImagen.src = "";

                        return;
                    }

                    if (!archivo.type.startsWith("image/")) {

                        alert("Por favor selecciona una imagen válida.");

                        this.value = "";

                        previewContainer.style.display = "none";
                        previewImagen.src = "";

                        return;
                    }

                    const lector = new FileReader();

                    lector.onload = function(e) {

                        previewImagen.src = e.target.result;

                        previewContainer.style.display = "block";

                    };

                    lector.readAsDataURL(archivo);

                });

            }

        });

    </script>

}
