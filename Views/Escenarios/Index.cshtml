@model IEnumerable<Sportia.Models.Escenario>

@{
    ViewData["Title"] = "Escenarios";
    Layout = "_DashboardLayout";

    var escenarios = Model?.ToList() ?? new List<Sportia.Models.Escenario>();

    var totalEscenarios = escenarios.Count;
    var escenariosActivos = escenarios.Count(x => x.Estado == true);
    var escenariosInactivos = escenarios.Count(x => x.Estado != true);
}

<!-- ========================================================= -->
<!-- ENCABEZADO -->
<!-- ========================================================= -->

<div class="space-y-6">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div class="flex items-center gap-4">

            <div class="w-12 h-12 rounded-2xl
                bg-emerald-500/10
                border border-emerald-500/20
                flex items-center justify-center">

                <i data-lucide="landmark"
                   class="w-6 h-6 text-emerald-400">
                </i>

            </div>

            <div>

                <h1 class="text-2xl font-bold text-white">
                    Escenarios
                </h1>

                <p class="text-sm text-slate-500 mt-1">
                    Administra tus canchas, escenarios deportivos y espacios disponibles
                </p>

            </div>

        </div>


        <!-- NUEVO ESCENARIO -->

        <a asp-controller="Escenarios"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2
            rounded-xl
            bg-emerald-500
            px-5 py-2.5
            text-sm font-bold
            text-slate-950
            shadow-lg shadow-emerald-500/10
            transition
            hover:bg-emerald-400
            hover:-translate-y-0.5">

            <i data-lucide="plus"
               class="w-4 h-4">
            </i>

            Nuevo escenario

        </a>

    </div>


    <!-- ===================================================== -->
    <!-- TARJETAS DE ESTADÍSTICAS -->
    <!-- ===================================================== -->

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- TOTAL -->

        <div class="relative overflow-hidden
            rounded-2xl
            border border-slate-800
            bg-[#101928]
            p-5">

            <div class="flex items-start justify-between">

                <div>

                    <p class="text-[11px]
                        uppercase
                        tracking-wider
                        text-slate-500">

                        Total escenarios

                    </p>

                    <p class="mt-2 text-3xl font-bold text-white">
                        @totalEscenarios
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Registrados en el sistema
                    </p>

                </div>

                <div class="w-10 h-10
                    rounded-xl
                    bg-blue-500/10
                    border border-blue-500/10
                    flex items-center justify-center">

                    <i data-lucide="building-2"
                       class="w-5 h-5 text-blue-400">
                    </i>

                </div>

            </div>

        </div>


        <!-- ACTIVOS -->

        <div class="relative overflow-hidden
            rounded-2xl
            border border-slate-800
            bg-[#101928]
            p-5">

            <div class="flex items-start justify-between">

                <div>

                    <p class="text-[11px]
                        uppercase
                        tracking-wider
                        text-slate-500">

                        Escenarios activos

                    </p>

                    <p class="mt-2 text-3xl font-bold text-emerald-400">
                        @escenariosActivos
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Actualmente disponibles
                    </p>

                </div>

                <div class="w-10 h-10
                    rounded-xl
                    bg-emerald-500/10
                    border border-emerald-500/10
                    flex items-center justify-center">

                    <i data-lucide="check"
                       class="w-5 h-5 text-emerald-400">
                    </i>

                </div>

            </div>

        </div>


        <!-- INACTIVOS -->

        <div class="relative overflow-hidden
            rounded-2xl
            border border-slate-800
            bg-[#101928]
            p-5">

            <div class="flex items-start justify-between">

                <div>

                    <p class="text-[11px]
                        uppercase
                        tracking-wider
                        text-slate-500">

                        Escenarios inactivos

                    </p>

                    <p class="mt-2 text-3xl font-bold text-red-400">
                        @escenariosInactivos
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        No disponibles actualmente
                    </p>

                </div>

                <div class="w-10 h-10
                    rounded-xl
                    bg-red-500/10
                    border border-red-500/10
                    flex items-center justify-center">

                    <i data-lucide="x"
                       class="w-5 h-5 text-red-400">
                    </i>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TÍTULO DE LISTADO -->
    <!-- ===================================================== -->

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">

        <div>

            <h2 class="text-xl font-bold text-white">
                Todos los escenarios
            </h2>

            <p class="text-sm text-slate-500 mt-1">
                @totalEscenarios escenarios registrados en el sistema
            </p>

        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">

            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>

            Base de datos

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- GRID DE ESCENARIOS -->
    <!-- ===================================================== -->
    @if (escenarios.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">

            @foreach (var escenario in escenarios)
            {
                <div class="group
                    overflow-hidden
                    rounded-2xl
                    border border-slate-800
                    bg-[#101928]
                    shadow-xl shadow-black/10
                    transition-all duration-300
                    hover:-translate-y-1
                    hover:border-slate-700
                    hover:shadow-2xl">

                    <!-- ===================================== -->
                    <!-- IMAGEN -->
                    <!-- ===================================== -->

                    <div class="relative h-52
                        overflow-hidden
                        bg-gradient-to-br
                        from-slate-900
                        to-slate-950">

                        @if (!string.IsNullOrWhiteSpace(escenario.Imagen))
                        {
                            <img src="@escenario.Imagen"
                                 alt="@escenario.Nombre"
                                 class="h-full w-full
                            object-cover
                            transition duration-500
                            group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="h-full w-full
                                flex flex-col
                                items-center
                                justify-center
                                bg-gradient-to-br
                                from-slate-900
                                to-[#070c16]">

                                <div class="w-14 h-14
                                    rounded-2xl
                                    border border-slate-700
                                    bg-slate-800/50
                                    flex items-center justify-center">

                                    <i data-lucide="image"
                                       class="w-7 h-7 text-slate-600">
                                    </i>

                                </div>

                                <span class="mt-3 text-xs text-slate-600">
                                    Sin imagen
                                </span>

                            </div>
                        }


                        <!-- ESTADO -->

                        <div class="absolute top-4 left-4">

                            @if (escenario.Estado == true)
                            {
                                <span class="inline-flex items-center gap-1.5
                                    rounded-full
                                    border border-emerald-500/20
                                    bg-emerald-500/10
                                    px-2.5 py-1
                                    text-xs font-semibold
                                    text-emerald-400
                                    backdrop-blur">

                                    <span class="w-1.5 h-1.5
                                        rounded-full
                                        bg-emerald-400">
                                    </span>

                                    Activo

                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5
                                    rounded-full
                                    border border-red-500/20
                                    bg-red-500/10
                                    px-2.5 py-1
                                    text-xs font-semibold
                                    text-red-400
                                    backdrop-blur">

                                    <span class="w-1.5 h-1.5
                                        rounded-full
                                        bg-red-400">
                                    </span>

                                    Inactivo

                                </span>
                            }

                        </div>

                    </div>


                    <!-- ===================================== -->
                    <!-- INFORMACIÓN -->
                    <!-- ===================================== -->

                    <div class="p-5">

                        <!-- NOMBRE -->

                        <div class="mb-1">

                            <h3 class="text-lg
                                font-bold
                                text-white
                                truncate">

                                @escenario.Nombre

                            </h3>

                        </div>


                        <!-- DESCRIPCIÓN -->

                        <p class="min-h-[40px]
                            text-sm
                            leading-5
                            text-slate-500">

                            @(string.IsNullOrWhiteSpace(escenario.Descripcion)
                                ? "Sin descripción disponible"
                                : escenario.Descripcion)

                        </p>


                        <!-- DATOS -->

                        <div class="mt-5 space-y-3">

                            <!-- TIPO -->

                            <div class="flex items-center gap-3">

                                <div class="w-9 h-9
                                    rounded-xl
                                    bg-blue-500/10
                                    border border-blue-500/10
                                    flex items-center justify-center">

                                    <i data-lucide="layout-grid"
                                       class="w-4 h-4 text-blue-400">
                                    </i>

                                </div>

                                <div class="min-w-0">

                                    <p class="text-[10px]
                                        uppercase
                                        tracking-wider
                                        text-slate-600">

                                        Tipo de escenario

                                    </p>

                                    <p class="text-sm
                                        font-semibold
                                        text-slate-200
                                        truncate">

                                        @(escenario.IdTipoNavigation?.Nombre ?? "No especificado")

                                    </p>

                                </div>

                            </div>


                            <!-- EMPRESA -->

                            <div class="flex items-center gap-3">

                                <div class="w-9 h-9
                                    rounded-xl
                                    bg-purple-500/10
                                    border border-purple-500/10
                                    flex items-center justify-center">

                                    <i data-lucide="building-2"
                                       class="w-4 h-4 text-purple-400">
                                    </i>

                                </div>

                                <div class="min-w-0">

                                    <p class="text-[10px]
                                        uppercase
                                        tracking-wider
                                        text-slate-600">

                                        Empresa

                                    </p>

                                    <p class="text-sm
                                        font-semibold
                                        text-slate-200
                                        truncate">

                                        @(escenario.IdEmpresaNavigation?.Nombre ?? "No especificada")

                                    </p>

                                </div>

                            </div>


                            <!-- CAPACIDAD -->

                            <div class="flex items-center gap-3">

                                <div class="w-9 h-9
                                    rounded-xl
                                    bg-orange-500/10
                                    border border-orange-500/10
                                    flex items-center justify-center">

                                    <i data-lucide="users"
                                       class="w-4 h-4 text-orange-400">
                                    </i>

                                </div>

                                <div>

                                    <p class="text-[10px]
                                        uppercase
                                        tracking-wider
                                        text-slate-600">

                                        Capacidad

                                    </p>

                                    <p class="text-sm
                                        font-semibold
                                        text-slate-200">

                                        @(escenario.Capacidad?.ToString() ?? "0") personas

                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- PIE DE TARJETA -->
                        <!-- ================================= -->

                        <div class="mt-5
                            pt-4
                            border-t border-slate-800
                            flex items-center justify-between">

                            <span class="text-xs text-slate-600">
                                ID #@escenario.IdEscenario
                            </span>

                            <div class="flex items-center gap-2">

                                <!-- EDITAR -->

                                <a asp-controller="Escenarios"
                                   asp-action="Edit"
                                   asp-route-id="@escenario.IdEscenario"
                                   class="inline-flex items-center gap-1.5
                                    rounded-lg
                                    border border-slate-700
                                    bg-slate-900/60
                                    px-3 py-1.5
                                    text-xs
                                    font-semibold
                                    text-slate-300
                                    transition
                                    hover:border-emerald-500/40
                                    hover:text-emerald-400">

                                    <i data-lucide="pencil"
                                       class="w-3.5 h-3.5">
                                    </i>

                                    Editar

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- ================================================= -->
        <!-- SIN ESCENARIOS -->
        <!-- ================================================= -->

        <div class="rounded-2xl
            border border-dashed border-slate-700
            bg-[#101928]
            p-12
            text-center">

            <div class="mx-auto w-16 h-16
                rounded-2xl
                bg-slate-800/70
                flex items-center justify-center">

                <i data-lucide="landmark"
                   class="w-8 h-8 text-slate-600">
                </i>

            </div>

            <h3 class="mt-5 text-lg font-bold text-white">
                No hay escenarios registrados
            </h3>

            <p class="mt-2 text-sm text-slate-500">
                Comienza creando tu primer escenario deportivo.
            </p>

            <a asp-controller="Escenarios"
               asp-action="Create"
               class="mt-6 inline-flex items-center gap-2
                rounded-xl
                bg-emerald-500
                px-5 py-2.5
                text-sm font-bold
                text-slate-950
                transition
                hover:bg-emerald-400">

                <i data-lucide="plus"
                   class="w-4 h-4">
                </i>

                Crear primer escenario

            </a>

        </div>
    }

</div>


@section Scripts {

    <script>
        lucide.createIcons();
    </script>

}