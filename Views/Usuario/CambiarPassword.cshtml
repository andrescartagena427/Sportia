@{
    ViewData["Title"] = "Cambiar contraseña";
    Layout = "_ClienteLayout";
}

<div class="min-h-screen bg-slate-950 text-white">

    <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <a asp-controller="Usuario"
           asp-action="Perfil"
           class="inline-flex items-center gap-2
            text-sm text-slate-400
            hover:text-emerald-400 transition mb-6">

            ← Volver a mi perfil

        </a>


        <div class="mb-8">

            <p class="text-emerald-400 text-xs font-bold
                uppercase tracking-[0.2em]">

                Seguridad

            </p>

            <h1 class="text-3xl font-black mt-2">

                Cambiar contraseña

            </h1>

            <p class="text-slate-500 mt-2">

                Mantén segura tu cuenta actualizando tu contraseña.

            </p>

        </div>


        <div class="rounded-3xl
            border border-white/10
            bg-white/[0.03]
            p-6 sm:p-8">


            @if (ViewBag.Error != null)
            {
                <div class="mb-6 rounded-xl
                    border border-red-500/20
                    bg-red-500/10
                    p-4
                    text-sm
                    text-red-400">

                    @ViewBag.Error

                </div>
            }


            <form asp-controller="Usuario"
                  asp-action="CambiarPassword"
                  method="post"
                  class="space-y-5">

                @Html.AntiForgeryToken()


                <!-- CONTRASEÑA ACTUAL -->

                <div>

                    <label class="block text-sm
                        font-semibold
                        text-slate-300
                        mb-2">

                        Contraseña actual

                    </label>

                    <input type="password"
                           name="contrasenaActual"
                           required
                           class="w-full
                    rounded-xl
                    border border-white/10
                    bg-slate-900
                    px-4 py-3
                    text-white
                    outline-none
                    focus:border-emerald-500
                    focus:ring-2
                    focus:ring-emerald-500/20" />

                </div>


                <!-- NUEVA CONTRASEÑA -->

                <div>

                    <label class="block text-sm
                        font-semibold
                        text-slate-300
                        mb-2">

                        Nueva contraseña

                    </label>

                    <input type="password"
                           name="nuevaContrasena"
                           required
                           minlength="6"
                           class="w-full
                    rounded-xl
                    border border-white/10
                    bg-slate-900
                    px-4 py-3
                    text-white
                    outline-none
                    focus:border-emerald-500
                    focus:ring-2
                    focus:ring-emerald-500/20" />

                    <p class="text-xs text-slate-600 mt-2">

                        La contraseña debe tener al menos 6 caracteres.

                    </p>

                </div>


                <!-- CONFIRMAR -->

                <div>

                    <label class="block text-sm
                        font-semibold
                        text-slate-300
                        mb-2">

                        Confirmar nueva contraseña

                    </label>

                    <input type="password"
                           name="confirmarContrasena"
                           required
                           minlength="6"
                           class="w-full
                    rounded-xl
                    border border-white/10
                    bg-slate-900
                    px-4 py-3
                    text-white
                    outline-none
                    focus:border-emerald-500
                    focus:ring-2
                    focus:ring-emerald-500/20" />

                </div>


                <!-- BOTONES -->

                <div class="pt-4
                    flex flex-col sm:flex-row
                    gap-3">

                    <button type="submit"
                            class="flex-1
                        rounded-xl
                        bg-emerald-500
                        hover:bg-emerald-400
                        px-5 py-3
                        font-bold
                        transition">

                        Cambiar contraseña

                    </button>


                    <a asp-controller="Usuario"
                       asp-action="Perfil"
                       class="flex-1
                        text-center
                        rounded-xl
                        bg-white/5
                        border border-white/10
                        hover:bg-white/10
                        px-5 py-3
                        font-semibold
                        transition">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </main>

</div>