@model Sportia.Models.Empresa

@{
    ViewData["Title"] = "Editar empresa";
    Layout = "_DashboardLayout";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-center gap-4">

        <a asp-action="Index"
           class="w-10 h-10 rounded-xl
            border border-slate-800
            bg-slate-900
            hover:bg-slate-800
            flex items-center justify-center
            text-slate-400 hover:text-white">

            <i data-lucide="arrow-left" class="w-5 h-5"></i>

        </a>

        <div>

            <h1 class="text-2xl font-bold text-white">
                Editar empresa
            </h1>

            <p class="text-sm text-slate-400">
                Actualiza la información de @Model.Nombre
            </p>

        </div>

    </div>


    <div class="rounded-2xl
        border border-slate-800
        bg-slate-900/60
        overflow-hidden">

        <div class="border-b border-slate-800 px-6 py-5">

            <h2 class="text-base font-semibold text-white">
                Información de la empresa
            </h2>

        </div>


        <form asp-action="Edit"
              method="post"
              class="p-6 space-y-6">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="IdEmpresa" />

            <input type="hidden"
                   asp-for="Logo" />

            <div asp-validation-summary="ModelOnly"
                 class="rounded-xl
                border border-red-500/20
                bg-red-500/10
                px-4 py-3
                text-sm text-red-300">
            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div>

                    <label asp-for="Nombre"
                           class="block mb-2 text-sm font-medium text-slate-300">
                        Nombre
                    </label>

                    <input asp-for="Nombre"
                           class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none" />

                    <span asp-validation-for="Nombre"
                          class="mt-1 block text-xs text-red-400"></span>

                </div>


                <div>

                    <label asp-for="Nit"
                           class="block mb-2 text-sm font-medium text-slate-300">
                        NIT
                    </label>

                    <input asp-for="Nit"
                           class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none" />

                </div>

            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <div>

                    <label asp-for="Telefono"
                           class="block mb-2 text-sm font-medium text-slate-300">
                        Teléfono
                    </label>

                    <input asp-for="Telefono"
                           class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none" />

                </div>


                <div>

                    <label asp-for="Correo"
                           class="block mb-2 text-sm font-medium text-slate-300">
                        Correo
                    </label>

                    <input asp-for="Correo"
                           type="email"
                           class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none" />

                </div>

            </div>


            <div>

                <label asp-for="Direccion"
                       class="block mb-2 text-sm font-medium text-slate-300">
                    Dirección
                </label>

                <input asp-for="Direccion"
                       class="w-full rounded-xl
                border border-slate-800
                bg-slate-950
                px-4 py-3
                text-sm text-white
                focus:border-emerald-500
                focus:outline-none" />

            </div>


            <div>

                <label asp-for="IdUsuario"
                       class="block mb-2 text-sm font-medium text-slate-300">
                    Usuario responsable
                </label>

                <select asp-for="IdUsuario"
                        class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none">

                    @foreach (var usuario in ViewBag.Usuarios)
                    {
                        <option value="@usuario.IdUsuario">
                            @usuario.Nombres @usuario.Apellidos
                            - @usuario.Correo
                        </option>
                    }

                </select>

            </div>


            <div>

                <label asp-for="Descripcion"
                       class="block mb-2 text-sm font-medium text-slate-300">
                    Descripción
                </label>

                <textarea asp-for="Descripcion"
                          rows="4"
                          class="w-full rounded-xl
                border border-slate-800
                bg-slate-950
                px-4 py-3
                text-sm text-white
                resize-none
                focus:border-emerald-500
                focus:outline-none"></textarea>

            </div>


            <div>

                <label asp-for="Logo"
                       class="block mb-2 text-sm font-medium text-slate-300">
                    Logo
                </label>

                <input asp-for="Logo"
                       class="w-full rounded-xl
                border border-slate-800
                bg-slate-950
                px-4 py-3
                text-sm text-white
                focus:border-emerald-500
                focus:outline-none" />

            </div>


            <div>

                <label asp-for="Estado"
                       class="block mb-2 text-sm font-medium text-slate-300">
                    Estado
                </label>

                <select asp-for="Estado"
                        class="w-full rounded-xl
                    border border-slate-800
                    bg-slate-950
                    px-4 py-3
                    text-sm text-white
                    focus:border-emerald-500
                    focus:outline-none">

                    <option value="true">
                        Activa
                    </option>

                    <option value="false">
                        Inactiva
                    </option>

                </select>

            </div>


            <div class="flex justify-end gap-3
                border-t border-slate-800
                pt-6">

                <a asp-action="Index"
                   class="rounded-xl
                    border border-slate-700
                    bg-slate-800
                    hover:bg-slate-700
                    px-5 py-2.5
                    text-sm font-semibold
                    text-slate-300">

                    Cancelar

                </a>

                <button type="submit"
                        class="inline-flex items-center gap-2
                    rounded-xl
                    bg-emerald-500
                    hover:bg-emerald-400
                    px-5 py-2.5
                    text-sm font-semibold
                    text-slate-950">

                    <i data-lucide="save" class="w-4 h-4"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        lucide.createIcons();
    </script>
}