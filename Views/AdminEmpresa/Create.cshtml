@model Sportia.Models.Empresa

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Nueva empresa";
}

<div class="min-h-screen bg-[#07101d] text-white px-6 py-6">

    <div class="max-w-5xl mx-auto">

        <!-- ENCABEZADO -->
        <div class="flex items-center gap-4 mb-6">

            <a asp-controller="AdminEmpresa"
               asp-action="Index"
               class="w-11 h-11 rounded-xl
                border border-slate-800
                bg-[#0b1626]
                hover:bg-slate-800
                flex items-center justify-center
                text-slate-400
                hover:text-white
                transition">

                <i data-lucide="arrow-left" class="w-5 h-5"></i>

            </a>

            <div>
                <h1 class="text-2xl font-bold text-white">
                    Nueva empresa
                </h1>

                <p class="text-sm text-slate-400 mt-1">
                    Registra una nueva empresa para Sportia
                </p>
            </div>

        </div>


        <!-- FORMULARIO -->
        <form asp-controller="AdminEmpresa"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div class="rounded-2xl
                border border-slate-800
                bg-[#0b1626]
                overflow-hidden">

                <!-- TITULO DEL FORMULARIO -->
                <div class="px-6 py-5 border-b border-slate-800">

                    <h2 class="text-base font-semibold text-white">
                        Información de la empresa
                    </h2>

                    <p class="text-xs text-slate-500 mt-1">
                        Complete los datos necesarios para registrar la empresa
                    </p>

                </div>


                <!-- CONTENIDO -->
                <div class="p-6">

                    <!-- ERRORES -->
                    <div asp-validation-summary="ModelOnly"
                         class="mb-6
                        rounded-xl
                        border border-red-500/20
                        bg-red-500/10
                        px-4 py-3
                        text-sm text-red-400">
                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                        <!-- NOMBRE -->
                        <div class="md:col-span-2">

                            <label asp-for="Nombre"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Nombre de la empresa
                            </label>

                            <input asp-for="Nombre"
                                   placeholder="Ej. Sportia Deportes"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <span asp-validation-for="Nombre"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- NIT -->
                        <div>

                            <label asp-for="Nit"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                NIT
                            </label>

                            <input asp-for="Nit"
                                   placeholder="Ej. 900123456-1"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <span asp-validation-for="Nit"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- TELEFONO -->
                        <div>

                            <label asp-for="Telefono"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Teléfono
                            </label>

                            <input asp-for="Telefono"
                                   placeholder="Ej. 3001234567"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <span asp-validation-for="Telefono"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- CORREO -->
                        <div>

                            <label asp-for="Correo"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Correo electrónico
                            </label>

                            <input asp-for="Correo"
                                   type="email"
                                   placeholder="contacto@empresa.com"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <span asp-validation-for="Correo"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- RESPONSABLE -->
                        <div>

                            <label asp-for="IdUsuario"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Responsable
                            </label>

                            <select asp-for="IdUsuario"
                                    asp-items="ViewBag.Usuarios"
                                    class="w-full rounded-xl
                                border border-slate-800
                                bg-[#050b14]
                                px-4 py-3
                                text-sm text-white
                                outline-none
                                focus:border-emerald-500/50
                                focus:ring-2
                                focus:ring-emerald-500/10
                                transition">

                                <option value="">
                                    Seleccione un responsable
                                </option>

                            </select>

                            <span asp-validation-for="IdUsuario"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- DIRECCION -->
                        <div class="md:col-span-2">

                            <label asp-for="Direccion"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Dirección
                            </label>

                            <input asp-for="Direccion"
                                   placeholder="Ej. Calle 10 # 20-30"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <span asp-validation-for="Direccion"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- DESCRIPCION -->
                        <div class="md:col-span-2">

                            <label asp-for="Descripcion"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Descripción
                            </label>

                            <textarea asp-for="Descripcion"
                                      rows="4"
                                      placeholder="Escriba una descripción de la empresa..."
                                      class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            resize-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition"></textarea>

                            <span asp-validation-for="Descripcion"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- LOGO -->
                        <div class="md:col-span-2">

                            <label asp-for="Logo"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Logo
                            </label>

                            <input asp-for="Logo"
                                   placeholder="/uploads/empresas/logo.png"
                                   class="w-full rounded-xl
                            border border-slate-800
                            bg-[#050b14]
                            px-4 py-3
                            text-sm text-white
                            placeholder:text-slate-600
                            outline-none
                            focus:border-emerald-500/50
                            focus:ring-2
                            focus:ring-emerald-500/10
                            transition" />

                            <p class="mt-2 text-xs text-slate-600">
                                Puede dejar este campo vacío.
                            </p>

                            <span asp-validation-for="Logo"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>


                        <!-- ESTADO -->
                        <div class="md:col-span-2">

                            <label asp-for="Estado"
                                   class="block mb-2 text-sm font-medium text-slate-300">
                                Estado
                            </label>

                            <select asp-for="Estado"
                                    class="w-full rounded-xl
                                border border-slate-800
                                bg-[#050b14]
                                px-4 py-3
                                text-sm text-white
                                outline-none
                                focus:border-emerald-500/50
                                focus:ring-2
                                focus:ring-emerald-500/10
                                transition">

                                <option value="true">
                                    Activa
                                </option>

                                <option value="false">
                                    Inactiva
                                </option>

                            </select>

                            <span asp-validation-for="Estado"
                                  class="block mt-1 text-xs text-red-400">
                            </span>

                        </div>

                    </div>


                    <!-- BOTONES -->
                    <div class="flex items-center justify-end gap-3
                        mt-7 pt-5
                        border-t border-slate-800">

                        <a asp-controller="AdminEmpresa"
                           asp-action="Index"
                           class="inline-flex items-center justify-center
                            rounded-xl
                            border border-slate-700
                            bg-slate-800
                            hover:bg-slate-700
                            px-5 py-2.5
                            text-sm font-medium
                            text-slate-300
                            hover:text-white
                            transition">

                            Cancelar

                        </a>


                        <button type="submit"
                                class="inline-flex items-center justify-center gap-2
                            rounded-xl
                            bg-emerald-500
                            hover:bg-emerald-400
                            px-5 py-2.5
                            text-sm font-semibold
                            text-slate-950
                            transition
                            shadow-lg shadow-emerald-500/10">

                            <i data-lucide="save" class="w-4 h-4"></i>

                            Guardar empresa

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }
    </script>

}