@model IEnumerable<Sportia.Models.Empresa>

@{
    Layout = "_DashboardLayout";

    ViewData["Title"] = "Empresas";

    var empresas = Model?.ToList() ?? new List<Sportia.Models.Empresa>();

    var totalEmpresas = empresas.Count;
    var empresasActivas = empresas.Count(e => e.Estado == true);
    var empresasInactivas = empresas.Count(e => e.Estado != true);
    var totalEscenarios = empresas.Sum(e => e.Escenarios?.Count ?? 0);
}

<div class="min-h-screen bg-[#07101d] text-white px-6 py-6">

    <!-- ENCABEZADO -->
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-7">

        <div class="flex items-center gap-4">

            <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
                <i data-lucide="building-2"
                   class="w-5 h-5 text-emerald-400">
                </i>
            </div>

            <div>
                <h1 class="text-2xl font-bold text-white">
                    Empresas
                </h1>

                <p class="text-sm text-slate-400 mt-0.5">
                    Administra las empresas registradas en Sportia
                </p>
            </div>

        </div>

        <a asp-controller="AdminEmpresa"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2
            px-4 py-2.5
            rounded-xl
            bg-emerald-500
            hover:bg-emerald-400
            text-slate-950
            text-sm font-semibold
            transition-all duration-200
            shadow-lg shadow-emerald-500/10">

            <i data-lucide="plus" class="w-4 h-4"></i>

            Nueva empresa

        </a>

    </div>


    <!-- MENSAJES -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-5 flex items-center gap-3
            rounded-xl
            border border-emerald-500/20
            bg-emerald-500/10
            px-4 py-3
            text-sm text-emerald-300">

            <i data-lucide="circle-check" class="w-5 h-5"></i>

            <span>@TempData["Success"]</span>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-5 flex items-center gap-3
            rounded-xl
            border border-red-500/20
            bg-red-500/10
            px-4 py-3
            text-sm text-red-300">

            <i data-lucide="circle-alert" class="w-5 h-5"></i>

            <span>@TempData["Error"]</span>

        </div>
    }


    <!-- ESTADÍSTICAS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

        <!-- TOTAL -->
        <div class="rounded-2xl
            border border-slate-800
            bg-[#0b1626]
            p-5
            hover:border-slate-700
            transition">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-[11px] uppercase tracking-wider text-slate-500">
                        Total empresas
                    </p>

                    <p class="mt-2 text-3xl font-bold text-white">
                        @totalEmpresas
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Registradas en Sportia
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-blue-500/10
                    flex items-center justify-center">

                    <i data-lucide="building-2"
                       class="w-5 h-5 text-blue-400">
                    </i>

                </div>

            </div>

        </div>


        <!-- ACTIVAS -->
        <div class="rounded-2xl
            border border-slate-800
            bg-[#0b1626]
            p-5
            hover:border-slate-700
            transition">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-[11px] uppercase tracking-wider text-slate-500">
                        Empresas activas
                    </p>

                    <p class="mt-2 text-3xl font-bold text-emerald-400">
                        @empresasActivas
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Actualmente activas
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-emerald-500/10
                    flex items-center justify-center">

                    <i data-lucide="circle-check"
                       class="w-5 h-5 text-emerald-400">
                    </i>

                </div>

            </div>

        </div>


        <!-- INACTIVAS -->
        <div class="rounded-2xl
            border border-slate-800
            bg-[#0b1626]
            p-5
            hover:border-slate-700
            transition">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-[11px] uppercase tracking-wider text-slate-500">
                        Empresas inactivas
                    </p>

                    <p class="mt-2 text-3xl font-bold text-red-400">
                        @empresasInactivas
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Deshabilitadas
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-red-500/10
                    flex items-center justify-center">

                    <i data-lucide="circle-x"
                       class="w-5 h-5 text-red-400">
                    </i>

                </div>

            </div>

        </div>


        <!-- ESCENARIOS -->
        <div class="rounded-2xl
            border border-slate-800
            bg-[#0b1626]
            p-5
            hover:border-slate-700
            transition">

            <div class="flex items-center justify-between">

                <div>
                    <p class="text-[11px] uppercase tracking-wider text-slate-500">
                        Escenarios
                    </p>

                    <p class="mt-2 text-3xl font-bold text-purple-400">
                        @totalEscenarios
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        De todas las empresas
                    </p>
                </div>

                <div class="w-11 h-11 rounded-xl
                    bg-purple-500/10
                    flex items-center justify-center">

                    <i data-lucide="map"
                       class="w-5 h-5 text-purple-400">
                    </i>

                </div>

            </div>

        </div>

    </div>


    <!-- BUSCADOR -->
    <div class="rounded-2xl
        border border-slate-800
        bg-[#0b1626]
        p-4 mb-6">

        <form asp-controller="AdminEmpresa"
              asp-action="Index"
              method="get"
              class="flex flex-col sm:flex-row gap-3">

            <div class="relative flex-1">

                <i data-lucide="search"
                   class="absolute left-4 top-1/2 -translate-y-1/2
                    w-4 h-4 text-slate-500">
                </i>

                <input type="text"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       placeholder="Buscar por nombre, NIT, teléfono, correo o dirección..."
                       class="w-full
                rounded-xl
                border border-slate-800
                bg-[#050b14]
                pl-11 pr-4 py-3
                text-sm text-white
                placeholder:text-slate-600
                outline-none
                focus:border-emerald-500/50
                focus:ring-2
                focus:ring-emerald-500/10
                transition" />

            </div>

            <button type="submit"
                    class="inline-flex items-center justify-center gap-2
                rounded-xl
                border border-slate-700
                bg-slate-800
                hover:bg-slate-700
                px-5 py-3
                text-sm font-medium text-white
                transition">

                <i data-lucide="search" class="w-4 h-4"></i>

                Buscar

            </button>

        </form>

    </div>


    <!-- TABLA -->
    <div class="rounded-2xl
        border border-slate-800
        bg-[#0b1626]
        overflow-hidden">

        <!-- CABECERA -->
        <div class="px-5 py-4 border-b border-slate-800">

            <div class="flex items-center justify-between">

                <div>
                    <h2 class="text-base font-semibold text-white">
                        Empresas registradas
                    </h2>

                    <p class="text-xs text-slate-500 mt-1">
                        Consulta y administra las empresas de Sportia
                    </p>
                </div>

                <span class="hidden sm:inline-flex
                    items-center
                    rounded-lg
                    border border-slate-800
                    bg-slate-900/60
                    px-3 py-1.5
                    text-xs text-slate-400">

                    @totalEmpresas empresas

                </span>

            </div>

        </div>


        @if (empresas.Any())
        {
            <!-- CONTENEDOR RESPONSIVE -->
            <div class="overflow-x-auto">

                <table class="w-full min-w-[1050px]">

                    <thead class="bg-[#091424]">

                        <tr class="border-b border-slate-800">

                            <th class="px-5 py-3.5 text-left
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Empresa
                            </th>

                            <th class="px-5 py-3.5 text-left
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                NIT
                            </th>

                            <th class="px-5 py-3.5 text-left
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Contacto
                            </th>

                            <th class="px-5 py-3.5 text-left
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Responsable
                            </th>

                            <th class="px-5 py-3.5 text-center
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Escenarios
                            </th>

                            <th class="px-5 py-3.5 text-center
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Estado
                            </th>

                            <th class="px-5 py-3.5 text-right
                                text-[10px] font-semibold
                                uppercase tracking-wider
                                text-slate-500">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-slate-800/80">

                        @foreach (var empresa in empresas)
                        {
                            <tr class="hover:bg-slate-900/50 transition">

                                <!-- EMPRESA -->
                                <td class="px-5 py-4">

                                    <div class="flex items-center gap-3">

                                        <div class="w-10 h-10 rounded-xl
                                            bg-emerald-500/10
                                            border border-emerald-500/10
                                            flex items-center justify-center
                                            shrink-0">

                                            @if (!string.IsNullOrWhiteSpace(empresa.Logo))
                                            {
                                                <img src="@empresa.Logo"
                                                     alt="@empresa.Nombre"
                                                     class="w-10 h-10 rounded-xl object-cover" />
                                            }
                                            else
                                            {
                                                <span class="text-sm font-bold text-emerald-400">
                                                    @(empresa.Nombre?.Substring(0, 1).ToUpper())
                                                </span>
                                            }

                                        </div>

                                        <div>

                                            <p class="text-sm font-semibold text-white">
                                                @empresa.Nombre
                                            </p>

                                            <p class="text-xs text-slate-500 mt-0.5">
                                                ID #@empresa.IdEmpresa
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- NIT -->
                                <td class="px-5 py-4">

                                    <span class="text-sm text-slate-300">
                                        @(string.IsNullOrWhiteSpace(empresa.Nit)
                                            ? "Sin NIT"
                                            : empresa.Nit)
                                    </span>

                                </td>


                                <!-- CONTACTO -->
                                <td class="px-5 py-4">

                                    <div class="space-y-1">

                                        @if (!string.IsNullOrWhiteSpace(empresa.Telefono))
                                        {
                                            <div class="flex items-center gap-2">

                                                <i data-lucide="phone"
                                                   class="w-3.5 h-3.5 text-slate-500">
                                                </i>

                                                <span class="text-xs text-slate-300">
                                                    @empresa.Telefono
                                                </span>

                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(empresa.Correo))
                                        {
                                            <div class="flex items-center gap-2">

                                                <i data-lucide="mail"
                                                   class="w-3.5 h-3.5 text-slate-500">
                                                </i>

                                                <span class="text-xs text-slate-400">
                                                    @empresa.Correo
                                                </span>

                                            </div>
                                        }

                                    </div>

                                </td>


                                <!-- RESPONSABLE -->
                                <td class="px-5 py-4">

                                    @if (empresa.IdUsuarioNavigation != null)
                                    {
                                        <div>

                                            <p class="text-sm text-slate-300">
                                                @empresa.IdUsuarioNavigation.Nombres
                                                @empresa.IdUsuarioNavigation.Apellidos
                                            </p>

                                            <p class="text-xs text-slate-500 mt-0.5">
                                                Administrador
                                            </p>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-500">
                                            Sin responsable
                                        </span>
                                    }

                                </td>


                                <!-- ESCENARIOS -->
                                <td class="px-5 py-4 text-center">

                                    <span class="inline-flex items-center justify-center
                                        min-w-9
                                        rounded-lg
                                        border border-blue-500/20
                                        bg-blue-500/10
                                        px-2.5 py-1
                                        text-xs font-semibold
                                        text-blue-400">

                                        @(empresa.Escenarios?.Count ?? 0)

                                    </span>

                                </td>


                                <!-- ESTADO -->
                                <td class="px-5 py-4 text-center">

                                    @if (empresa.Estado == true)
                                    {
                                        <span class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-emerald-500/20
                                            bg-emerald-500/10
                                            px-3 py-1.5
                                            text-xs font-medium
                                            text-emerald-400">

                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>

                                            Activa

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-red-500/20
                                            bg-red-500/10
                                            px-3 py-1.5
                                            text-xs font-medium
                                            text-red-400">

                                            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>

                                            Inactiva

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="px-5 py-4">

                                    <div class="flex items-center justify-end gap-2">

                                        <!-- VER -->
                                        <a asp-controller="AdminEmpresa"
                                           asp-action="Details"
                                           asp-route-id="@empresa.IdEmpresa"
                                           class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-slate-700
                                            bg-slate-900
                                            px-3 py-2
                                            text-xs font-medium
                                            text-slate-300
                                            hover:bg-slate-800
                                            hover:text-white
                                            transition">

                                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>

                                            Ver

                                        </a>


                                        <!-- EDITAR -->
                                        <a asp-controller="AdminEmpresa"
                                           asp-action="Edit"
                                           asp-route-id="@empresa.IdEmpresa"
                                           class="inline-flex items-center gap-2
                                            rounded-lg
                                            border border-blue-500/20
                                            bg-blue-500/10
                                            px-3 py-2
                                            text-xs font-medium
                                            text-blue-400
                                            hover:bg-blue-500/20
                                            transition">

                                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i>

                                            Editar

                                        </a>


                                        <!-- ELIMINAR -->
                                        <form asp-controller="AdminEmpresa"
                                              asp-action="Delete"
                                              asp-route-id="@empresa.IdEmpresa"
                                              method="post"
                                              class="inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    onclick="return confirm('¿Está seguro de eliminar esta empresa?');"
                                                    class="inline-flex items-center gap-2
                                                rounded-lg
                                                border border-red-500/20
                                                bg-red-500/10
                                                px-3 py-2
                                                text-xs font-medium
                                                text-red-400
                                                hover:bg-red-500/20
                                                transition">

                                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>

                                                Eliminar

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- ESTADO VACÍO -->
            <div class="py-16 px-6 text-center">

                <div class="mx-auto w-14 h-14 rounded-2xl
                    bg-slate-800
                    flex items-center justify-center">

                    <i data-lucide="building-2"
                       class="w-7 h-7 text-slate-500">
                    </i>

                </div>

                <h3 class="mt-4 text-base font-semibold text-white">
                    No hay empresas registradas
                </h3>

                <p class="mt-1 text-sm text-slate-500">
                    Comienza registrando la primera empresa de Sportia.
                </p>

                <a asp-controller="AdminEmpresa"
                   asp-action="Create"
                   class="inline-flex items-center gap-2
                    mt-5
                    rounded-xl
                    bg-emerald-500
                    hover:bg-emerald-400
                    px-4 py-2.5
                    text-sm font-semibold
                    text-slate-950
                    transition">

                    <i data-lucide="plus" class="w-4 h-4"></i>

                    Nueva empresa

                </a>

            </div>
        }

    </div>

</div>

@section Scripts {

    <script>
        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }
    </script>

}